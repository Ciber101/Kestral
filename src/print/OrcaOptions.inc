    {"support_interface_loop_pattern", "coBool", "Interface use loop pattern", "", "", "Cover the top contact layer of the support with loops.", "Support", "advanced", "", "", "", ""},
    {"support_interface_not_for_body", "coBool", "Avoid interface filament for base", "", "", "Where possible, don't use the interface filament for the support base (it is often an expensive or soluble one).", "Support", "simple", "", "", "", ""},
    {"support_interface_pattern", "coEnum", "Interface pattern", "", "", "Pattern of the support interface. Default is rectilinear for normal interfaces and concentric for soluble ones.", "Support", "advanced", "auto\nrectilinear\nconcentric\nrectilinear_interlaced\ngrid", "Default\nRectilinear\nConcentric\nRectilinear Interlaced\nGrid", "", ""},
    {"support_interface_spacing", "coFloat", "Top interface spacing", "", "mm", "Distance between top interface lines. 0 makes the interface solid, which is also used when support ironing is on.", "Support", "advanced", "", "", "0", ""},
