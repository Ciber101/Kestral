    {"extruder_printable_height", "coFloats", "Extruder printable height", "", "mm", "Highest this extruder can print, limited by the printer's mechanics.", "", "advanced", "", "", "0", "1000"},
    {"extruder_type", "coEnums", "Type", "", "", "Direct drive or Bowden. Only used as the starting value for pressure advance calibration (Bowden needs more). It does not change normal slicing.", "", "advanced", "Direct Drive\nBowden", "Direct Drive\nBowden", "", ""},
    {"extruder_variant_list", "coStrings", "Extruder variant list", "", "", "The extruder variants this printer has.", "", "simple", "", "", "", ""},
    {"extrusion_rate_smoothing_external_perimeter_only", "coBool", "Apply only on external features", "", "", "Smooth the flow changes only on outer walls and overhangs, where sudden speed changes show, and leave hidden features at full speed.", "", "advanced", "", "", "", ""},
    {"fan_cooling_layer_time", "coFloats", "Layer time", "", "s", "Layers that take less time than this turn on the part cooling fan. The fan speed goes from the minimum toward the maximum as the layer time gets shorter.", "", "simple", "", "", "0", "1000"},
    {"fan_kickstart", "coFloat", "Fan kick-start time", "", "s", "Run the fan at full speed for this many seconds before dropping to the requested speed, so fans that stall at low power get spinning.", "", "advanced", "", "", "0", ""},
    {"fan_max_speed", "coFloats", "Fan speed", "", "%", "Highest part cooling fan speed when cooling speeds up for short layers.", "", "simple", "", "", "0", "100"},
    {"fan_min_speed", "coFloats", "Fan speed", "", "%", "Lowest part cooling fan speed.", "", "simple", "", "", "0", "100"},
    {"fan_speedup_overhangs", "coBool", "Only overhangs", "", "", "Start the fan early only for overhangs.", "", "advanced", "", "", "", ""},
    {"fan_speedup_time", "coFloat", "Fan speed-up time", "", "s", "Turn the fan on this many seconds before it is needed, so it is already spinning (fractions of a second work). The timing is estimated from the G0 and G1 moves only and ignores acceleration, and does not work with arc moves. The first layers with no cooling are not affected.", "", "advanced", "", "", "", ""},
    {"filament_adaptive_volumetric_speed", "coBools", "Adaptive volumetric speed", "", "", "Limit the flow to the lower of two values: the fitted flow for each line width and layer height, and your max volumetric speed. Off uses only your max volumetric speed. Experimental.", "", "develop", "", "", "", ""},
    {"filament_adhesiveness_category", "coInts", "Adhesiveness Category", "", "", "Group this filament belongs to, used to check which filaments stick to each other.", "", "develop", "", "", "0", ""},
    {"filament_change_extrusion_role_gcode", "coStrings", "Change extrusion role G-code (filament)", "", "", "G-code added for this filament whenever the kind of line being printed changes.", "", "advanced", "", "", "", ""},
    {"filament_change_length", "coFloats", "Filament ramming length", "", "mm", "Length of filament pushed out of the old extruder before switching extruders, which reduces oozing.", "", "advanced", "", "", "0", ""},
    {"filament_colour", "coStrings", "Color", "", "", "Color of this filament in the interface only.", "", "advanced", "", "", "", ""},
    {"filament_colour_type", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_cooling_before_tower", "coFloats", "Wipe tower cooling", "", "°C", "How far the nozzle temperature drops before it moves to the prime tower.", "", "develop", "", "", "", ""},
    {"filament_cooling_final_speed", "coFloats", "Speed of the last cooling move", "", "mm/s", "Speed the cooling moves build up to.", "", "advanced", "", "", "0", ""},
    {"filament_cooling_initial_speed", "coFloats", "Speed of the first cooling move", "", "mm/s", "Speed of the first cooling move. The following ones get faster.", "", "advanced", "", "", "0", ""},
    {"filament_cooling_moves", "coInts", "Number of cooling moves", "", "", "Number of back and forth moves in the cooling tube that cool the filament tip before it is unloaded.", "", "advanced", "", "", "0", "20"},
    {"filament_cost", "coFloats", "Price", "", "money/kg", "Price per kilogram, for the cost estimate only.", "", "advanced", "", "", "0", ""},
    {"filament_density", "coFloats", "Density", "", "g/cm³", "Density of the filament, for the weight estimate only.", "", "advanced", "", "", "0", ""},
    {"filament_diameter", "coFloats", "Diameter", "", "mm", "Diameter of the filament. Every extrusion amount in the G-code is calculated from it, so it must be accurate.", "", "simple", "", "", "0", ""},
    {"filament_end_gcode", "coStrings", "End G-code", "", "", "G-code added when this filament finishes printing.", "", "advanced", "", "", "", ""},
