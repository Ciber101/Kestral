    {"filament_flow_ratio", "coFloats", "Flow ratio", "", "", "Scales all extrusion of this filament. Plastics change volume as they melt and cool, so the right amount differs a little per filament. Usually between 0.95 and 1.05. Calibrate it with the flow rate test.", "", "advanced", "", "", "0", "2"},
    {"filament_flush_temp", "coInts", "Flush temperature", "", "°C", "Nozzle temperature while flushing this filament. 0 uses the top of its recommended range.", "", "advanced", "", "", "0", ""},
    {"filament_flush_volumetric_speed", "coFloats", "Flush volumetric speed", "", "mm³/s", "Flow while flushing this filament. 0 uses its max volumetric speed.", "", "advanced", "", "", "0", "200"},
    {"filament_ids", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_ironing_flow", "coPercents", "Ironing flow", "", "%", "Ironing flow for this filament, instead of the process setting. Too much gives an over extruded surface.", "Quality", "advanced", "", "", "0", "100"},
    {"filament_ironing_inset", "coFloats", "Ironing inset", "", "mm", "How far ironing stays from the edges for this filament, instead of the process setting.", "Quality", "advanced", "", "", "0", "100"},
    {"filament_ironing_spacing", "coFloats", "Ironing line spacing", "", "mm", "Ironing line spacing for this filament, instead of the process setting.", "Quality", "advanced", "", "", "0", "1"},
    {"filament_ironing_speed", "coFloats", "Ironing speed", "", "mm/s", "Ironing speed for this filament, instead of the process setting.", "Speed", "advanced", "", "", "1", ""},
    {"filament_is_support", "coBools", "Support material", "", "", "This filament is meant for supports and support interfaces.", "", "advanced", "", "", "", ""},
    {"filament_loading_speed", "coFloats", "Loading speed", "", "mm/s", "Speed of loading the filament at the prime tower.", "", "advanced", "", "", "0", ""},
    {"filament_loading_speed_start", "coFloats", "Loading speed at the start", "", "mm/s", "Speed at the very start of loading.", "", "advanced", "", "", "0", ""},
    {"filament_map", "coInts", "Filament map to extruder", "", "", "Which extruder each filament goes to.", "", "develop", "", "", "", ""},
    {"filament_map_mode", "coEnum", "filament mapping mode", "", "", "How filaments are assigned to extruders on this plate: automatically for the least flushing, automatically to match the loaded filaments, by hand, or the printer's default.", "", "advanced", "Auto For Flush\nAuto For Match\nManual\nDefault", "Auto For Flush\nAuto For Match\nManual\nDefault", "", ""},
    {"filament_max_volumetric_speed", "coFloats", "Max volumetric speed", "", "mm³/s", "Most plastic the hot end can melt per second. Every speed is limited so the flow stays below this. Cannot be 0.", "", "advanced", "", "", "0", ""},
    {"filament_minimal_purge_on_wipe_tower", "coFloats", "Minimal purge on wipe tower", "", "mm³", "Smallest amount purged on the prime tower after a change, before purging into infill or support. Right after loading, the filament's position and pressure in the nozzle are not settled, so this is always printed on the tower first.", "", "advanced", "", "", "0", ""},
    {"filament_multi_colour", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_multitool_ramming", "coBools", "Enable ramming for multi-tool setups", "", "", "On printers with several separate tools, quickly push a little filament out on the prime tower just before each tool change, which shapes the tip for the next load.", "", "advanced", "", "", "", ""},
    {"filament_multitool_ramming_flow", "coFloats", "Multi-tool ramming flow", "", "mm³/s", "Flow of the ramming before a tool change.", "", "advanced", "", "", "0", ""},
    {"filament_multitool_ramming_volume", "coFloats", "Multi-tool ramming volume", "", "mm³", "Amount of filament rammed before a tool change.", "", "advanced", "", "", "0", ""},
    {"filament_notes", "coStrings", "Filament notes", "", "", "Your own notes about this filament.", "", "advanced", "", "", "", ""},
    {"filament_printable", "coInts", "Filament printable", "", "", "Whether this filament can be printed by the extruder.", "", "develop", "", "", "", ""},
    {"filament_ramming_parameters", "coStrings", "Ramming parameters", "", "", "Ramming settings, edited in the ramming dialog.", "", "advanced", "", "", "", ""},
    {"filament_self_index", "coInts", "Filament self index", "", "", "This filament's own index.", "", "simple", "", "", "", ""},
    {"filament_settings_id", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_shrink", "coPercents", "Shrinkage (XY)", "", "%", "How big the part is after cooling, in percent (94% if 100 mm comes out as 94 mm). The part is scaled up in X and Y to make up for it. With several filaments, use the same value for all of them.", "", "advanced", "", "", "50", "150"},
    {"filament_shrinkage_compensation_z", "coPercents", "Shrinkage (Z)", "", "%", "How tall the part is after cooling, in percent (94% if 100 mm comes out as 94 mm). The part is scaled up in Z to make up for it.", "", "advanced", "", "", "50", "150"},
    {"filament_soluble", "coBools", "Soluble material", "", "", "This filament dissolves (for example in water), and is meant for supports and support interfaces.", "", "advanced", "", "", "", ""},
    {"filament_stamping_distance", "coFloats", "Stamping distance measured from the center of the cooling tube", "", "", "When not 0, the filament is pushed this far toward the nozzle between the cooling moves (\"stamping\") and pulled back again.", "", "advanced", "", "", "0", ""},
    {"filament_stamping_loading_speed", "coFloats", "Stamping loading speed", "", "", "Speed of the stamping moves.", "", "advanced", "", "", "0", ""},
    {"filament_start_gcode", "coStrings", "Start G-code", "", "", "G-code added when this filament starts printing.", "", "advanced", "", "", "", ""},
    {"filament_toolchange_delay", "coFloats", "Delay after unloading", "", "s", "Wait this long after unloading. Flexible filaments sometimes need time to shrink back before the next change works reliably.", "", "advanced", "", "", "0", ""},
    {"filament_tower_interface_pre_extrusion_dist", "coFloats", "Interface layer pre-extrusion distance", "", "mm", "Pre-extrusion distance on the prime tower where two materials meet.", "", "advanced", "", "", "0", ""},
    {"filament_tower_interface_pre_extrusion_length", "coFloats", "Interface layer pre-extrusion length", "", "mm", "Pre-extrusion length on the prime tower where two materials meet.", "", "advanced", "", "", "0", ""},
    {"filament_tower_interface_print_temp", "coInts", "Interface layer print temperature", "", "°C", "Nozzle temperature on the prime tower where two materials meet. -1 uses the top of the recommended range.", "", "advanced", "", "", "-1", ""},
    {"filament_tower_interface_purge_volume", "coFloats", "Interface layer purge length", "", "mm", "Purge length on the prime tower where two materials meet.", "", "advanced", "", "", "0", ""},
    {"filament_tower_ironing_area", "coFloats", "Tower ironing area", "", "mm²", "Area ironed on the prime tower where two materials meet.", "", "advanced", "", "", "0", ""},
    {"filament_type", "coStrings", "Type", "", "", "Material of the filament (PLA, PETG, ABS and so on).", "", "simple", "", "", "", ""},
    {"filament_unloading_speed", "coFloats", "Unloading speed", "", "mm/s", "Speed of unloading at the prime tower, after the first part right after ramming.", "", "advanced", "", "", "0", ""},
    {"filament_unloading_speed_start", "coFloats", "Unloading speed at the start", "", "mm/s", "Speed of pulling the tip out right after ramming.", "", "advanced", "", "", "0", ""},
    {"filament_vendor", "coStrings", "Vendor", "", "", "Maker of the filament, for display only.", "", "advanced", "", "", "", ""},
    {"file_start_gcode", "coString", "File header G-code", "", "", "G-code at the very top of the file, before anything else. For information some firmware reads from the first lines, like print time or filament use. Placeholders such as {print_time_sec} work.", "", "advanced", "", "", "", ""},
    {"filename_format", "coString", "Filename format", "", "", "How exported files are named. Placeholders such as {input_filename_base} work.", "", "advanced", "", "", "", ""},
    {"fill_multiline", "coInt", "Fill Multiline", "", "", "Print each infill line as several lines side by side, for patterns that support it.", "Strength", "simple", "", "", "1", "10"},
    {"filter_out_gap_fill", "coFloat", "Filter out tiny gaps", "", "mm", "Skip gap fill shorter than this. Applies to top, bottom and solid infill, and to wall gaps with the classic wall generator.", "Layers and Perimeters", "advanced", "", "", "", ""},
    {"first_layer_flow_ratio", "coFloat", "First layer flow ratio", "", "", "Extra flow multiplier for the first layer, on top of each line type's own flow. Brim and skirt are not affected.", "Advanced", "advanced", "", "", "0", "2"},
    {"first_layer_print_sequence", "coInts", "First layer print sequence", "", "", "", "", "simple", "", "", "0", "16"},
    {"first_layer_sequence_choice", "coEnum", "First layer filament sequence", "", "", "", "Quality", "simple", "Auto\nCustomize", "Auto\nCustomize", "", ""},
    {"first_x_layer_fan_speed", "coFloats", "Fan speed", "", "%", "Auxiliary fan speed for the first layers set above only.", "", "simple", "", "", "0", "100"},
    {"flashforge_serial_number", "coString", "Serial Number", "", "", "The printer's serial number, needed by Flashforge's local connection.", "", "advanced", "", "", "", ""},
    {"flush_into_infill", "coBool", "Flush into objects' infill", "", "", "Purge after filament changes into the parts' infill instead of the prime tower, which wastes less and prints faster. Mixed colors can show through clear walls. Needs the prime tower.", "Flush options", "simple", "", "", "", ""},
    {"flush_into_objects", "coBool", "Flush into this object", "", "", "Use this object to purge after filament changes, which saves filament and time but mixes its colors. Needs the prime tower.", "Flush options", "simple", "", "", "", ""},
    {"flush_into_support", "coBool", "Flush into objects' support", "", "", "Purge after filament changes into the support, which wastes less and prints faster. Needs the prime tower.", "Flush options", "simple", "", "", "", ""},
    {"flush_multiplier", "coFloats", "Flush multiplier", "", "", "Scales every amount in the purging volume table.", "", "simple", "", "", "", ""},
    {"flush_volumes_matrix", "coFloats", "Purging volumes", "", "", "How much (mm³) to purge on the prime tower when changing from one filament to another, for every pair.", "", "simple", "", "", "", ""},
    {"flush_volumes_vector", "coFloats", "Purging volumes - load/unload volumes", "", "", "Purge amounts when loading or unloading each filament, used to fill in the full table more easily.", "", "simple", "", "", "", ""},
    {"full_fan_speed_layer", "coInts", "Full fan speed at layer", "", "layer", "The part cooling fan ramps up evenly from the last layer without cooling and reaches full speed at this layer. If this number is lower, the fan goes straight to full speed after the layers without cooling.", "", "advanced", "", "", "0", "1000"},
    {"fuzzy_skin", "coEnum", "Fuzzy Skin", "", "", "Moves the nozzle randomly while printing walls for a rough, textured surface. Choose which walls get it: outer, holes, both, all walls, only painted areas, or none.", "Others", "simple", "none\nexternal\nhole\nall\nallwalls\ndisabled_fuzzy", "Painted only\nContour\nHole\nContour and hole\nAll walls\nDisabled", "", ""},
    {"fuzzy_skin_first_layer", "coBool", "Apply fuzzy skin to first layer", "", "", "Also make the first layer fuzzy.", "Others", "simple", "", "", "", ""},
    {"fuzzy_skin_layers_between_ripple_offset", "coInt", "Layers between ripple offset", "", "", "How many layers in a row keep the same ripple position before the offset shifts it. 1 shifts every other layer, 2 shifts every second pair, and so on.", "Others", "advanced", "", "", "1", ""},
    {"fuzzy_skin_mode", "coEnum", "Fuzzy skin generator mode", "", "", "How the texture is made (Arachne wall generator only). Displacement moves the nozzle sideways from the wall line. Extrusion changes the amount of plastic along the line instead. Combined does both.", "Others", "simple", "displacement\nextrusion\ncombined", "Displacement\nExtrusion\nCombined", "", ""},
    {"fuzzy_skin_noise_type", "coEnum", "Fuzzy skin noise type", "", "", "Kind of noise for the texture: classic random, Perlin (smoother and more even), billow (lumpier), ridged multifractal (sharp ridges), Voronoi (cell pattern) or ripple (regular waves).", "Others", "simple", "classic\nperlin\nbillow\nridgedmulti\nvoronoi\nripple", "Classic\nPerlin\nBillow\nRidged Multifractal\nVoronoi\nRipple", "", ""},
    {"fuzzy_skin_octaves", "coInt", "Fuzzy Skin Noise Octaves", "", "", "Layers of detail in the noise. More gives finer detail and slower slicing.", "Others", "advanced", "", "", "1", "10"},
    {"fuzzy_skin_persistence", "coFloat", "Fuzzy skin noise persistence", "", "", "How strong the finer noise layers are. Lower gives smoother texture.", "Others", "advanced", "", "", "", "1"},
    {"fuzzy_skin_point_distance", "coFloat", "Fuzzy skin point distance", "", "mm", "Average distance between the random points along each wall line.", "Others", "simple", "", "", "", ""},
    {"fuzzy_skin_ripple_offset", "coPercent", "Ripple offset", "", "%", "How far the ripple pattern shifts along the wall each time, as a share of one wave. 0% keeps every layer the same, 50% puts peaks over valleys, 100% looks the same as 0%.", "Others", "advanced", "", "", "0", "100"},
    {"fuzzy_skin_ripples_per_layer", "coInt", "Number of ripples per layer", "", "", "Number of full waves around each layer.", "Others", "advanced", "", "", "1", ""},
    {"fuzzy_skin_scale", "coFloat", "Fuzzy skin feature size", "", "mm", "Size of the noise features. Bigger values give bigger bumps.", "Others", "advanced", "", "", "", "500"},
    {"fuzzy_skin_thickness", "coFloat", "Fuzzy skin thickness", "", "mm", "How far the nozzle may move off the wall line. Keep it below the outer wall line width.", "Others", "simple", "", "", "0", "2"},
    {"gap_fill_flow_ratio", "coFloat", "Gap fill flow ratio", "", "", "Flow multiplier for gap fill, applied on top of the filament's flow ratio and the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"gap_fill_target", "coEnum", "Apply gap fill", "", "", "Which solid surfaces get gap fill: everywhere (top, bottom and internal solid), only top and bottom, or nowhere. The shortest gap filled is set by \"Filter out tiny gaps\". Wall gaps are not affected.", "Strength", "advanced", "everywhere\ntopbottom\nnowhere", "Everywhere\nTop and bottom surfaces\nNowhere", "", ""},
    {"gap_infill_speed", "coFloat", "Gap infill", "", "mm/s", "Speed of gap fill. Gaps have uneven line widths and print better slower.", "Speed", "advanced", "", "", "1", ""},
    {"gcode_add_line_number", "coBool", "Add line number", "", "", "Number every G-code line (N1, N2 ...).", "", "develop", "", "", "", ""},
    {"gcode_comments", "coBool", "Verbose G-code", "", "", "Write a comment explaining every G-code line. The file gets much bigger, which can slow down printing from an SD card.", "", "advanced", "", "", "", ""},
    {"gcode_flavor", "coEnum", "G-code flavor", "", "", "Which firmware dialect the printer understands.", "", "advanced", "marlin\nklipper\nreprapfirmware\nrepetier\nmarlin2\nreprap\nteacup\nmakerware\nsailfish\nmach3\nmachinekit\nsmoothie\nno-extrusion", "Marlin(legacy)\nKlipper\nRepRapFirmware\nRepetier\nMarlin 2\nRepRap/Sprinter\nTeacup\nMakerWare (MakerBot)\nSailfish (MakerBot)\nMach3/LinuxCNC\nMachinekit\nSmoothie\nNo extrusion", "", ""},
    {"gcode_label_objects", "coBool", "Label objects", "", "", "Mark in the G-code which object each move belongs to, so objects can be cancelled during the print (for example with OctoPrint's Cancel Object). Does not work with single extruder multi material or with purging into objects or infill.", "", "advanced", "", "", "", ""},
    {"grab_length", "coFloats", "Grab length", "", "mm", "", "", "develop", "", "", "0", ""},
    {"gyroid_optimized", "coBool", "Z-buckling bias optimization (experimental)", "", "", "At low densities, tightens the gyroid's waves vertically so the walls inside are shorter and resist buckling under top-down loads better. Uses the same filament. Makes no difference around 30% density and above. Experimental.", "Strength", "simple", "", "", "", ""},
    {"has_filament_switcher", "coBool", "Has filament switcher", "", "", "The printer has a filament changer such as an AMS.", "", "develop", "", "", "", ""},
    {"has_scarf_joint_seam", "coBool", "", "", "", "", "", "advanced", "", "", "", ""},
    {"head_wrap_detect_zone", "coPoints", "Head wrap detect zone", "", "", "", "", "develop", "", "", "", ""},
    {"high_current_on_filament_swap", "coBool", "High extruder current on filament swap", "", "", "Raise the extruder motor current during filament changes, for fast ramming and for pushing a badly shaped tip through.", "", "advanced", "", "", "", ""},
    {"hole_to_polyhole", "coBool", "Convert holes to polyholes", "", "", "Turn nearly round holes that are taller than one layer into polyholes (polygons sized for the nozzle), which print closer to their true size.", "Quality", "advanced", "", "", "", ""},
    {"hole_to_polyhole_threshold", "coFloatOrPercent", "Polyhole detection margin", "", "mm or %", "How far points may be from a perfect circle and still count as a round hole. Models often store circles as uneven triangles, so some margin helps find them. In mm, or a percentage of the radius.", "Quality", "advanced", "", "", "", ""},
    {"hole_to_polyhole_twisted", "coBool", "Polyhole twist", "", "", "Rotate the polyhole a little every layer.", "Quality", "advanced", "", "", "", ""},
    {"host_type", "coEnum", "Host Type", "", "", "Kind of print host the printer uses, for uploading G-code to it.", "", "advanced", "prusalink\nprusaconnect\noctoprint\nduet\nflashair\nastrobox\nrepetier\nmks\nesp3d\ncrealityprint\nobico\nflashforge\nsimplyprint\nelegoolink\n3dprinteros\nmoonraker", "PrusaLink\nPrusaConnect\nOcto/Klipper\nDuet\nFlashAir\nAstroBox\nRepetier\nMKS\nESP3D\nCrealityPrint\nObico\nFlashforge\nSimplyPrint\nElegoo Link\n3DPrinterOS\nMoonraker (Klipper)", "", ""},
    {"hot_plate_temp", "coInts", "Other layers", "Bed temperature", "°C", "Bed temperature on the High Temp Plate after the first layer. 0 means this filament should not be printed on the High Temp Plate.", "", "simple", "", "", "0", "300"},
    {"hot_plate_temp_initial_layer", "coInts", "First layer", "First layer bed temperature", "°C", "Bed temperature on the High Temp Plate for the first layer. 0 means this filament should not be printed on the High Temp Plate.", "", "simple", "", "", "", "300"},
    {"idle_temperature", "coInts", "Idle temperature", "", "°C", "Nozzle temperature for a tool that is not in use on multi-tool printers, when ooze prevention is on. 0 turns it off.", "", "simple", "", "", "0", ""},
    {"independent_support_layer_height", "coBool", "Independent support layer height", "", "", "Let support use its own layer height, separate from the part's, to tune the Z gap and save time. Not available with a prime tower.", "Support", "advanced", "", "", "", ""},
    {"infill_anchor", "coFloatOrPercent", "Sparse infill anchor length", "", "mm or %", "Length of the short wall pieces that connect infill lines to the walls. A percentage is taken from the infill line width. Nearby infill lines are joined along the wall where possible, and shorter connections than this are used where not. 0 leaves lines unconnected, 1000 means no limit.", "Strength", "advanced", "0\n1\n2\n5\n10\n1000", "0 (no open anchors)\n1 mm\n2 mm\n5 mm\n10 mm\n1000 (unlimited)", "", ""},
    {"infill_anchor_max", "coFloatOrPercent", "Maximum length of the infill anchor", "", "", "Longest wall piece used to connect infill lines to the walls. A percentage is taken from the infill line width. 0 connects only with simple short joins, 1000 means no limit.", "Strength", "advanced", "", "0 (Simple connect)\n1 mm\n2 mm\n5 mm\n10 mm\n1000 (unlimited)", "", ""},
    {"infill_combination", "coBool", "Infill combination", "", "", "Print sparse infill once every few layers, at a thicker layer height, to save time. Walls keep the normal layer height.", "Strength", "advanced", "", "", "", ""},
    {"infill_combination_max_layer_height", "coFloatOrPercent", "Infill combination - Max layer height", "", "mm or %", "Thickest layer the combined infill may use. 0 or 100% uses the nozzle diameter (fastest), around 80% gives stronger infill. The number of layers combined comes from this divided by the layer height.", "Strength", "advanced", "", "", "0", ""},
    {"infill_direction", "coFloat", "Sparse infill direction", "", "°", "Angle of the sparse infill lines (where the pattern starts or runs).", "Strength", "advanced", "", "", "0", "360"},
    {"infill_jerk", "coFloat", "Infill", "", "mm/s", "Jerk for infill.", "Speed", "advanced", "", "", "0", ""},
    {"infill_lock_depth", "coFloat", "Infill lock depth", "", "mm", "How far the infill and the outer skin overlap, so they hold together.", "Strength", "advanced", "", "", "0", "100"},
    {"infill_overhang_angle", "coFloat", "Infill overhang angle", "", "°", "Angle of the slanted infill lines. 60° gives a true honeycomb.", "Strength", "advanced", "", "", "15", "75"},
    {"infill_shift_step", "coFloat", "Infill shift step", "", "mm", "Shift each infill layer slightly, for a crossed texture.", "Strength", "advanced", "", "", "0", "10"},
    {"infill_wall_overlap", "coPercent", "Infill/Wall overlap", "", "%", "Grows the infill a little into the walls so they bond. Percentage of the sparse infill line width. About 10 to 15% avoids too much plastic building up.", "Strength", "advanced", "", "", "", ""},
    {"inherits", "coString", "Inherits profile", "", "", "The parent profile this one is based on.", "", "simple", "", "", "", ""},
    {"inherits_group", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"initial_layer_acceleration", "coFloat", "First layer", "", "mm/s²", "Acceleration on the first layer. Lower values help it stick to the plate.", "Speed", "advanced", "", "", "0", ""},
    {"initial_layer_infill_speed", "coFloat", "First layer infill", "", "mm/s", "Speed of solid infill on the first layer.", "", "advanced", "", "", "1", ""},
    {"initial_layer_jerk", "coFloat", "First layer", "", "mm/s", "Jerk on the first layer.", "Speed", "advanced", "", "", "0", ""},
    {"initial_layer_line_width", "coFloatOrPercent", "First layer", "", "mm or %", "Line width on the first layer. A percentage is taken from the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
