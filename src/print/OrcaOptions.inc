    {"support_object_xy_distance", "coFloat", "Support/object XY distance", "", "mm", "Sideways gap between the part and its support.", "Support", "advanced", "", "", "0", "10"},
    {"support_on_build_plate_only", "coBool", "On build plate only", "", "", "Only build support up from the plate, never on the part itself.", "Support", "simple", "", "", "", ""},
