    {"printer_technology", "coEnum", "Printer technology", "", "", "Printer technology.", "", "simple", "FFF\nSLA", "", "", ""},
    {"printer_variant", "coString", "Printer variant", "", "", "Name of the printer variant. For example, the printer variants may be differentiated by a nozzle diameter.", "", "simple", "", "", "", ""},
    {"printhost_apikey", "coString", "API Key / Password", "", "", "Orca Slicer can upload G-code files to a printer host. This field should contain the API Key or the password required for authentication.", "", "advanced", "", "", "", ""},
    {"printhost_authorization_type", "coEnum", "Authorization Type", "", "", "", "", "advanced", "key\nuser", "API key\nHTTP digest", "", ""},
    {"printhost_cafile", "coString", "HTTPS CA File", "", "", "Custom CA certificate file can be specified for HTTPS OctoPrint connections, in crt/pem format. If left blank, the default OS CA certificate repository is used.", "", "advanced", "", "", "", ""},
    {"printhost_password", "coString", "Password", "", "", "", "", "advanced", "", "", "", ""},
    {"printhost_port", "coString", "Printer", "", "", "Name of the printer.", "", "advanced", "", "", "", ""},
    {"printhost_ssl_ignore_revoke", "coBool", "Ignore HTTPS certificate revocation checks", "", "", "Ignore HTTPS certificate revocation checks in case of missing or offline distribution points. One may want to enable this option for self signed certificates if connection fails.", "", "advanced", "", "", "", ""},
    {"printhost_user", "coString", "User", "", "", "", "", "advanced", "", "", "", ""},
    {"printing_by_object_gcode", "coString", "Between Object G-code", "", "", "Insert G-code between objects. This parameter will only come into effect when you print your models object by object.", "", "advanced", "", "", "", ""},
    {"process_change_extrusion_role_gcode", "coString", "Change extrusion role G-code (process)", "", "", "This G-code is inserted when the extrusion role is changed. It runs after the machine and filament extrusion role G-code.", "", "advanced", "", "", "", ""},
    {"purge_in_prime_tower", "coBool", "Purge in prime tower", "", "", "Purge remaining filament into prime tower.", "", "advanced", "", "", "", ""},
    {"raft_contact_distance", "coFloat", "Raft contact Z distance", "", "mm", "Z gap between raft and object. If Support Top Z Distance is 0, this value is ignored and the object is printed in direct contact with the raft (no gap).", "Support", "advanced", "", "", "0", ""},
    {"raft_expansion", "coFloat", "Raft expansion", "", "mm", "Expand all raft layers in XY plane.", "Support", "advanced", "", "", "0", ""},
    {"raft_first_layer_density", "coPercent", "First layer density", "", "%", "Density of the first raft or support layer.", "Support", "advanced", "", "", "10", "100"},
    {"raft_first_layer_expansion", "coFloat", "First layer expansion", "", "mm", "Expand the first raft or support layer to improve bed plate adhesion.", "Support", "advanced", "", "", "0", ""},
    {"raft_layers", "coInt", "Raft layers", "", "layers", "Object will be raised by this number of support layers. Use this function to avoid warping when printing ABS.", "Support", "advanced", "", "", "0", "100"},
    {"reduce_crossing_wall", "coBool", "Avoid crossing walls", "", "", "Detour to avoid traveling across walls, which may cause blobs on the surface.", "Quality", "advanced", "", "", "", ""},
    {"reduce_fan_stop_start_freq", "coBools", "Keep fan always on", "", "", "Enabling this setting means that the part cooling fan will never stop completely and will run at least at minimum speed to reduce the frequency of starting and stopping.", "", "simple", "", "", "", ""},
    {"reduce_infill_retraction", "coBool", "Reduce infill retraction", "", "", "Don't retract when the travel is entirely within an infill area. That means the oozing can't been seen. This can reduce times of retraction for complex model and save printing time, but make slicing and G-code generating slower. Note that z-hop is also not performed in areas where retraction is skipped.", "", "advanced", "", "", "", ""},
    {"relative_bridge_angle", "coBool", "Relative bridge angle", "", "", "When enabled, the bridge angle values are added to the automatically calculated bridge direction instead of overriding it.", "Strength", "advanced", "", "", "", ""},
    {"resolution", "coFloat", "Resolution", "", "mm", "The G-code path is generated after simplifying the contour of models to avoid too many points and G-code lines. Smaller value means higher resolution and more time to slice.", "", "advanced", "", "", "0", ""},
    {"resonance_avoidance", "coBool", "Resonance avoidance", "", "", "By reducing the speed of the outer wall to avoid the resonance zone of the printer, ringing on the surface of the model are avoided.\nPlease turn this option off when testing ringing.", "", "advanced", "", "", "", ""},
    {"retract_before_wipe", "coPercents", "Retract amount before wipe", "", "%", "The length of fast retraction before wipe, relative to retraction length.", "", "advanced", "", "", "", ""},
    {"retract_length_toolchange", "coFloats", "Length", "Retraction Length (Toolchange)", "mm", "When retraction is triggered before changing tool, filament is pulled back by the specified amount (the length is measured on raw filament, before it enters the extruder).", "", "advanced", "", "", "", ""},
    {"retract_lift_above", "coFloats", "Only lift Z above", "", "mm", "If you set this to a positive value, Z lift will only take place above the specified absolute Z.", "", "advanced", "", "", "", ""},
    {"retract_lift_below", "coFloats", "Only lift Z below", "", "mm", "If you set this to a positive value, Z lift will only take place below the specified absolute Z.", "", "advanced", "", "", "", ""},
    {"retract_lift_enforce", "coEnums", "On surfaces", "", "", "Enforce Z-Hop behavior. This setting is impacted by the above settings (Only lift Z above/below).", "", "advanced", "All Surfaces\nTop Only\nBottom Only\nTop and Bottom", "All Surfaces\nTop Only\nBottom Only\nTop and Bottom", "", ""},
    {"retract_restart_extra", "coFloats", "Extra length on restart", "", "mm", "When the retraction is compensated after the travel move, the extruder will push this additional amount of filament. This setting is rarely needed.", "", "advanced", "", "", "", ""},
    {"retract_restart_extra_toolchange", "coFloats", "Extra length on restart", "", "mm", "When the retraction is compensated after changing tool, the extruder will push this additional amount of filament.", "", "advanced", "", "", "", ""},
    {"retract_when_changing_layer", "coBools", "Retract when change layer", "", "", "Force a retraction when changes layer.", "", "advanced", "", "", "", ""},
    {"retraction_distances_when_cut", "coFloats", "Retraction distance when cut", "", "", "Experimental feature: Retraction length before cutting off during filament change.", "", "develop", "", "", "10", "18"},
    {"retraction_distances_when_ec", "coFloats", "Retraction distance when extruder change", "", "mm", "", "", "advanced", "", "", "0", "10"},
    {"retraction_length", "coFloats", "Length", "Retraction Length", "mm", "Some amount of material in extruder is pulled back to avoid ooze during long travel. Set zero to disable retraction.", "", "simple", "", "", "", ""},
    {"retraction_minimum_travel", "coFloats", "Travel distance threshold", "", "mm", "Only trigger retraction when the travel distance is longer than this threshold.", "", "advanced", "", "", "", ""},
    {"retraction_speed", "coFloats", "Retraction Speed", "Retraction Speed", "mm/s", "Speed for retracting filament from the nozzle.", "", "advanced", "", "", "", ""},
    {"role_based_wipe_speed", "coBool", "Role base wipe speed", "", "", "The wipe speed is determined by the speed of the current extrusion role. e.g. if a wipe action is executed immediately following an outer wall extrusion, the speed of the outer wall extrusion will be utilized for the wipe action.", "Speed", "advanced", "", "", "", ""},
    {"scan_first_layer", "coBool", "Scan first layer", "", "", "Enable this to enable the camera on printer to check the quality of first layer.", "", "advanced", "", "", "", ""},
    {"scarf_angle_threshold", "coInt", "Conditional angle threshold", "", "°", "This option sets the threshold angle for applying a conditional scarf joint seam.\nIf the maximum angle within the perimeter loop exceeds this value (indicating the absence of sharp corners), a scarf joint seam will be used. The default value is 155°.", "Quality", "advanced", "", "", "0", "180"},
    {"scarf_joint_flow_ratio", "coFloat", "Scarf joint flow ratio", "", "", "This factor affects the amount of material for scarf joints.", "Quality", "simple", "", "", "0", "2"},
    {"scarf_joint_speed", "coFloatOrPercent", "Scarf joint speed", "", "mm/s or %", "This option sets the printing speed for scarf joints. It is recommended to print scarf joints at a slow speed (less than 100 mm/s). It's also advisable to enable 'Extrusion rate smoothing' if the set speed varies significantly from the speed of the outer or inner walls. If the speed specified here is higher than the speed of the outer or inner walls, the printer will default to the slower of the two speeds. When specified as a percentage (e.g., 80%), the speed is calculated based on the respective outer or inner wall speed. The default value is set to 100%.", "Quality", "advanced", "", "", "1", ""},
    {"scarf_overhang_threshold", "coPercent", "Conditional overhang threshold", "", "%", "This option determines the overhang threshold for the application of scarf joint seams. If the unsupported portion of the perimeter is less than this threshold, scarf joint seams will be applied. The default threshold is set at 40% of the external wall's width. Due to performance considerations, the degree of overhang is estimated.", "Quality", "advanced", "", "", "0", ""},
    {"seam_gap", "coFloatOrPercent", "Seam gap", "", "mm or %", "In order to reduce the visibility of the seam in a closed loop extrusion, the loop is interrupted and shortened by a specified amount.\nThis amount can be specified in millimeters or as a percentage of the current extruder diameter. The default value for this parameter is 10%.", "Quality", "advanced", "", "", "0", ""},
    {"seam_position", "coEnum", "Seam position", "", "", "The start position to print each part of outer wall.", "Quality", "simple", "nearest\naligned\naligned_back\nback\nrandom", "Nearest\nAligned\nAligned back\nBack\nRandom", "", ""},
    {"seam_slope_conditional", "coBool", "Conditional scarf joint", "", "", "Apply scarf joints only to smooth perimeters where traditional seams do not conceal the seams at sharp corners effectively.", "Quality", "advanced", "", "", "", ""},
    {"seam_slope_entire_loop", "coBool", "Scarf around entire wall", "", "", "The scarf extends to the entire length of the wall.", "Quality", "advanced", "", "", "", ""},
    {"seam_slope_inner_walls", "coBool", "Scarf joint for inner walls", "", "", "Use scarf joint for inner walls as well.", "Quality", "advanced", "", "", "", ""},
    {"seam_slope_min_length", "coFloat", "Scarf length", "", "mm", "Length of the scarf. Setting this parameter to zero effectively disables the scarf.", "Quality", "advanced", "", "", "0", ""},
    {"seam_slope_start_height", "coFloatOrPercent", "Scarf start height", "", "mm or %", "Start height of the scarf.\nThis amount can be specified in millimeters or as a percentage of the current layer height. The default value for this parameter is 0.", "Quality", "advanced", "", "", "0", ""},
    {"seam_slope_steps", "coInt", "Scarf steps", "", "", "Minimum number of segments of each scarf.", "Quality", "advanced", "", "", "1", ""},
    {"seam_slope_type", "coEnum", "Scarf joint seam (beta)", "", "", "Use scarf joint to minimize seam visibility and increase seam strength.", "Quality", "advanced", "none\nexternal\nall", "None\nContour\nContour and hole", "", ""},
    {"set_other_flow_ratios", "coBool", "Set other flow ratios", "", "", "Change flow ratios for other extrusion path types.", "Advanced", "advanced", "", "", "", ""},
    {"silent_mode", "coBool", "Supports silent mode", "", "", "Whether the machine supports silent mode in which machine use lower acceleration to print.", "", "develop", "", "", "", ""},
    {"single_extruder_multi_material", "coBool", "Single Extruder Multi Material", "", "", "Use single nozzle to print multi filament.", "", "advanced", "", "", "", ""},
    {"single_extruder_multi_material_priming", "coBool", "Prime all printing extruders", "", "", "If enabled, all printing extruders will be primed at the front edge of the print bed at the start of the print.", "", "advanced", "", "", "", ""},
    {"single_loop_draft_shield", "coBool", "Single loop after first layer", "", "", "Limits the skirt/draft shield loops to one wall after the first layer. This is useful, on occasion, to conserve filament but may cause the draft shield/skirt to warp / crack.", "", "advanced", "", "", "", ""},
    {"skeleton_infill_density", "coPercent", "Skeleton infill density", "", "%", "The remaining part of the model contour after removing a certain depth from the surface is called the skeleton. This parameter is used to adjust the density of this section. When two regions have the same sparse infill settings but different skeleton densities, their skeleton areas will develop overlapping sections. Default is as same as infill density.", "Strength", "advanced", "", "", "0", "100"},
    {"skeleton_infill_line_width", "coFloatOrPercent", "Skeleton line width", "", "mm", "Adjust the line width of the selected skeleton paths.", "Strength", "advanced", "", "", "0", ""},
    {"skin_infill_density", "coPercent", "Skin infill density", "", "%", "The portion of the model's outer surface within a certain depth range is called the skin. This parameter is used to adjust the density of this section. When two regions have the same sparse infill settings but different skin densities, this area will not be split into two separate regions. Default is as same as infill density.", "Strength", "advanced", "", "", "0", "100"},
    {"skin_infill_depth", "coFloat", "Skin infill depth", "", "mm", "The parameter sets the depth of skin.", "Strength", "advanced", "", "", "0", "100"},
    {"skin_infill_line_width", "coFloatOrPercent", "Skin line width", "", "mm", "Adjust the line width of the selected skin paths.", "Strength", "advanced", "", "", "0", ""},
    {"skirt_distance", "coFloat", "Skirt distance", "", "mm", "The distance from the skirt to the brim or the object.", "", "advanced", "", "", "0", "60"},
    {"skirt_height", "coInt", "Skirt height", "", "layers", "How many layers of skirt. Usually only one layer.", "", "simple", "", "", "", "10000"},
    {"skirt_loops", "coInt", "Skirt loops", "Skirt loops", "", "Number of loops for the skirt. Zero means disabling skirt.", "", "simple", "", "", "0", "10"},
    {"skirt_speed", "coFloat", "Skirt speed", "Skirt speed", "mm/s", "Speed of skirt, in mm/s. Zero means use default layer extrusion speed.", "", "advanced", "", "", "0", ""},
    {"skirt_start_angle", "coFloat", "Skirt start point", "", "°", "Angle from the object center to skirt start point. Zero is the most right position, counter clockwise is positive angle.", "Support", "advanced", "", "", "-180", "180"},
    {"skirt_type", "coEnum", "Skirt type", "Skirt type", "", "Combined - single skirt for all objects, Per object - individual object skirt.", "", "advanced", "combined\nperobject", "Combined\nPer object", "", ""},
    {"slice_closing_radius", "coFloat", "Slice gap closing radius", "", "mm", "Cracks smaller than 2x gap closing radius are being filled during the triangle mesh slicing. The gap closing operation may reduce the final print resolution, therefore it is advisable to keep the value reasonably low.", "Quality", "advanced", "", "", "0", ""},
    {"slicing_mode", "coEnum", "Slicing Mode", "", "", "Use \"Even-odd\" for 3DLabPrint airplane models. Use \"Close holes\" to close all holes in the model.", "Other", "advanced", "regular\neven_odd\nclose_holes", "Regular\nEven-odd\nClose holes", "", ""},
    {"slow_down_for_layer_cooling", "coBools", "Slow printing down for better layer cooling", "", "", "Enable this option to slow printing speed down to make the final layer time not shorter than the layer time threshold in \"Max fan speed threshold\", so that layer can be cooled for longer time. This can improve the cooling quality for needle and small details.", "", "simple", "", "", "", ""},
    {"slow_down_layer_time", "coFloats", "Layer time", "", "s", "The printing speed in exported G-code will be slowed down when the estimated layer time is shorter than this value in order to get better cooling for these layers.", "", "simple", "", "", "0", "1000"},
    {"slow_down_layers", "coInt", "Number of slow layers", "", "layers", "The first few layers are printed slower than normal. The speed is gradually increased in a linear fashion over the specified number of layers.", "Speed", "advanced", "", "", "0", ""},
    {"slow_down_min_speed", "coFloats", "Min print speed", "", "mm/s", "The minimum print speed to which the printer slows down to maintain the minimum layer time defined above when the slowdown for better layer cooling is enabled.", "", "advanced", "", "", "0", ""},
    {"slowdown_for_curled_perimeters", "coBool", "Slow down for curled perimeters", "", "", "Enable this option to slow down printing in areas where perimeters may have curled upwards.\nFor example, additional slowdown will be applied when printing overhangs on sharp corners like the front of the Benchy hull, reducing curling which compounds over multiple layers.\n\nIt is generally recommended to have this option switched on unless your printer cooling is powerful enough or the print speed is slow enough that perimeter curling does not happen. \nIf printing with a high external perimeter speed, this parameter may introduce wall artifacts when slowing down, due to the potentially large variance in print speeds causing the extruder to be unable to keep up with the requested flow change.\nRoot cause of these artifacts is most likely PA tuning being slightly off, especially when combined with a high PA smooth time.\n\nRecommendations when enabling this option:\n1. Reduce Pressure Advance smooth time to 0.015 - 0.02 so the extruder reacts quickly to the speed changes.\n2. Increase the minimum print speeds to limit the magnitude of the slowdown and reduce the variance between fast and slow segments.\n3. If artifacts still appear, enable Extrusion Rate Smoothing (ERS) to further smooth the flow transitions.\n\nNote: When this option is enabled, overhang perimeters are treated like overhangs, meaning the overhang speed is applied even if the overhanging perimeter is part of a bridge.\nFor example, when the perimeters are 100% overhanging, with no wall supporting them from underneath, the", "Speed", "advanced", "", "", "", ""},
    {"small_area_infill_flow_compensation", "coBool", "Small area flow compensation (beta)", "", "", "Enable flow compensation for small infill areas.", "Quality", "advanced", "", "", "", ""},
    {"small_area_infill_flow_compensation_model", "coStrings", "Flow Compensation Model", "", "", "Flow Compensation Model, used to adjust the flow for small infill areas. The model is expressed as a comma separated pair of values for extrusion length and flow correction factor. Each pair is on a separate line, followed by a semicolon, in the following format: \"1.234, 5.678;\"", "", "advanced", "", "", "", ""},
    {"small_perimeter_speed", "coFloatOrPercent", "Small perimeters", "", "mm/s or %", "This separate setting will affect the speed of perimeters having radius <= small_perimeter_threshold (usually holes). If expressed as percentage (for example: 80%) it will be calculated on the outer wall speed setting above. Set to zero for auto.", "Speed", "advanced", "", "", "1", ""},
    {"small_perimeter_threshold", "coFloat", "Small perimeters threshold", "", "mm", "This sets the threshold for small perimeter length. Default threshold is 0mm.", "Speed", "advanced", "", "", "0", ""},
    {"solid_infill_direction", "coFloat", "Solid infill direction", "", "°", "Angle for solid infill pattern, which controls the start or main direction of line.", "Strength", "advanced", "", "", "0", "360"},
    {"solid_infill_rotate_template", "coString", "Solid infill rotation template", "", "°", "This parameter adds a rotation of solid infill direction to each layer according to the specified template. The template is a comma-separated list of angles in degrees, e.g. '0,90'. The first angle is applied to the first layer, the second angle to the second layer, and so on. If there are more layers than angles, the angles will be repeated. Note that not all solid infill patterns support rotation.", "Strength", "advanced", "", "", "", ""},
    {"spaghetti_detector", "coBool", "Enable spaghetti detector", "", "", "Enable the camera on printer to check spaghetti.", "", "simple", "", "", "", ""},
    {"sparse_infill_acceleration", "coFloatOrPercent", "Sparse infill", "", "mm/s² or %", "Acceleration of sparse infill. If the value is expressed as a percentage (e.g. 100%), it will be calculated based on the default acceleration.", "Speed", "advanced", "", "", "0", ""},
    {"sparse_infill_density", "coPercent", "Sparse infill density", "", "%", "Density of internal sparse infill, 100% turns all sparse infill into solid infill and internal solid infill pattern will be used.", "Strength", "simple", "", "", "0", "100"},
    {"sparse_infill_filament_id", "coInt", "Infill", "", "", "Filament to print internal sparse infill.\n\"Default\" uses the active object/part filament.", "Extruders", "advanced", "", "", "0", ""},
    {"sparse_infill_flow_ratio", "coFloat", "Sparse infill flow ratio", "", "", "This factor affects the amount of material for sparse infill.\n\nThe actual sparse infill flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"sparse_infill_line_width", "coFloatOrPercent", "Sparse infill", "", "mm or %", "Line width of internal sparse infill. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"sparse_infill_pattern", "coEnum", "Sparse infill pattern", "", "", "Line pattern for internal sparse infill.", "Strength", "simple", "rectilinear\nalignedrectilinear\nzigzag\ncrosszag\nlockedzag\nline\ngrid\ntriangles\ntri-hexagon\ncubic\nadaptivecubic\nquartercubic\nsupportcubic\nlightning\nhoneycomb\n3dhoneycomb\nlateral-honeycomb\nlateral-lattice\ncrosshatch\ntpmsd\ntpmsfk\ngyroid\nconcentric\nhilbertcurve\narchimedeanchords\noctagramspiral", "Rectilinear\nAligned Rectilinear\nZig Zag\nCross Zag\nLocked Zag\nLine\nGrid\nTriangles\nTri-hexagon\nCubic\nAdaptive Cubic\nQuarter Cubic\nSupport Cubic\nLightning\nHoneycomb\n3D Honeycomb\nLateral Honeycomb\nLateral Lattice\nCross Hatch\nTPMS-D\nTPMS-FK\nGyroid\nConcentric\nHilbert Curve\nArchimedean Chords\nOctagram Spiral", "", ""},
    {"sparse_infill_rotate_template", "coString", "Sparse infill rotation template", "", "°", "Rotate the sparse infill direction per layer using a template of angles. Enter comma-separated degrees (e.g., '0,30,60,90'). Angles are applied in order by layer and repeat when the list ends. Advanced syntax is supported: '+5' rotates +5° every layer; '+5#5' rotates +5° every 5 layers. See the Wiki for details. When a template is set, the standard infill direction setting is ignored. Note: some infill patterns (e.g., Gyroid) control rotation themselves; use with care.", "Strength", "advanced", "", "", "", ""},
    {"sparse_infill_speed", "coFloat", "Sparse infill", "", "mm/s", "Speed of internal sparse infill.", "Speed", "advanced", "", "", "1", ""},
    {"spiral_finishing_flow_ratio", "coFloat", "Spiral finishing flow ratio", "", "", "Sets the finishing flow ratio while ending the spiral. Normally the spiral transition scales the flow ratio from 100% to 0% during the last loop which can in some cases lead to under extrusion at the end of the spiral.", "", "advanced", "", "", "0", "1"},
    {"spiral_mode", "coBool", "Spiral vase", "", "", "Spiralize smooths out the Z moves of the outer contour. And turns a solid model into a single walled print with solid bottom layers. The final generated model has no seam.", "", "simple", "", "", "", ""},
    {"spiral_mode_max_xy_smoothing", "coFloatOrPercent", "Max XY Smoothing", "", "mm or %", "Maximum distance to move points in XY to try to achieve a smooth spiral. If expressed as a %, it will be computed over nozzle diameter.", "", "advanced", "", "", "0", "1000"},
    {"spiral_mode_smooth", "coBool", "Smooth Spiral", "", "", "Smooth Spiral smooths out X and Y moves as well, resulting in no visible seam at all, even in the XY directions on walls that are not vertical.", "", "simple", "", "", "", ""},
    {"spiral_starting_flow_ratio", "coFloat", "Spiral starting flow ratio", "", "", "Sets the starting flow ratio while transitioning from the last bottom layer to the spiral. Normally the spiral transition scales the flow ratio from 0% to 100% during the first loop which can in some cases lead to under extrusion at the start of the spiral.", "", "advanced", "", "", "0", "1"},
    {"staggered_inner_seams", "coBool", "Staggered inner seams", "", "", "This option causes the inner seams to be shifted backwards based on their depth, forming a zigzag pattern.", "Quality", "advanced", "", "", "", ""},
    {"standby_temperature_delta", "coInt", "Temperature variation", "", "∆°C", "Temperature difference to be applied when an extruder is not active. The value is not used when 'idle_temperature' in filament settings is set to non-zero value.", "", "advanced", "", "", "", ""},
    {"start_end_points", "coPoints", "Start end points", "", "", "The start and end points which is from cutter area to garbage can.", "", "develop", "", "", "", ""},
    {"supertack_plate_temp", "coInts", "Other layers", "Bed temperature", "°C", "Bed temperature for layers except the initial one. A value of 0 means the filament does not support printing on the Cool Plate SuperTack.", "", "simple", "", "", "0", "120"},
    {"supertack_plate_temp_initial_layer", "coInts", "First layer", "First layer bed temperature", "°C", "Bed temperature of the first layer. A value of 0 means the filament does not support printing on the Cool Plate SuperTack.", "", "simple", "", "", "0", "120"},
    {"support_air_filtration", "coBool", "Support air filtration", "", "", "Enable this if printer support air filtration\nG-code command: M106 P3 S(0-255)", "", "develop", "", "", "", ""},
    {"support_angle", "coFloat", "Pattern angle", "", "°", "Use this setting to rotate the support pattern on the horizontal plane.", "Support", "advanced", "", "", "0", "359"},
    {"support_base_pattern", "coEnum", "Base pattern", "", "", "Line pattern of support.\n\nThe Default option for Tree supports is Hollow, which means no base pattern. For other support types, the Default option is the Rectilinear pattern.\n\nNOTE: For Organic supports, the two walls are supported only with the Hollow/Default base pattern. The Lightning base pattern is supported only by Tree Slim/Strong/Hybrid supports. For the other support types, the Rectilinear will be used instead of Lightning.", "Support", "advanced", "default\nrectilinear\nrectilinear-grid\nhoneycomb\nlightning\nhollow", "Default\nRectilinear\nRectilinear grid\nHoneycomb\nLightning\nHollow", "", ""},
    {"support_base_pattern_spacing", "coFloat", "Base pattern spacing", "", "mm", "Spacing between support lines.", "Support", "advanced", "", "", "0", ""},
    {"support_bottom_interface_spacing", "coFloat", "Bottom interface spacing", "", "mm", "Spacing of bottom interface lines. Zero means solid interface.", "Support", "advanced", "", "", "0", ""},
    {"support_bottom_z_distance", "coFloat", "Bottom Z distance", "", "mm", "Z gap between the object and the support bottom. If Support Top Z Distance is 0 and the bottom has interface layers, this value is ignored and the support is printed in direct contact with the object (no gap).", "Support", "advanced", "", "", "0", ""},
    {"support_chamber_temp_control", "coBool", "Support control chamber temperature", "", "", "This option is enabled if machine support controlling chamber temperature\nG-code command: M141 S(0-255)", "", "advanced", "", "", "", ""},
    {"support_critical_regions_only", "coBool", "Support critical regions only", "", "", "Only create support for critical regions including sharp tail, cantilever, etc.", "Support", "advanced", "", "", "", ""},
    {"support_expansion", "coFloat", "Normal Support expansion", "", "mm", "Expand (+) or shrink (-) the horizontal span of normal support.", "Support", "advanced", "", "", "", ""},
    {"support_filament", "coInt", "Support/raft base", "", "", "Filament to print support base and raft.\n\"Default\" means no specific filament for support and current filament is used.", "Support", "simple", "", "", "0", ""},
    {"support_flow_ratio", "coFloat", "Support flow ratio", "", "", "This factor affects the amount of material for support.\n\nThe actual support flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"support_interface_bottom_layers", "coInt", "Bottom interface layers", "", "layers", "Number of bottom interface layers.", "Support", "advanced", "-1", "Same as top", "-1", ""},
    {"support_interface_filament", "coInt", "Support/raft interface", "", "", "Filament to print support interface.\n\"Default\" means no specific filament for support interface and current filament is used.", "Support", "simple", "", "", "0", ""},
    {"support_interface_flow_ratio", "coFloat", "Support interface flow ratio", "", "", "This factor affects the amount of material for the support interface.\n\nThe actual support interface flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"support_interface_loop_pattern", "coBool", "Interface use loop pattern", "", "", "Cover the top contact layer of the supports with loops. Disabled by default.", "Support", "advanced", "", "", "", ""},
    {"support_interface_not_for_body", "coBool", "Avoid interface filament for base", "", "", "Avoid using support interface filament to print support base if possible.", "Support", "simple", "", "", "", ""},
    {"support_interface_pattern", "coEnum", "Interface pattern", "", "", "Line pattern of support interface. Default pattern for non-soluble support interface is Rectilinear, while default pattern for soluble support interface is Concentric.", "Support", "advanced", "auto\nrectilinear\nconcentric\nrectilinear_interlaced\ngrid", "Default\nRectilinear\nConcentric\nRectilinear Interlaced\nGrid", "", ""},
    {"support_interface_spacing", "coFloat", "Top interface spacing", "", "mm", "Spacing of interface lines. Zero means solid interface.\nForce using solid interface when support ironing is enabled.", "Support", "advanced", "", "", "0", ""},
    {"support_interface_speed", "coFloat", "Support interface", "", "mm/s", "Speed of support interface.", "Speed", "advanced", "", "", "1", ""},
    {"support_interface_top_layers", "coInt", "Top interface layers", "", "layers", "Number of top interface layers.", "Support", "advanced", "0\n1\n2\n3", "0\n1\n2\n3", "0", ""},
    {"support_ironing", "coBool", "Ironing Support Interface", "", "", "Ironing is using small flow to print on same height of support interface again to make it more smooth. This setting controls whether support interface being ironed. When enabled, support interface will be extruded as solid too.", "Support", "advanced", "", "", "", ""},
    {"support_ironing_flow", "coPercent", "Support Ironing flow", "", "%", "The amount of material to extrude during ironing. Relative to flow of normal support interface layer height. Too high value results in overextrusion on the surface.", "Support", "advanced", "", "", "0", "100"},
    {"support_ironing_pattern", "coEnum", "Support Ironing Pattern", "", "", "The pattern that will be used when ironing.", "Support", "advanced", "rectilinear\nconcentric", "Rectilinear\nConcentric", "", ""},
    {"support_ironing_spacing", "coFloat", "Support Ironing line spacing", "", "mm", "The distance between the lines of ironing.", "Support", "advanced", "", "", "0", "1"},
    {"support_line_width", "coFloatOrPercent", "Support", "", "mm or %", "Line width of support. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"support_material_interface_fan_speed", "coInts", "Support interface fan speed", "", "%", "This part cooling fan speed is applied when printing support interfaces. Setting this parameter to a higher than regular speed reduces the layer binding strength between supports and the supported part, making them easier to separate.\nSet to -1 to disable it.\nThis setting is overridden by disable_fan_first_layers.", "", "advanced", "", "", "-1", "100"},
    {"support_multi_bed_types", "coBool", "Support multi bed types", "", "", "Enable this option if you want to use multiple bed types.", "", "simple", "", "", "", ""},
    {"support_object_first_layer_gap", "coFloat", "Support/object first layer gap", "", "mm", "XY separation between an object and its support at the first layer.", "Support", "advanced", "", "", "0", "10"},
    {"support_object_skip_flush", "coBool", "", "", "", "", "", "simple", "", "", "", ""},
    {"support_object_xy_distance", "coFloat", "Support/object XY distance", "", "mm", "XY separation between an object and its support.", "Support", "advanced", "", "", "0", "10"},
    {"support_on_build_plate_only", "coBool", "On build plate only", "", "", "Don't create support on model surface, only on build plate.", "Support", "simple", "", "", "", ""},
    {"support_parallel_printheads", "coBool", "Support parallel printheads", "", "", "Enable printer settings for machines that can use multiple printheads in parallel.", "", "advanced", "", "", "", ""},
    {"support_remove_small_overhang", "coBool", "Ignore small overhangs", "", "", "Ignore small overhangs that possibly don't require support.", "Support", "advanced", "", "", "", ""},
    {"support_speed", "coFloat", "Support", "", "mm/s", "Speed of support.", "Speed", "advanced", "", "", "1", ""},
    {"support_style", "coEnum", "Style", "", "", "Style and shape of the support. For normal support, projecting the supports into a regular grid will create more stable supports (default), while snug support towers will save material and reduce object scarring.\nFor tree support, slim and organic style will merge branches more aggressively and save a lot of material (default organic), while hybrid style will create similar structure to normal support under large flat overhangs.", "Support", "advanced", "default\ngrid\nsnug\norganic\ntree_slim\ntree_strong\ntree_hybrid", "Default (Grid/Organic)\nGrid\nSnug\nOrganic\nTree Slim\nTree Strong\nTree Hybrid", "", ""},
    {"support_threshold_angle", "coInt", "Threshold angle", "", "°", "Support will be generated for overhangs whose slope angle is below the threshold. The smaller this value is, the steeper the overhang that can be printed without support.\nNote: If set to 0, normal supports use the Threshold overlap instead, while tree supports fall back to a default value of 30.", "Support", "simple", "", "", "0", "90"},
    {"support_threshold_overlap", "coFloatOrPercent", "Threshold overlap", "", "mm or %", "If threshold angle is zero, support will be generated for overhangs whose overlap is below the threshold. The smaller this value is, the steeper the overhang that can be printed without support.", "Support", "simple", "", "", "0", "100"},
    {"support_top_z_distance", "coFloat", "Top Z distance", "", "mm", "Z gap between the support's top and object.", "Support", "advanced", "0\n0.1\n0.2", "0 (soluble)\n0.1 (semi-detachable)\n0.2 (detachable)", "0", ""},
    {"support_type", "coEnum", "Type", "", "", "Normal (auto) and Tree (auto) are used to generate support automatically. If Normal (manual) or Tree (manual) is selected, only support enforcers are generated.", "Support", "simple", "normal(auto)\ntree(auto)\nnormal(manual)\ntree(manual)", "Normal (auto)\nTree (auto)\nNormal (manual)\nTree (manual)", "", ""},
    {"symmetric_infill_y_axis", "coBool", "Symmetric infill Y axis", "", "", "If the model has two parts that are symmetric about the Y axis, and you want these parts to have symmetric textures, please click this option on one of the parts.", "Strength", "advanced", "", "", "", ""},
    {"temperature_vitrification", "coInts", "Softening temperature", "", "°C", "The material softens at this temperature, so when the bed temperature is equal to or greater than this, it's highly recommended to open the front door and/or remove the upper glass to avoid clogging.", "", "simple", "", "", "", ""},
    {"template_custom_gcode", "coString", "Custom G-code", "", "", "This G-code will be used as a custom code.", "", "advanced", "", "", "", ""},
    {"textured_cool_plate_temp", "coInts", "Other layers", "Bed temperature", "°C", "Bed temperature for layers except the initial one. A value of 0 means the filament does not support printing on the Textured Cool Plate.", "", "simple", "", "", "0", "300"},
    {"textured_cool_plate_temp_initial_layer", "coInts", "First layer", "First layer bed temperature", "°C", "Bed temperature of the first layer. A value of 0 means the filament does not support printing on the Textured Cool Plate.", "", "simple", "", "", "0", "120"},
    {"textured_plate_temp", "coInts", "Other layers", "Bed temperature", "°C", "Bed temperature for layers except the initial one. A value of 0 means the filament does not support printing on the Textured PEI Plate.", "", "simple", "", "", "0", "300"},
    {"textured_plate_temp_initial_layer", "coInts", "First layer", "First layer bed temperature", "°C", "Bed temperature of the first layer. A value of 0 means the filament does not support printing on the Textured PEI Plate.", "", "simple", "", "", "0", "300"},
    {"thick_bridges", "coBool", "Thick external bridges", "", "", "If enabled, bridge extrusion uses a line height equal to the nozzle diameter.\nThis increases bridge strength and reliability, allowing longer spans, but may worsen appearance.\nIf disabled, bridges may look better but are generally reliable only for shorter spans.", "Quality", "advanced", "", "", "", ""},
    {"thick_internal_bridges", "coBool", "Thick internal bridges", "", "", "If enabled, internal bridge extrusion uses a line height equal to the nozzle diameter.\nThis increases internal bridge strength and reliability when printed over sparse infill, but may worsen appearance.\nIf disabled, internal bridges may look better but can be less reliable over sparse infill.", "Quality", "advanced", "", "", "", ""},
    {"thumbnails", "coString", "G-code thumbnails", "", "", "Picture sizes to be stored into a .gcode and .sl1 / .sl1s files, in the following format: \"XxY, XxY, ...\"", "", "advanced", "", "", "", ""},
    {"thumbnails_format", "coEnum", "Format of G-code thumbnails", "", "", "Format of G-code thumbnails: PNG for best quality, JPG for smallest size, QOI for low memory firmware.", "", "advanced", "PNG\nJPG\nQOI\nBTT_TFT\nCOLPIC", "PNG\nJPG\nQOI\nBTT TT\nColPic", "", ""},
    {"time_cost", "coFloat", "Time cost", "", "money/h", "The printer cost per hour.", "", "advanced", "", "", "0", ""},
    {"time_lapse_gcode", "coString", "Timelapse G-code", "", "", "", "", "advanced", "", "", "", ""},
    {"timelapse_type", "coEnum", "Timelapse", "", "", "If smooth or traditional mode is selected, a timelapse video will be generated for each print. After each layer is printed, a snapshot is taken with the chamber camera. All of these snapshots are composed into a timelapse video when printing completes. If smooth mode is selected, the toolhead will move to the excess chute after each layer is printed and then take a snapshot. Since the melt filament may leak from the nozzle during the process of taking a snapshot, a prime tower is required for smooth mode to wipe nozzle.", "", "simple", "0\n1", "Traditional\nSmooth", "", ""},
    {"tool_change_on_wipe_tower", "coBool", "Tool change on wipe tower", "", "", "Force the toolhead to travel to the wipe tower before issuing the tool change command (Tx). Only relevant for multi-extruder (multi-toolhead) printers using a Type 2 wipe tower. By default Orca skips the travel on multi-toolhead machines because the firmware handles the head swap, which can result in the Tx command being issued above the printed part. Enable this option if you want the tool change to always be issued above the wipe tower instead.", "", "advanced", "", "", "", ""},
    {"top_bottom_infill_wall_overlap", "coPercent", "Top/Bottom solid infill/wall overlap", "", "%", "Top solid infill area is enlarged slightly to overlap with wall for better bonding and to minimize the appearance of pinholes where the top infill meets the walls. A value of 25-30% is a good starting point, minimizing the appearance of pinholes. The percentage value is relative to line width of sparse infill.", "Strength", "advanced", "", "", "", ""},
    {"top_shell_layers", "coInt", "Top shell layers", "Top solid layers", "layers", "This is the number of solid layers of top shell, including the top surface layer. When the thickness calculated by this value is thinner than top shell thickness, the top shell layers will be increased.", "Strength", "simple", "", "", "0", ""},
    {"top_shell_thickness", "coFloat", "Top shell thickness", "Top shell thickness", "mm", "The number of top solid layers is increased when slicing if the thickness calculated by top shell layers is thinner than this value. This can avoid having too thin shell when layer height is small. 0 means that this setting is disabled and thickness of top shell is absolutely determined by top shell layers.", "Strength", "simple", "", "", "0", ""},
    {"top_solid_infill_flow_ratio", "coFloat", "Top surface flow ratio", "", "", "This factor affects the amount of material for top solid infill. You can decrease it slightly to have smooth surface finish.\n\nThe actual top surface flow used is calculated by multiplying this value with the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"top_surface_acceleration", "coFloat", "Top surface", "", "mm/s²", "Acceleration of top surface infill. Using a lower value may improve top surface quality.", "Speed", "advanced", "", "", "0", ""},
    {"top_surface_density", "coPercent", "Top surface density", "", "%", "Density of top surface layer. A value of 100% creates a fully solid, smooth top layer. Reducing this value results in a textured top surface, according to the chosen top surface pattern. A value of 0% will result in only the walls on the top layer being created. Intended for aesthetic or functional purposes, not to fix issues such as over-extrusion.", "Strength", "simple", "", "", "0", "100"},
    {"top_surface_filament_id", "coInt", "Top surface", "", "", "Filament to print top surface.\n\"Default\" uses the active object/part filament.", "Extruders", "advanced", "", "", "0", ""},
    {"top_surface_jerk", "coFloat", "Top surface", "", "mm/s", "Jerk for top surface.", "Speed", "advanced", "", "", "0", ""},
    {"top_surface_line_width", "coFloatOrPercent", "Top surface", "", "mm or %", "Line width for top surfaces. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"top_surface_pattern", "coEnum", "Top surface pattern", "", "", "Line pattern of top surface infill.", "Strength", "simple", "monotonic\nmonotonicline\nrectilinear\nalignedrectilinear\nconcentric\nhilbertcurve\narchimedeanchords\noctagramspiral", "Monotonic\nMonotonic line\nRectilinear\nAligned Rectilinear\nConcentric\nHilbert Curve\nArchimedean Chords\nOctagram Spiral", "", ""},
    {"top_surface_speed", "coFloat", "Top surface", "", "mm/s", "Speed of top surface infill which is solid.", "Speed", "advanced", "", "", "1", ""},
    {"travel_acceleration", "coFloat", "Travel", "", "mm/s²", "Acceleration of travel moves.", "Speed", "advanced", "", "", "0", ""},
    {"travel_jerk", "coFloat", "Travel", "", "mm/s", "Jerk for travel.", "Speed", "advanced", "", "", "0", ""},
    {"travel_slope", "coFloats", "Traveling angle", "", "°", "Traveling angle for Slope and Spiral Z-hop type. Setting it to 90° results in Normal Lift.", "", "advanced", "", "", "1", "90"},
    {"travel_speed", "coFloat", "Travel", "", "mm/s", "Speed of travel which is faster and without extrusion.", "", "advanced", "", "", "1", ""},
    {"travel_speed_z", "coFloat", "Z travel", "", "mm/s", "Speed of vertical travel along z axis. This is typically lower because build plate or gantry is hard to be moved. Zero means using travel speed directly in G-code, but will be limited by printer's ability when run G-code.", "", "develop", "", "", "0", ""},
    {"tree_support_angle_slow", "coFloat", "Preferred Branch Angle", "", "°", "The preferred angle of the branches, when they do not have to avoid the model. Use a lower angle to make them more vertical and more stable. Use a higher angle for branches to merge faster.", "Support", "advanced", "", "", "10", "85"},
    {"tree_support_auto_brim", "coBool", "Auto brim width", "", "", "Enabling this option means the width of the brim for tree support will be automatically calculated.", "Quality", "simple", "", "", "", ""},
    {"tree_support_branch_angle", "coFloat", "Tree support branch angle", "", "°", "This setting determines the maximum overhang angle that the branches of tree support are allowed to make. If the angle is increased, the branches can be printed more horizontally, allowing them to reach farther.", "Support", "advanced", "", "", "0", "60"},
    {"tree_support_branch_angle_organic", "coFloat", "Tree support branch angle", "", "°", "This setting determines the maximum overhang angle that the branches of tree support are allowed to make. If the angle is increased, the branches can be printed more horizontally, allowing them to reach farther.", "Support", "advanced", "", "", "0", "60"},
    {"tree_support_branch_diameter", "coFloat", "Tree support branch diameter", "", "mm", "This setting determines the initial diameter of support nodes.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_branch_diameter_angle", "coFloat", "Branch Diameter Angle", "", "°", "The angle of the branches' diameter as they gradually become thicker towards the bottom. An angle of 0 will cause the branches to have uniform thickness over their length. A bit of an angle can increase stability of the organic support.", "Support", "advanced", "", "", "0", "15"},
    {"tree_support_branch_diameter_organic", "coFloat", "Tree support branch diameter", "", "mm", "This setting determines the initial diameter of support nodes.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_branch_distance", "coFloat", "Tree support branch distance", "", "mm", "This setting determines the distance between neighboring tree support nodes.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_branch_distance_organic", "coFloat", "Tree support branch distance", "", "mm", "This setting determines the distance between neighboring tree support nodes.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_brim_width", "coFloat", "Tree support brim width", "", "", "Distance from tree branch to the outermost brim line.", "Quality", "simple", "", "", "0.0", ""},
    {"tree_support_tip_diameter", "coFloat", "Tip Diameter", "", "mm", "Branch tip diameter for organic supports.", "Support", "advanced", "", "", "", ""},
    {"tree_support_top_rate", "coPercent", "Branch Density", "", "%", "Adjusts the density of the support structure used to generate the tips of the branches. A higher value results in better overhangs but the supports are harder to remove, thus it is recommended to enable top support interfaces instead of a high branch density value if dense interfaces are needed.", "Support", "advanced", "", "", "5", ""},
    {"tree_support_wall_count", "coInt", "Support wall loops", "", "", "This setting specifies the count of support walls in the range of [0,2]. 0 means auto.", "Support", "advanced", "", "", "0", "2"},
    {"tree_support_with_infill", "coBool", "Tree support with infill", "", "", "This setting specifies whether to add infill inside large hollows of tree support.", "Support", "advanced", "", "", "", ""},
    {"upward_compatible_machine", "coStrings", "upward compatible machine", "", "", "", "", "advanced", "", "", "", ""},
    {"use_3mf", "coBool", "Use 3MF instead of G-code", "", "", "Enable this if the printer accepts a 3MF file as the print job. When enabled, Orca Slicer sends the sliced file as a .gcode.3mf, instead of a plain .gcode file.", "", "advanced", "", "", "", ""},
    {"use_firmware_retraction", "coBool", "Use firmware retraction", "", "", "This experimental setting uses G10 and G11 commands to have the firmware handle the retraction. This is only supported in recent Marlin.", "", "advanced", "", "", "", ""},
    {"use_relative_e_distances", "coBool", "Use relative E distances", "", "", "Relative extrusion is recommended when using \"label_objects\" option. Some extruders work better with this option unchecked (absolute extrusion mode). Wipe tower is only compatible with relative mode. It is recommended on most printers. Default is checked.", "", "advanced", "", "", "", ""},
    {"volumetric_speed_coefficients", "coStrings", "Max volumetric speed multinomial coefficients", "", "", "", "", "simple", "", "", "", ""},
    {"wall_direction", "coEnum", "Wall loop direction", "", "", "The direction which the contour wall loops are extruded when looking down from the top.\nHoles are printed in the opposite direction to the contour to maintain alignment with layers whose contour polygons are incomplete and change direction, also partially forming the contour of a hole.\n\nThis option will be disabled if spiral vase mode is enabled.", "Quality", "advanced", "ccw\ncw", "Counter clockwise\nClockwise", "", ""},
    {"wall_distribution_count", "coInt", "Wall distribution count", "", "", "The number of walls, counted from the center, over which the variation needs to be spread. Lower values mean that the outer walls don't change in width.", "Quality", "advanced", "", "", "1", ""},
    {"wall_generator", "coEnum", "Wall generator", "", "", "Classic wall generator produces walls with constant extrusion width and for very thin areas is used gap-fill. Arachne engine produces walls with variable extrusion width.", "Quality", "advanced", "classic\narachne", "Classic\nArachne", "", ""},
    {"wall_loops", "coInt", "Wall loops", "", "", "Number of walls of every layer.", "Strength", "simple", "", "", "0", "1000"},
    {"wall_maximum_deviation", "coFloat", "Maximum wall deviation", "", "mm", "The maximum deviation allowed when reducing the resolution for the 'Maximum wall resolution' setting. If you increase this, the print will be less accurate, but the G-Code will be smaller. 'Maximum wall deviation' limits 'Maximum wall resolution', so if the two conflict, 'Maximum wall deviation' takes precedence.", "Quality", "simple", "", "", "", ""},
    {"wall_maximum_resolution", "coFloat", "Maximum wall resolution", "", "mm", "This value determines the smallest wall line segment length in mm. The smaller you set this value, the more accurate and precise the walls will be.", "Quality", "simple", "", "", "0.005", ""},
    {"wall_sequence", "coEnum", "Walls printing order", "", "", "Print sequence of the internal (inner) and external (outer) walls.\n\nUse Inner/Outer for best overhangs. This is because the overhanging walls can adhere to a neighbouring perimeter while printing. However, this option results in slightly reduced surface quality as the external perimeter is deformed by being squashed to the internal perimeter.\n\nUse Inner/Outer/Inner for the best external surface finish and dimensional accuracy as the external wall is printed undisturbed from an internal perimeter. However, overhang performance will reduce as there is no internal perimeter to print the external wall against. This option requires a minimum of 3 walls to be effective as it prints the internal walls from the 3rd perimeter onwards first, then the external perimeter and, finally, the first internal perimeter. This option is recommended against the Outer/Inner option in most cases.\n\nUse Outer/Inner for the same external wall quality and dimensional accuracy benefits of Inner/Outer/Inner option. However, the Z seams will appear less consistent as the first extrusion of a new layer starts on a visible surface.", "Quality", "advanced", "inner wall/outer wall\nouter wall/inner wall\ninner-outer-inner wall", "Inner/Outer\nOuter/Inner\nInner/Outer/Inner", "", ""},
    {"wall_transition_angle", "coFloat", "Wall transitioning threshold angle", "", "°", "When to create transitions between even and odd numbers of walls. A wedge shape with an angle greater than this setting will not have transitions and no walls will be printed in the center to fill the remaining space. Reducing this setting reduces the number and length of these center walls, but may leave gaps or overextrude.", "Quality", "advanced", "", "", "1.", "59."},
    {"wall_transition_filter_deviation", "coPercent", "Wall transitioning filter margin", "", "%", "Prevent transitioning back and forth between one extra wall and one less. This margin extends the range of extrusion widths which follow to [Minimum wall width - margin, 2 * Minimum wall width + margin]. Increasing this margin reduces the number of transitions, which reduces the number of extrusion starts/stops and travel time. However, large extrusion width variation can lead to under- or overextrusion problems. It's expressed as a percentage over nozzle diameter.", "Quality", "advanced", "", "", "0", ""},
    {"wall_transition_length", "coPercent", "Wall transition length", "", "%", "When transitioning between different numbers of walls as the part becomes thinner, a certain amount of space is allotted to split or join the wall segments. It's expressed as a percentage over nozzle diameter.", "Quality", "advanced", "", "", "0", ""},
    {"wipe", "coBools", "Wipe while retracting", "", "", "Move nozzle along the last extrusion path when retracting to clean any leaked material on the nozzle. This can minimize blobs when printing a new part after traveling.", "", "advanced", "", "", "", ""},
    {"wipe_before_external_loop", "coBool", "Wipe before external loop", "", "", "To minimize visibility of potential overextrusion at the start of an external perimeter when printing with Outer/Inner or Inner/Outer/Inner wall print order, the de-retraction is performed slightly on the inside from the start of the external perimeter. That way any potential over extrusion is hidden from the outside surface.\n\nThis is useful when printing with Outer/Inner or Inner/Outer/Inner wall print order as in these modes it is more likely an external perimeter is printed immediately after a de-retraction move.", "Quality", "advanced", "", "", "", ""},
    {"wipe_distance", "coFloats", "Wipe Distance", "", "mm", "Describe how long the nozzle will move along the last path when retracting.\n\nDepending on how long the wipe operation lasts, how fast and long the extruder/filament retraction settings are, a retraction move may be needed to retract the remaining filament.\n\nSetting a value in the retract amount before wipe setting below will perform any excess retraction before the wipe, else it will be performed after.", "", "advanced", "", "", "0", ""},
    {"wipe_on_loops", "coBool", "Wipe on loops", "", "", "To minimize the visibility of the seam in a closed loop extrusion, a small inward movement is executed before the extruder leaves the loop.", "Quality", "advanced", "", "", "", ""},
    {"wipe_speed", "coFloatOrPercent", "Wipe speed", "", "mm/s or %", "The wipe speed is determined by the speed setting specified in this configuration. If the value is expressed as a percentage (e.g. 80%), it will be calculated based on the travel speed setting above. The default value for this parameter is 80%.", "Speed", "advanced", "", "", "0", ""},
    {"wipe_tower_bridging", "coFloat", "Maximal bridging distance", "", "mm", "Maximal distance between supports on sparse infill sections.", "", "advanced", "", "", "", ""},
    {"wipe_tower_cone_angle", "coFloat", "Stabilization cone apex angle", "", "°", "Angle at the apex of the cone that is used to stabilize the wipe tower. Larger angle means wider base.", "", "advanced", "", "", "0.", "90."},
    {"wipe_tower_extra_flow", "coPercent", "Extra flow for purging", "", "%", "Extra flow used for the purging lines on the wipe tower. This makes the purging lines thicker or narrower than they normally would be. The spacing is adjusted automatically.", "", "advanced", "", "", "100.", "300."},
    {"wipe_tower_extra_rib_length", "coFloat", "Extra rib length", "", "mm", "Positive values can increase the size of the rib wall, while negative values can reduce the size. However, the size of the rib wall can not be smaller than that determined by the cleaning volume.", "", "advanced", "", "", "", "300"},
    {"wipe_tower_extra_spacing", "coPercent", "Wipe tower purge lines spacing", "", "%", "Spacing of purge lines on the wipe tower.", "", "advanced", "", "", "100.", "300."},
    {"wipe_tower_filament", "coInt", "Wipe tower", "", "", "The extruder to use when printing perimeter of the wipe tower. Set to 0 to use the one that is available (non-soluble would be preferred).", "Extruders", "advanced", "", "", "0", ""},
    {"wipe_tower_fillet_wall", "coBool", "Fillet wall", "", "", "The wall of prime tower will fillet.", "", "advanced", "", "", "", ""},
    {"wipe_tower_max_purge_speed", "coFloat", "Maximum wipe tower print speed", "", "mm/s", "The maximum print speed when purging in the wipe tower and printing the wipe tower sparse layers. When purging, if the sparse infill speed or calculated speed from the filament max volumetric speed is lower, the lowest will be used instead.\n\nWhen printing the sparse layers, if the internal perimeter speed or calculated speed from the filament max volumetric speed is lower, the lowest will be used instead.\n\nIncreasing this speed may affect the tower's stability as well as increase the force with which the nozzle collides with any blobs that may have formed on the wipe tower.\n\nBefore increasing this parameter beyond the default of 90 mm/s, make sure your printer can reliably bridge at the increased speeds and that ooze when tool changing is well controlled.\n\nFor the wipe tower external perimeters the internal perimeter speed is used regardless of this setting.", "", "advanced", "", "", "10", ""},
    {"wipe_tower_no_sparse_layers", "coBool", "No sparse layers (beta)", "", "", "If enabled, the wipe tower will not be printed on layers with no tool changes. On layers with a tool change, extruder will travel downward to print the wipe tower. User is responsible for ensuring there is no collision with the print.", "", "advanced", "", "", "", ""},
    {"wipe_tower_rib_width", "coFloat", "Rib width", "", "mm", "Rib width is always less than half the prime tower side length.", "", "advanced", "", "", "0", "300"},
    {"wipe_tower_rotation_angle", "coFloat", "Wipe tower rotation angle", "", "°", "Wipe tower rotation angle with respect to X axis.", "", "advanced", "", "", "", ""},
    {"wipe_tower_type", "coEnum", "Wipe tower type", "", "", "Choose the wipe tower implementation for multi-material prints. Type 1 is recommended for Bambu and Qidi printers with a filament cutter. Type 2 offers better compatibility with multi-tool and MMU printers and provide overall better compatibility.", "", "advanced", "type1\ntype2", "Type 1\nType 2", "", ""},
    {"wipe_tower_wall_type", "coEnum", "Wall type", "", "", "Wipe tower outer wall type.\n1. Rectangle: The default wall type, a rectangle with fixed width and height.\n2. Cone: A cone with a fillet at the bottom to help stabilize the wipe tower.\n3. Rib: Adds four ribs to the tower wall for enhanced stability.", "", "advanced", "rectangle\ncone\nrib", "Rectangle\nCone\nRib", "", ""},
    {"wipe_tower_x", "coFloats", "Position X", "", "mm", "X coordinate of the left front corner of a wipe tower.", "", "develop", "", "", "", ""},
    {"wipe_tower_y", "coFloats", "Position Y", "", "mm", "Y coordinate of the left front corner of a wipe tower.", "", "develop", "", "", "", ""},
    {"wiping_volumes_extruders", "coFloats", "Purging volumes - load/unload volumes", "", "", "This vector saves required volumes to change from/to each tool used on the wipe tower. These values are used to simplify creation of the full purging volumes below.", "", "simple", "", "", "", ""},
    {"wrapping_detection_gcode", "coString", "Clumping detection G-code", "", "", "", "", "advanced", "", "", "", ""},
