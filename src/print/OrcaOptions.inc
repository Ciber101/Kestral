    {"textured_cool_plate_temp_initial_layer", "coInts", "First layer", "First layer bed temperature", "°C", "Bed temperature on the Textured Cool Plate for the first layer. 0 means this filament should not be printed on it.", "", "simple", "", "", "0", "120"},
