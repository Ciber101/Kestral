    {"support_ironing_spacing", "coFloat", "Support Ironing line spacing", "", "mm", "Distance between support ironing lines.", "Support", "advanced", "", "", "0", "1"},
    {"support_line_width", "coFloatOrPercent", "Support", "", "mm or %", "Line width of support. A percentage is taken from the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"support_material_interface_fan_speed", "coInts", "Support interface fan speed", "", "%", "Part cooling fan speed for support interfaces. More fan than usual weakens the bond between support and part, so the support comes off more easily. -1 keeps the normal fan speed.", "", "advanced", "", "", "-1", "100"},
    {"support_multi_bed_types", "coBool", "Support multi bed types", "", "", "The printer can use several kinds of build plate.", "", "simple", "", "", "", ""},
    {"support_object_first_layer_gap", "coFloat", "Support/object first layer gap", "", "mm", "Sideways gap between the part and its support on the first layer.", "Support", "advanced", "", "", "0", "10"},
