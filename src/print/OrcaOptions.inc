    {"upward_compatible_machine", "coStrings", "upward compatible machine", "", "", "", "", "advanced", "", "", "", ""},
    {"use_3mf", "coBool", "Use 3MF instead of G-code", "", "", "Send the print to the printer as a .gcode.3mf file instead of plain G-code, for printers that take 3MF jobs.", "", "advanced", "", "", "", ""},
    {"use_firmware_retraction", "coBool", "Use firmware retraction", "", "", "Let the firmware do retractions with G10 and G11 commands. Only recent Marlin supports it. Experimental.", "", "advanced", "", "", "", ""},
    {"use_relative_e_distances", "coBool", "Use relative E distances", "", "", "Write extrusion as relative amounts. Recommended for most printers, needed for the wipe tower, and best with object labels. A few printers work better with absolute amounts.", "", "advanced", "", "", "", ""},
    {"volumetric_speed_coefficients", "coStrings", "Max volumetric speed multinomial coefficients", "", "", "", "", "simple", "", "", "", ""},
    {"wall_direction", "coEnum", "Wall loop direction", "", "", "Direction the outer wall loops run, seen from above. Holes run the other way so they stay in line with layers where the outline changes.", "Quality", "advanced", "ccw\ncw", "Counter clockwise\nClockwise", "", ""},
    {"wall_distribution_count", "coInt", "Wall distribution count", "", "", "Over how many walls (counting from the middle) width changes are spread. Lower values keep the outer walls at their normal width.", "Quality", "advanced", "", "", "1", ""},
    {"wall_generator", "coEnum", "Wall generator", "", "", "Classic makes walls of fixed width and fills thin spots with gap fill. Arachne varies the wall width to fit the shape.", "Quality", "advanced", "classic\narachne", "Classic\nArachne", "", ""},
    {"wall_loops", "coInt", "Wall loops", "", "", "Number of walls on every layer.", "Strength", "simple", "", "", "0", "1000"},
    {"wall_maximum_deviation", "coFloat", "Maximum wall deviation", "", "mm", "How far a simplified wall may stray from the true outline when short segments are merged. Larger gives smaller G-code but less accuracy, and it limits the maximum wall resolution.", "Quality", "simple", "", "", "", ""},
    {"wall_maximum_resolution", "coFloat", "Maximum wall resolution", "", "mm", "Shortest wall segment kept. Smaller values give more precise walls.", "Quality", "simple", "", "", "0.005", ""},
    {"wall_sequence", "coEnum", "Walls printing order", "", "", "Order of the walls. Inner then outer gives the best overhangs, because the outer wall leans on the inner one, but the outer surface is slightly less accurate. Outer then inner gives the most accurate outside. Inner, outer, inner gives both a clean outside and good overhangs, and needs at least three walls.", "Quality", "advanced", "inner wall/outer wall\nouter wall/inner wall\ninner-outer-inner wall", "Inner/Outer\nOuter/Inner\nInner/Outer/Inner", "", ""},
    {"wall_transition_angle", "coFloat", "Wall transitioning threshold angle", "", "°", "When to switch between an even and odd number of walls in narrowing wedges. Wedges wider than this angle get no switch and no wall in the middle. Lower values mean fewer and shorter switches, which can leave small gaps.", "Quality", "advanced", "", "", "1.", "59."},
    {"wall_transition_filter_deviation", "coPercent", "Wall transitioning filter margin", "", "%", "Keeps the wall count from flipping back and forth between one more and one less wall. A larger margin flips less often but allows more variation in width.", "Quality", "advanced", "", "", "0", ""},
    {"wall_transition_length", "coPercent", "Wall transition length", "", "%", "Space used to split or join walls where the wall count changes as the part gets thinner. Percentage of the nozzle diameter.", "Quality", "advanced", "", "", "0", ""},
    {"wipe", "coBools", "Wipe while retracting", "", "", "Move the nozzle back along the last line while retracting, to wipe off any plastic that leaked. Reduces blobs after travel.", "", "advanced", "", "", "", ""},
    {"wipe_before_external_loop", "coBool", "Wipe before external loop", "", "", "With the outer then inner or inner, outer, inner wall orders, start the outer wall a little inside the part so any blob from pushing the filament back is hidden.", "Quality", "advanced", "", "", "", ""},
    {"wipe_distance", "coFloats", "Wipe Distance", "", "mm", "How far the nozzle moves along the last line while wiping. Any retraction left over when the wipe ends is done in place.", "", "advanced", "", "", "0", ""},
    {"wipe_on_loops", "coBool", "Wipe on loops", "", "", "Move the nozzle a little inward before leaving a closed loop, which hides the seam.", "Quality", "advanced", "", "", "", ""},
    {"wipe_speed", "coFloatOrPercent", "Wipe speed", "", "mm/s or %", "Speed of wiping. A percentage is taken from the travel speed.", "Speed", "advanced", "", "", "0", ""},
    {"wipe_tower_bridging", "coFloat", "Maximal bridging distance", "", "mm", "Longest gap between supports in the tower's sparse layers.", "", "advanced", "", "", "", ""},
    {"wipe_tower_cone_angle", "coFloat", "Stabilization cone apex angle", "", "°", "Angle at the tip of the cone that steadies the tower. A larger angle gives a wider base.", "", "advanced", "", "", "0.", "90."},
    {"wipe_tower_extra_flow", "coPercent", "Extra flow for purging", "", "%", "Extra flow for the purge lines on the tower, making them thicker or thinner. Their spacing adjusts to match.", "", "advanced", "", "", "100.", "300."},
    {"wipe_tower_extra_rib_length", "coFloat", "Extra rib length", "", "mm", "Make the tower's rib walls longer (positive) or shorter (negative). They never get smaller than the purge volume needs.", "", "advanced", "", "", "", "300"},
    {"wipe_tower_extra_spacing", "coPercent", "Wipe tower purge lines spacing", "", "%", "Spacing of the purge lines on the tower.", "", "advanced", "", "", "100.", "300."},
    {"wipe_tower_filament", "coInt", "Wipe tower", "", "", "Which extruder prints the tower's outer wall. 0 uses whichever is loaded, preferring a non soluble one.", "Extruders", "advanced", "", "", "0", ""},
    {"wipe_tower_fillet_wall", "coBool", "Fillet wall", "", "", "Round the corners of the tower's wall.", "", "advanced", "", "", "", ""},
    {"wipe_tower_max_purge_speed", "coFloat", "Maximum wipe tower print speed", "", "mm/s", "Fastest speed for purging on the tower and for its sparse layers. The lower of this, the sparse infill speed and the speed allowed by the filament's max flow is used.", "", "advanced", "", "", "10", ""},
    {"wipe_tower_no_sparse_layers", "coBool", "No sparse layers (beta)", "", "", "Skip the tower on layers with no tool change; on layers with a change the nozzle goes down to print it. Make sure the head can't hit the print. Beta.", "", "advanced", "", "", "", ""},
    {"wipe_tower_rib_width", "coFloat", "Rib width", "", "mm", "Width of the tower's ribs, always less than half the tower's side.", "", "advanced", "", "", "0", "300"},
    {"wipe_tower_rotation_angle", "coFloat", "Wipe tower rotation angle", "", "°", "Rotation of the tower relative to the X axis.", "", "advanced", "", "", "", ""},
    {"wipe_tower_type", "coEnum", "Wipe tower type", "", "", "Which wipe tower is used. Type 1 suits Bambu and Qidi printers with a filament cutter. Type 2 works better with tool changers and MMU printers and is steadier overall.", "", "advanced", "type1\ntype2", "Type 1\nType 2", "", ""},
    {"wipe_tower_wall_type", "coEnum", "Wall type", "", "", "Shape of the tower's outer wall: a plain rectangle, a cone with a rounded foot for stability, or a wall with four ribs for strength.", "", "advanced", "rectangle\ncone\nrib", "Rectangle\nCone\nRib", "", ""},
    {"wipe_tower_x", "coFloats", "Position X", "", "mm", "X position of the tower's front left corner.", "", "develop", "", "", "", ""},
    {"wipe_tower_y", "coFloats", "Position Y", "", "mm", "Y position of the tower's front left corner.", "", "develop", "", "", "", ""},
    {"wiping_volumes_extruders", "coFloats", "Purging volumes - load/unload volumes", "", "", "Purge amounts when loading or unloading each extruder, used to fill in the full purge table more easily.", "", "simple", "", "", "", ""},
    {"wrapping_detection_gcode", "coString", "Clumping detection G-code", "", "", "", "", "advanced", "", "", "", ""},
    {"wrapping_detection_layers", "coInt", "Clumping detection layers", "", "", "Layers on which the printer checks for filament clumping.", "", "develop", "", "", "0", ""},
    {"wrapping_exclude_area", "coPoints", "Probing exclude area of clumping", "", "", "Area left out of the clumping check.", "", "advanced", "", "", "", ""},
    {"xy_contour_compensation", "coFloat", "X-Y contour compensation", "", "mm", "Make the outside of the part bigger (positive) or smaller (negative) by this much, to fine tune sizes for parts that fit together.", "Quality", "advanced", "", "", "", ""},
    {"xy_hole_compensation", "coFloat", "X-Y hole compensation", "", "mm", "Make holes bigger (positive) or smaller (negative) by this much, to fine tune sizes for parts that fit together.", "Quality", "advanced", "", "", "", ""},
