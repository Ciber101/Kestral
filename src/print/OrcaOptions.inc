    {"support_remove_small_overhang", "coBool", "Ignore small overhangs", "", "", "Skip support for small overhangs that will probably print fine without it.", "Support", "advanced", "", "", "", ""},
    {"support_speed", "coFloat", "Support", "", "mm/s", "Speed of support.", "Speed", "advanced", "", "", "1", ""},
    {"support_style", "coEnum", "Style", "", "", "Shape of the support. Normal support as a grid is sturdier; snug follows the part closely, uses less material and leaves fewer marks. For tree support, slim branches merge more and save material, strong branches stay apart for stability, hybrid mixes normal support under large flat overhangs, and organic grows smooth branches.", "Support", "advanced", "default\ngrid\nsnug\norganic\ntree_slim\ntree_strong\ntree_hybrid", "Default (Grid/Organic)\nGrid\nSnug\nOrganic\nTree Slim\nTree Strong\nTree Hybrid", "", ""},
    {"support_threshold_angle", "coInt", "Threshold angle", "", "°", "Overhangs flatter than this angle (measured from horizontal) get support. A smaller value means steeper overhangs print without support. With 0, normal support uses the threshold overlap instead.", "Support", "simple", "", "", "0", "90"},
    {"support_threshold_overlap", "coFloatOrPercent", "Threshold overlap", "", "mm or %", "When the threshold angle is 0: overhangs whose overlap with the layer below is less than this get support. In mm, or a percentage of the line width.", "Support", "simple", "", "", "0", "100"},
    {"support_top_z_distance", "coFloat", "Top Z distance", "", "mm", "Gap between the top of the support and the part. 0 for soluble support, about 0.1 mm for semi detachable, 0.2 mm for easy removal.", "Support", "advanced", "0\n0.1\n0.2", "0 (soluble)\n0.1 (semi-detachable)\n0.2 (detachable)", "0", ""},
    {"support_type", "coEnum", "Type", "", "", "Normal or tree support, made automatically (auto) or only where you placed support enforcers (manual).", "Support", "simple", "normal(auto)\ntree(auto)\nnormal(manual)\ntree(manual)", "Normal (auto)\nTree (auto)\nNormal (manual)\nTree (manual)", "", ""},
    {"symmetric_infill_y_axis", "coBool", "Symmetric infill Y axis", "", "", "For two parts that mirror each other across the Y axis: turn this on for one of them to mirror its infill texture too.", "Strength", "advanced", "", "", "", ""},
    {"temperature_vitrification", "coInts", "Softening temperature", "", "°C", "Temperature at which the filament softens. When the bed is this hot or hotter, open the front door or lift the lid to avoid clogs.", "", "simple", "", "", "", ""},
