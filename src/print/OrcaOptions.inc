    {"deretraction_speed", "coFloats", "De-retraction Speed", "De-retraction Speed", "mm/s", "Speed for reloading filament into the nozzle. Zero means same speed of retraction.", "", "advanced", "", "", "", ""},
    {"detect_narrow_internal_solid_infill", "coBool", "Detect narrow internal solid infills", "", "", "This option will auto-detect narrow internal solid infill areas. If enabled, the concentric pattern will be used for the area to speed up printing. Otherwise, the rectilinear pattern will be used by default.", "Strength", "advanced", "", "", "", ""},
    {"detect_overhang_wall", "coBool", "Detect overhang walls", "", "", "Detect the overhang percentage relative to line width and use different speed to print. For 100%% overhang, bridge speed is used.", "Quality", "advanced", "", "", "", ""},
    {"detect_thin_wall", "coBool", "Detect thin walls", "", "", "Detect thin walls which can't contain two line widths, and use single line to print. Maybe not printed very well, because it's not a closed loop.", "Strength", "advanced", "", "", "", ""},
    {"different_settings_to_system", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"disable_m73", "coBool", "Disable set remaining print time", "", "", "Disable generating of the M73: Set remaining print time in the final G-code.", "", "advanced", "", "", "", ""},
    {"dont_filter_internal_bridges", "coEnum", "Filter out small internal bridges", "", "", "This option can help reduce pillowing on top surfaces in heavily slanted or curved models.\nBy default, small internal bridges are filtered out and the internal solid infill is printed directly over the sparse infill. This works well in most cases, speeding up printing without too much compromise on top surface quality.\nHowever, in heavily slanted or curved models, especially where too low a sparse infill density is used, this may result in curling of the unsupported solid infill, causing pillowing.\nEnabling limited filtering or no filtering will print internal bridge layer over slightly unsupported internal solid infill. The options below control the sensitivity of the filtering, i.e. they control where internal bridges are created:\n1. Filter - enables this option. This is the default behavior and works well in most cases\n2. Limited filtering - creates internal bridges on heavily slanted surfaces while avoiding unnecessary bridges. This works well for most difficult models\n3. No filtering - creates internal bridges on every potential internal overhang. This option is useful for heavily slanted top surface models; however, in most cases, it creates too many unnecessary bridges.", "Quality", "advanced", "disabled\nlimited\nnofilter", "Filter\nLimited filtering\nNo filtering", "", ""},
    {"dont_slow_down_outer_wall", "coBools", "Don't slow down outer walls", "", "", "If enabled, this setting will ensure external perimeters are not slowed down to meet the minimum layer time. This is particularly helpful in the below scenarios:\n1. To avoid changes in shine when printing glossy filaments\n2. To avoid changes in external wall speed which may create slight wall artifacts that appear like Z banding\n3. To avoid printing at speeds which cause VFAs (fine artifacts) on the external walls", "", "simple", "", "", "", ""},
    {"draft_shield", "coEnum", "Draft shield", "", "", "A draft shield is useful to protect an ABS or ASA print from warping and detaching from print bed due to wind draft. It is usually needed only with open frame printers, i.e. without an enclosure.\n\nEnabled = skirt is as tall as the highest printed object. Otherwise 'Skirt height' is used.\nNote: With the draft shield active, the skirt will be printed at skirt distance from the object. Therefore, if brims are active it may intersect with them. To avoid this, increase the skirt distance value.\n", "", "advanced", "disabled\nenabled", "Disabled\nEnabled", "", ""},
    {"during_print_exhaust_fan_speed", "coInts", "Fan speed", "", "%", "Speed of exhaust fan during printing. This speed will override the speed in filament custom G-code.", "", "simple", "", "", "0", "100"},
    {"elefant_foot_compensation", "coFloat", "Elephant foot compensation", "", "mm", "Shrinks the first layer on build plate to compensate for elephant foot effect.", "Quality", "advanced", "", "", "0", ""},
    {"elefant_foot_compensation_layers", "coInt", "Elephant foot compensation layers", "", "layers", "The number of layers on which the elephant foot compensation will be active. The first layer will be shrunk by the elephant foot compensation value, then the next layers will be linearly shrunk less, up to the layer indicated by this value.", "Quality", "advanced", "", "", "1", ""},
    {"elefant_foot_layers_density", "coPercent", "Elephant foot layers density", "", "%", "Density of internal solid infill for Elephant foot layers compensation.\nThe initial value for the second layer is set.\nSubsequent layers become linearly denser by the height specified in elefant_foot_compensation_layers.", "Quality", "simple", "", "", "50", "100"},
    {"emit_machine_limits_to_gcode", "coBool", "Emit limits to G-code", "", "", "If enabled, the machine limits will be emitted to G-code file.\nThis option will be ignored if the G-code flavor is set to Klipper.", "Machine limits", "advanced", "", "", "", ""},
    {"enable_arc_fitting", "coBool", "Arc fitting", "", "", "Enable this to get a G-code file which has G2 and G3 moves. The fitting tolerance is same as the resolution.\n\nNote: For Klipper machines, this option is recommended to be disabled. Klipper does not benefit from arc commands as these are split again into line segments by the firmware. This results in a reduction in surface quality as line segments are converted to arcs by the slicer and then back to line segments by the firmware.", "", "advanced", "", "", "", ""},
    {"enable_extra_bridge_layer", "coEnum", "Extra bridge layers (beta)", "", "", "This option enables the generation of an extra bridge layer over internal and/or external bridges.\n\nExtra bridge layers help improve bridge appearance and reliability, as the solid infill is better supported. This is especially useful in fast printers, where the bridge and solid infill speeds vary greatly. The extra bridge layer results in reduced pillowing on top surfaces, as well as reduced separation of the external bridge layer from its surrounding perimeters.\n\nIt is generally recommended to set this to at least 'External bridge only', unless specific issues with the sliced model are found.\n\nOptions:\n1. Disabled - does not generate second bridge layers. This is the default and is set for compatibility purposes\n2. External bridge only - generates second bridge layers for external-facing bridges only. Please note that small bridges that are shorter or narrower than the set number of perimeters will be skipped as they would not benefit from a second bridge layer. If generated, the second bridge layer will be extruded parallel to the first bridge layer to reinforce the bridge strength\n3. Internal bridge only - generates second bridge layers for internal bridges over sparse infill only. Please note that the internal bridges count towards the top shell layer count of your model. The second internal bridge layer will be extruded as close to perpendicular to the first as possible. If multiple regions in the same island, with varying bridge angles are present, the last region of t", "Quality", "advanced", "disabled\nexternal_bridge_only\ninternal_bridge_only\napply_to_all", "Disabled\nExternal bridge only\nInternal bridge only\nApply to all", "", ""},
    {"enable_filament_dynamic_map", "coBool", "Enable filament dynamic map", "", "", "Enable dynamic filament mapping during print.", "", "develop", "", "", "", ""},
    {"enable_filament_ramming", "coBool", "Enable filament ramming", "", "", "Enable filament ramming", "", "advanced", "", "", "", ""},
    {"enable_long_retraction_when_cut", "coInt", "", "", "", "", "", "develop", "", "", "", ""},
    {"enable_overhang_bridge_fan", "coBools", "Force cooling for overhangs and bridges", "", "", "Enable this option to allow adjustment of the part cooling fan speed for specifically for overhangs, internal and external bridges. Setting the fan speed specifically for these features can improve overall print quality and reduce warping.", "", "simple", "", "", "", ""},
    {"enable_overhang_speed", "coBool", "Slow down for overhang", "", "", "Enable this option to slow printing down for different overhang degree.", "Speed", "advanced", "", "", "", ""},
    {"enable_power_loss_recovery", "coEnum", "Power Loss Recovery", "", "", "Choose how to control power loss recovery. When set to Printer configuration, the slicer will not emit power loss recovery G-code and will leave the printer's configuration unchanged. Applicable to Bambu Lab or Marlin 2 firmware based printers.", "", "advanced", "printer_configuration\nenable\ndisable", "Printer configuration\nEnable\nDisable", "", ""},
    {"enable_pressure_advance", "coBools", "Enable pressure advance", "", "", "Enable pressure advance, auto calibration result will be overwritten once enabled.", "", "simple", "", "", "", ""},
    {"enable_prime_tower", "coBool", "Enable", "", "", "The wiping tower can be used to clean up the residue on the nozzle and stabilize the chamber pressure inside the nozzle, in order to avoid appearance defects when printing objects.", "", "simple", "", "", "", ""},
    {"enable_support", "coBool", "Enable support", "", "", "Enable support generation.", "Support", "simple", "", "", "", ""},
    {"enable_tower_interface_cooldown_during_tower", "coBool", "Cool down from interface boost during prime tower", "", "", "When interface-layer temperature boost is active, set the nozzle back to print temperature at the start of the prime tower so it cools down during the tower.", "", "advanced", "", "", "", ""},
    {"enable_tower_interface_features", "coBool", "Enable tower interface features", "", "", "Enable optimized prime tower interface behavior when different materials meet.", "", "advanced", "", "", "", ""},
    {"enable_wrapping_detection", "coBool", "Enable clumping detection", "", "", "Enable clumping detection", "", "advanced", "", "", "", ""},
    {"enforce_support_layers", "coInt", "Enforce support for the first", "Enforce support for the first n layers", "layers", "Generate support material for the specified number of layers counting from bottom, regardless of whether normal support material is enabled or not and regardless of any angle threshold. This is useful for getting more adhesion of objects having a very thin or poor footprint on the build plate.", "Support", "develop", "", "", "0", "5000"},
    {"eng_plate_temp", "coInts", "Other layers", "Bed temperature", "°C", "Bed temperature for layers except the initial one. A value of 0 means the filament does not support printing on the Engineering Plate.", "", "simple", "", "", "0", "300"},
    {"eng_plate_temp_initial_layer", "coInts", "First layer", "First layer bed temperature", "°C", "Bed temperature of the first layer. A value of 0 means the filament does not support printing on the Engineering Plate.", "", "simple", "", "", "0", "300"},
    {"ensure_vertical_shell_thickness", "coEnum", "Ensure vertical shell thickness", "", "", "Add solid infill near sloping surfaces to guarantee the vertical shell thickness (top+bottom solid layers)\nNone: No solid infill will be added anywhere. Caution: Use this option carefully if your model has sloped surfaces\nCritical Only: Avoid adding solid infill for walls\nModerate: Add solid infill for heavily sloping surfaces only\nAll: Add solid infill for all suitable sloping surfaces\nDefault value is All.", "Strength", "advanced", "none\nensure_critical_only\nensure_moderate\nensure_all", "None\nCritical Only\nModerate\nAll", "", ""},
    {"exclude_object", "coBool", "Exclude objects", "", "", "Enable this option to add EXCLUDE OBJECT command in G-code.", "", "advanced", "", "", "", ""},
    {"extra_loading_move", "coFloat", "Extra loading distance", "", "mm", "When set to zero, the distance the filament is moved from parking position during load is exactly the same as it was moved back during unload. When positive, it is loaded further, if negative, the loading move is shorter than unloading.", "", "advanced", "", "", "", ""},
    {"extra_perimeters_on_overhangs", "coBool", "Extra perimeters on overhangs", "", "", "Create additional perimeter paths over steep overhangs and areas where bridges cannot be anchored.", "Quality", "advanced", "", "", "", ""},
    {"extra_solid_infills", "coString", "Insert solid layers", "", "", "Insert solid infill at specific layers. Use N to insert every Nth layer, N#K to insert K consecutive solid layers every N layers (K is optional, e.g. '5#' equals '5#1'), or a comma-separated list (e.g. 1,7,9) to insert at explicit layers. Layers are 1-based.", "Strength", "advanced", "", "", "", ""},
    {"extruder", "coInt", "Extruder", "", "", "The extruder to use (unless more specific extruder settings are specified). This value overrides perimeter and infill extruders, but not the support extruders.", "Extruders", "advanced", "", "default\n1\n2\n3\n4\n5", "0", ""},
    {"extruder_ams_count", "coStrings", "Extruder AMS count", "", "", "AMS counts per extruder.", "", "simple", "", "", "", ""},
    {"extruder_clearance_height_to_lid", "coFloat", "Height to lid", "", "mm", "Distance of the nozzle tip to the lid. Used for collision avoidance in by-object printing.", "", "advanced", "", "", "0", ""},
    {"extruder_clearance_height_to_rod", "coFloat", "Height to rod", "", "mm", "Distance of the nozzle tip to the lower rod. Used for collision avoidance in by-object printing.", "", "advanced", "", "", "0", ""},
    {"extruder_clearance_radius", "coFloat", "Radius", "", "mm", "Clearance radius around extruder. Used for collision avoidance in by-object printing.", "", "advanced", "", "", "0", ""},
    {"extruder_colour", "coStrings", "Extruder Color", "", "", "Only used as a visual help on UI.", "", "advanced", "", "", "", ""},
    {"extruder_offset", "coPoints", "Extruder offset", "", "mm", "If your firmware doesn't handle the extruder displacement you need the G-code to take it into account. This option lets you specify the displacement of each extruder with respect to the first one. It expects positive coordinates (they will be subtracted from the XY coordinate).", "", "advanced", "", "", "", ""},
    {"extruder_printable_area", "coPointsGroups", "Extruder printable area", "", "", "", "", "advanced", "", "", "", ""},
    {"extruder_printable_height", "coFloats", "Extruder printable height", "", "mm", "Maximum printable height of this extruder which is limited by mechanism of printer.", "", "advanced", "", "", "0", "1000"},
    {"extruder_type", "coEnums", "Type", "", "", "This setting is only used for initial value of manual calibration of pressure advance. Bowden extruder usually has larger PA value. This setting doesn't influence normal slicing.", "", "advanced", "Direct Drive\nBowden", "Direct Drive\nBowden", "", ""},
    {"extruder_variant_list", "coStrings", "Extruder variant list", "", "", "Extruder variant list.", "", "simple", "", "", "", ""},
    {"extrusion_rate_smoothing_external_perimeter_only", "coBool", "Apply only on external features", "", "", "Applies extrusion rate smoothing only on external perimeters and overhangs. This can help reduce artefacts due to sharp speed transitions on externally visible overhangs without impacting the print speed of features that will not be visible to the user.", "", "advanced", "", "", "", ""},
    {"fan_cooling_layer_time", "coFloats", "Layer time", "", "s", "Part cooling fan will be enabled for layers of which estimated time is shorter than this value. Fan speed is interpolated between the minimum and maximum fan speeds according to layer printing time.", "", "simple", "", "", "0", "1000"},
    {"fan_kickstart", "coFloat", "Fan kick-start time", "", "s", "Emit a max fan speed command for this amount of seconds before reducing to target speed to kick-start the cooling fan.\nThis is useful for fans where a low PWM/power may be insufficient to get the fan started spinning from a stop, or to get the fan up to speed faster.\nSet to 0 to deactivate.", "", "advanced", "", "", "0", ""},
    {"fan_max_speed", "coFloats", "Fan speed", "", "%", "Part cooling fan speed may be increased when auto cooling is enabled. This is the maximum speed for the part cooling fan.", "", "simple", "", "", "0", "100"},
    {"fan_min_speed", "coFloats", "Fan speed", "", "%", "Minimum speed for part cooling fan.", "", "simple", "", "", "0", "100"},
    {"fan_speedup_overhangs", "coBool", "Only overhangs", "", "", "Will only take into account the delay for the cooling of overhangs.", "", "advanced", "", "", "", ""},
    {"fan_speedup_time", "coFloat", "Fan speed-up time", "", "s", "Start the fan this number of seconds earlier than its target start time (you can use fractional seconds). It assumes infinite acceleration for this time estimation, and will only take into account G1 and G0 moves (arc fitting is unsupported).\nIt won't move fan commands from custom G-code (they act as a sort of 'barrier').\nIt won't move fan commands into the start G-code if the 'only custom start G-code' is activated.\nUse 0 to deactivate.", "", "advanced", "", "", "", ""},
    {"filament_adaptive_volumetric_speed", "coBools", "Adaptive volumetric speed", "", "", "When enabled, the extrusion flow is limited by the smaller of the fitted value (calculated from line width and layer height) and the user-defined maximum flow. When disabled, only the user-defined maximum flow is applied.\n\nNote: Experimental and incomplete feature imported from BBS. Functional for some profiles that already have the variable saved.", "", "develop", "", "", "", ""},
    {"filament_adhesiveness_category", "coInts", "Adhesiveness Category", "", "", "Filament category.", "", "develop", "", "", "0", ""},
    {"filament_change_extrusion_role_gcode", "coStrings", "Change extrusion role G-code (filament)", "", "", "This G-code is inserted when the extrusion role is changed for the active filament.", "", "advanced", "", "", "", ""},
    {"filament_change_length", "coFloats", "Filament ramming length", "", "mm", "When changing the extruder, it is recommended to extrude a certain length of filament from the original extruder. This helps minimize nozzle oozing.", "", "advanced", "", "", "0", ""},
    {"filament_colour", "coStrings", "Color", "", "", "Only used as a visual help on UI.", "", "advanced", "", "", "", ""},
    {"filament_colour_type", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_cooling_before_tower", "coFloats", "Wipe tower cooling", "", "°C", "Temperature drop before entering filament tower", "", "develop", "", "", "", ""},
    {"filament_cooling_final_speed", "coFloats", "Speed of the last cooling move", "", "mm/s", "Cooling moves are gradually accelerating towards this speed.", "", "advanced", "", "", "0", ""},
    {"filament_cooling_initial_speed", "coFloats", "Speed of the first cooling move", "", "mm/s", "Cooling moves are gradually accelerating beginning at this speed.", "", "advanced", "", "", "0", ""},
    {"filament_cooling_moves", "coInts", "Number of cooling moves", "", "", "Filament is cooled by being moved back and forth in the cooling tubes. Specify desired number of these moves.", "", "advanced", "", "", "0", "20"},
    {"filament_cost", "coFloats", "Price", "", "money/kg", "Filament price. For statistics only.", "", "advanced", "", "", "0", ""},
    {"filament_density", "coFloats", "Density", "", "g/cm³", "Filament density. For statistics only.", "", "advanced", "", "", "0", ""},
    {"filament_diameter", "coFloats", "Diameter", "", "mm", "Filament diameter is used to calculate extrusion in G-code, so it is important and should be accurate.", "", "simple", "", "", "0", ""},
    {"filament_end_gcode", "coStrings", "End G-code", "", "", "End G-code when finishing the printing of this filament.", "", "advanced", "", "", "", ""},
    {"filament_extruder_id", "coInts", "Filament extruder id", "", "", "Filament extruder id.", "", "simple", "", "", "", ""},
    {"filament_extruder_variant", "coStrings", "Filament's extruder variant", "", "", "Filament's extruder variant.", "", "simple", "", "", "", ""},
    {"filament_flow_ratio", "coFloats", "Flow ratio", "", "", "The material may have volumetric change after switching between molten and crystalline states. This setting changes all extrusion flow of this filament in G-code proportionally. The recommended value range is between 0.95 and 1.05. You may be able to tune this value to get a nice flat surface if there is slight overflow or underflow.", "", "advanced", "", "", "0", "2"},
    {"filament_flush_temp", "coInts", "Flush temperature", "", "°C", "Temperature when flushing filament. 0 indicates the upper bound of the recommended nozzle temperature range.", "", "advanced", "", "", "0", ""},
    {"filament_flush_volumetric_speed", "coFloats", "Flush volumetric speed", "", "mm³/s", "Volumetric speed when flushing filament. 0 indicates the max volumetric speed.", "", "advanced", "", "", "0", "200"},
    {"filament_ids", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_ironing_flow", "coPercents", "Ironing flow", "", "%", "Filament-specific override for ironing flow. This allows you to customize the ironing flow for each filament type. Too high value results in overextrusion on the surface.", "Quality", "advanced", "", "", "0", "100"},
    {"filament_ironing_inset", "coFloats", "Ironing inset", "", "mm", "Filament-specific override for ironing inset. This allows you to customize the distance to keep from the edges when ironing for each filament type.", "Quality", "advanced", "", "", "0", "100"},
    {"filament_ironing_spacing", "coFloats", "Ironing line spacing", "", "mm", "Filament-specific override for ironing line spacing. This allows you to customize the spacing between ironing lines for each filament type.", "Quality", "advanced", "", "", "0", "1"},
    {"filament_ironing_speed", "coFloats", "Ironing speed", "", "mm/s", "Filament-specific override for ironing speed. This allows you to customize the print speed of ironing lines for each filament type.", "Speed", "advanced", "", "", "1", ""},
    {"filament_is_support", "coBools", "Support material", "", "", "Support material is commonly used to print supports and support interfaces.", "", "advanced", "", "", "", ""},
    {"filament_loading_speed", "coFloats", "Loading speed", "", "mm/s", "Speed used for loading the filament on the wipe tower.", "", "advanced", "", "", "0", ""},
    {"filament_loading_speed_start", "coFloats", "Loading speed at the start", "", "mm/s", "Speed used at the very beginning of loading phase.", "", "advanced", "", "", "0", ""},
    {"filament_map", "coInts", "Filament map to extruder", "", "", "Filament map to extruder.", "", "develop", "", "", "", ""},
    {"filament_map_mode", "coEnum", "filament mapping mode", "", "", "Filament mapping mode used as plate param.", "", "advanced", "Auto For Flush\nAuto For Match\nManual\nDefault", "Auto For Flush\nAuto For Match\nManual\nDefault", "", ""},
    {"filament_max_volumetric_speed", "coFloats", "Max volumetric speed", "", "mm³/s", "This setting stands for how much volume of filament can be melted and extruded per second. Printing speed is limited by max volumetric speed, in case of too high and unreasonable speed setting. Can't be zero.", "", "advanced", "", "", "0", ""},
    {"filament_minimal_purge_on_wipe_tower", "coFloats", "Minimal purge on wipe tower", "", "mm³", "After a tool change, the exact position of the newly loaded filament inside the nozzle may not be known, and the filament pressure is likely not yet stable. Before purging the print head into an infill or a sacrificial object, Orca Slicer will always prime this amount of material into the wipe tower to produce successive infill or sacrificial object extrusions reliably.", "", "advanced", "", "", "0", ""},
    {"filament_multi_colour", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_multitool_ramming", "coBools", "Enable ramming for multi-tool setups", "", "", "Perform ramming when using multi-tool printer (i.e. when the 'Single Extruder Multimaterial' in Printer Settings is unchecked). When checked, a small amount of filament is rapidly extruded on the wipe tower just before the tool change. This option is only used when the wipe tower is enabled.", "", "advanced", "", "", "", ""},
    {"filament_multitool_ramming_flow", "coFloats", "Multi-tool ramming flow", "", "mm³/s", "Flow used for ramming the filament before the tool change.", "", "advanced", "", "", "0", ""},
    {"filament_multitool_ramming_volume", "coFloats", "Multi-tool ramming volume", "", "mm³", "The volume to be rammed before the tool change.", "", "advanced", "", "", "0", ""},
    {"filament_notes", "coStrings", "Filament notes", "", "", "You can put your notes regarding the filament here.", "", "advanced", "", "", "", ""},
    {"filament_printable", "coInts", "Filament printable", "", "", "The filament is printable in extruder.", "", "develop", "", "", "", ""},
    {"filament_ramming_parameters", "coStrings", "Ramming parameters", "", "", "This string is edited by RammingDialog and contains ramming specific parameters.", "", "advanced", "", "", "", ""},
    {"filament_self_index", "coInts", "Filament self index", "", "", "Filament self index.", "", "simple", "", "", "", ""},
    {"filament_settings_id", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"filament_shrink", "coPercents", "Shrinkage (XY)", "", "%", "Enter the shrinkage percentage that the filament will get after cooling (94% if you measure 94mm instead of 100mm). The part will be scaled in XY to compensate. For multi-material prints, ensure filament shrinkage matches across all used filaments\nBe sure to allow enough space between objects, as this compensation is done after the checks.", "", "advanced", "", "", "50", "150"},
    {"filament_shrinkage_compensation_z", "coPercents", "Shrinkage (Z)", "", "%", "Enter the shrinkage percentage that the filament will get after cooling (94% if you measure 94mm instead of 100mm). The part will be scaled in Z to compensate.", "", "advanced", "", "", "50", "150"},
    {"filament_soluble", "coBools", "Soluble material", "", "", "Soluble material is commonly used to print supports and support interfaces.", "", "advanced", "", "", "", ""},
    {"filament_stamping_distance", "coFloats", "Stamping distance measured from the center of the cooling tube", "", "", "If set to non-zero value, filament is moved toward the nozzle between the individual cooling moves (\"stamping\"). This option configures how long this movement should be before the filament is retracted again.", "", "advanced", "", "", "0", ""},
    {"filament_stamping_loading_speed", "coFloats", "Stamping loading speed", "", "", "Speed used for stamping.", "", "advanced", "", "", "0", ""},
    {"filament_start_gcode", "coStrings", "Start G-code", "", "", "Start G-code when starting the printing of this filament.", "", "advanced", "", "", "", ""},
    {"filament_toolchange_delay", "coFloats", "Delay after unloading", "", "s", "Time to wait after the filament is unloaded. May help to get reliable tool changes with flexible materials that may need more time to shrink to original dimensions.", "", "advanced", "", "", "0", ""},
    {"filament_tower_interface_pre_extrusion_dist", "coFloats", "Interface layer pre-extrusion distance", "", "mm", "Pre-extrusion distance for prime tower interface layer (where different materials meet).", "", "advanced", "", "", "0", ""},
    {"filament_tower_interface_pre_extrusion_length", "coFloats", "Interface layer pre-extrusion length", "", "mm", "Pre-extrusion length for prime tower interface layer (where different materials meet).", "", "advanced", "", "", "0", ""},
    {"filament_tower_interface_print_temp", "coInts", "Interface layer print temperature", "", "°C", "Print temperature for prime tower interface layer (where different materials meet). If set to -1, use max recommended nozzle temperature.", "", "advanced", "", "", "-1", ""},
    {"filament_tower_interface_purge_volume", "coFloats", "Interface layer purge length", "", "mm", "Purge length for prime tower interface layer (where different materials meet).", "", "advanced", "", "", "0", ""},
    {"filament_tower_ironing_area", "coFloats", "Tower ironing area", "", "mm²", "Ironing area for prime tower interface layer (where different materials meet).", "", "advanced", "", "", "0", ""},
    {"filament_type", "coStrings", "Type", "", "", "The material type of filament.", "", "simple", "", "", "", ""},
    {"filament_unloading_speed", "coFloats", "Unloading speed", "", "mm/s", "Speed used for unloading the filament on the wipe tower (does not affect initial part of unloading just after ramming).", "", "advanced", "", "", "0", ""},
    {"filament_unloading_speed_start", "coFloats", "Unloading speed at the start", "", "mm/s", "Speed used for unloading the tip of the filament immediately after ramming.", "", "advanced", "", "", "0", ""},
    {"filament_vendor", "coStrings", "Vendor", "", "", "Vendor of filament. For show only.", "", "advanced", "", "", "", ""},
    {"file_start_gcode", "coString", "File header G-code", "", "", "G-code written at the very top of the output file, before any other content. Useful for adding metadata that printer firmware reads from the first lines of the file (e.g. estimated print time, filament usage). Supports placeholders like {print_time_sec} and {used_filament_length}.", "", "advanced", "", "", "", ""},
    {"filename_format", "coString", "Filename format", "", "", "Users can define the project file name when exporting.", "", "advanced", "", "", "", ""},
    {"fill_multiline", "coInt", "Fill Multiline", "", "", "Using multiple lines for the infill pattern, if supported by infill pattern.", "Strength", "simple", "", "", "1", "10"},
    {"filter_out_gap_fill", "coFloat", "Filter out tiny gaps", "", "mm", "Don't print gap fill with a length is smaller than the threshold specified (in mm). This setting applies to top, bottom and solid infill and, if using the classic perimeter generator, to wall gap fill.", "Layers and Perimeters", "advanced", "", "", "", ""},
    {"first_layer_flow_ratio", "coFloat", "First layer flow ratio", "", "", "This factor affects the amount of material on the first layer for the extrusion path roles listed in this section.\n\nFor the first layer, the actual flow ratio for each path role (does not affect brims and skirts) will be multiplied by this value.", "Advanced", "advanced", "", "", "0", "2"},
    {"first_layer_print_sequence", "coInts", "First layer print sequence", "", "", "", "", "simple", "", "", "0", "16"},
    {"first_layer_sequence_choice", "coEnum", "First layer filament sequence", "", "", "", "Quality", "simple", "Auto\nCustomize", "Auto\nCustomize", "", ""},
    {"first_x_layer_fan_speed", "coFloats", "Fan speed", "", "%", "Special auxiliary cooling fan speed, effective only for the first x layers.", "", "simple", "", "", "0", "100"},
    {"flashforge_serial_number", "coString", "Serial Number", "", "", "Flashforge local API requires the printer serial number.", "", "advanced", "", "", "", ""},
    {"flush_into_infill", "coBool", "Flush into objects' infill", "", "", "Purging after filament change will be done inside objects' infills. This may lower the amount of waste and decrease the print time. If the walls are printed with transparent filament, the mixed color infill will be seen outside. It will not take effect, unless the prime tower is enabled.", "Flush options", "simple", "", "", "", ""},
    {"flush_into_objects", "coBool", "Flush into this object", "", "", "This object will be used to purge the nozzle after a filament change to save filament and decrease the print time. Colors of the objects will be mixed as a result. It will not take effect unless the prime tower is enabled.", "Flush options", "simple", "", "", "", ""},
    {"flush_into_support", "coBool", "Flush into objects' support", "", "", "Purging after filament change will be done inside objects' support. This may lower the amount of waste and decrease the print time. It will not take effect, unless the prime tower is enabled.", "Flush options", "simple", "", "", "", ""},
    {"flush_multiplier", "coFloats", "Flush multiplier", "", "", "The actual flushing volumes is equal to the flush multiplier multiplied by the flushing volumes in the table.", "", "simple", "", "", "", ""},
    {"flush_volumes_matrix", "coFloats", "Purging volumes", "", "", "This matrix describes volumes (in cubic millimeters) required to purge the new filament on the wipe tower for any given pair of tools.", "", "simple", "", "", "", ""},
    {"flush_volumes_vector", "coFloats", "Purging volumes - load/unload volumes", "", "", "This vector saves required volumes to change from/to each tool used on the wipe tower. These values are used to simplify creation of the full purging volumes below.", "", "simple", "", "", "", ""},
    {"full_fan_speed_layer", "coInts", "Full fan speed at layer", "", "layer", "Fan speed will be ramped up linearly from zero at layer \"close_fan_the_first_x_layers\" to maximum at layer \"full_fan_speed_layer\". \"full_fan_speed_layer\" will be ignored if lower than \"close_fan_the_first_x_layers\", in which case the fan will be running at maximum allowed speed at layer \"close_fan_the_first_x_layers\" + 1.", "", "advanced", "", "", "0", "1000"},
    {"fuzzy_skin", "coEnum", "Fuzzy Skin", "", "", "Randomly jitter while printing the wall, so that the surface has a rough look. This setting controls the fuzzy position.", "Others", "simple", "none\nexternal\nhole\nall\nallwalls\ndisabled_fuzzy", "Painted only\nContour\nHole\nContour and hole\nAll walls\nDisabled", "", ""},
    {"fuzzy_skin_first_layer", "coBool", "Apply fuzzy skin to first layer", "", "", "Whether to apply fuzzy skin on the first layer.", "Others", "simple", "", "", "", ""},
    {"fuzzy_skin_layers_between_ripple_offset", "coInt", "Layers between ripple offset", "", "", "Specifies how many consecutive layers share the same ripple phase before the offset is applied.\nFor example:\n- 1 = Layer 1 is printed with the base ripple pattern, then layer 2 is shifted by the configured offset, then layer 3 returns to the base pattern, and so on.\n- 3 = Layers 1 to 3 are printed with the base ripple pattern, then layers 4 to 6 are shifted by the configured offset, then layers 7 to 9 return to the base pattern, etc.", "Others", "advanced", "", "", "1", ""},
    {"fuzzy_skin_mode", "coEnum", "Fuzzy skin generator mode", "", "", "Fuzzy skin generation mode. Works only with Arachne!\nDisplacement: Сlassic mode when the pattern is formed by shifting the nozzle sideways from the original path.\nExtrusion: The mode when the pattern formed by the amount of extruded plastic. This is the fast and straight algorithm without unnecessary nozzle shake that gives a smooth pattern. But it is more useful for forming loose walls in the entire they array.\nCombined: Joint mode [Displacement] + [Extrusion]. The appearance of the walls is similar to [Displacement] Mode, but it leaves no pores between the perimeters.\n\nAttention! The [Extrusion] and [Combined] modes works only the fuzzy_skin_thickness parameter not more than the thickness of printed loop. At the same time, the width of the extrusion for a particular layer should also not be below a certain level. It is usually equal 15-25%% of a layer height. Therefore, the maximum fuzzy skin thickness with a perimeter width of 0.4 mm and a layer height of 0.2 mm will be 0.4-(0.2*0.25)=±0.35mm! If you enter a higher parameter than this, the error Flow::spacing() will displayed, and the model will not be sliced. You can choose this number until this error is repeated.", "Others", "simple", "displacement\nextrusion\ncombined", "Displacement\nExtrusion\nCombined", "", ""},
    {"fuzzy_skin_noise_type", "coEnum", "Fuzzy skin noise type", "", "", "Noise type to use for fuzzy skin generation:\nClassic: Classic uniform random noise.\nPerlin: Perlin noise, which gives a more consistent texture.\nBillow: Similar to perlin noise, but clumpier.\nRidged Multifractal: Ridged noise with sharp, jagged features. Creates marble-like textures.\nVoronoi: Divides the surface into voronoi cells, and displaces each one by a random amount. Creates a patchwork texture.\nRipple: Uniform ripple pattern that ripples left and right of the original path. Repeating pattern, woven appearance.", "Others", "simple", "classic\nperlin\nbillow\nridgedmulti\nvoronoi\nripple", "Classic\nPerlin\nBillow\nRidged Multifractal\nVoronoi\nRipple", "", ""},
    {"fuzzy_skin_octaves", "coInt", "Fuzzy Skin Noise Octaves", "", "", "The number of octaves of coherent noise to use. Higher values increase the detail of the noise, but also increase computation time.", "Others", "advanced", "", "", "1", "10"},
    {"fuzzy_skin_persistence", "coFloat", "Fuzzy skin noise persistence", "", "", "The decay rate for higher octaves of the coherent noise. Lower values will result in smoother noise.", "Others", "advanced", "", "", "", "1"},
    {"fuzzy_skin_point_distance", "coFloat", "Fuzzy skin point distance", "", "mm", "The average distance between the random points introduced on each line segment.", "Others", "simple", "", "", "", ""},
    {"fuzzy_skin_ripple_offset", "coPercent", "Ripple offset", "", "%", "Shifts the ripple phase forward along the print path by the specified percentage of a wavelength each layer period.\n- 0% keeps every layer identical.\n- 50% shifts the pattern by half a wavelength, effectively inverting the phase.\n- 100% shifts the pattern by a full wavelength, returning to the original phase.\n\nThe shift is applied once every number of layers set by Layers between ripple offset, so layers within the same group are printed identically.", "Others", "advanced", "", "", "0", "100"},
    {"fuzzy_skin_ripples_per_layer", "coInt", "Number of ripples per layer", "", "", "Controls how many full cycles of ripples will be added per layer.", "Others", "advanced", "", "", "1", ""},
    {"fuzzy_skin_scale", "coFloat", "Fuzzy skin feature size", "", "mm", "The base size of the coherent noise features, in mm. Higher values will result in larger features.", "Others", "advanced", "", "", "", "500"},
    {"fuzzy_skin_thickness", "coFloat", "Fuzzy skin thickness", "", "mm", "The width within which to jitter. It's advised to be below outer wall line width.", "Others", "simple", "", "", "0", "2"},
    {"gap_fill_flow_ratio", "coFloat", "Gap fill flow ratio", "", "", "This factor affects the amount of material for filling the gaps.\n\nThe actual gap filling flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"gap_fill_target", "coEnum", "Apply gap fill", "", "", "Enables gap fill for the selected solid surfaces. The minimum gap length that will be filled can be controlled from the filter out tiny gaps option below.\n\nOptions:\n1. Everywhere: Applies gap fill to top, bottom and internal solid surfaces for maximum strength\n2. Top and Bottom surfaces: Applies gap fill to top and bottom surfaces only, balancing print speed, reducing potential over extrusion in the solid infill and making sure the top and bottom surfaces have no pinhole gaps\n3. Nowhere: Disables gap fill for all solid infill areas\n\nNote that if using the classic perimeter generator, gap fill may also be generated between perimeters, if a full width line cannot fit between them. That perimeter gap fill is not controlled by this setting.\n\nIf you would like all gap fill, including the classic perimeter generated one, removed, set the filter out tiny gaps value to a large number, like 999999.\n\nHowever this is not advised, as gap fill between perimeters is contributing to the model's strength. For models where excessive gap fill is generated between perimeters, a better option would be to switch to the arachne wall generator and use this option to control whether the cosmetic top and bottom surface gap fill is generated.", "Strength", "advanced", "everywhere\ntopbottom\nnowhere", "Everywhere\nTop and bottom surfaces\nNowhere", "", ""},
    {"gap_infill_speed", "coFloat", "Gap infill", "", "mm/s", "Speed of gap infill. Gap usually has irregular line width and should be printed more slowly.", "Speed", "advanced", "", "", "1", ""},
    {"gcode_add_line_number", "coBool", "Add line number", "", "", "Enable this to add line number(Nx) at the beginning of each G-code line.", "", "develop", "", "", "", ""},
    {"gcode_comments", "coBool", "Verbose G-code", "", "", "Enable this to get a commented G-code file, with each line explained by a descriptive text. If you print from SD card, the additional weight of the file could make your firmware slow down.", "", "advanced", "", "", "", ""},
    {"gcode_flavor", "coEnum", "G-code flavor", "", "", "What kind of G-code the printer is compatible with.", "", "advanced", "marlin\nklipper\nreprapfirmware\nrepetier\nmarlin2\nreprap\nteacup\nmakerware\nsailfish\nmach3\nmachinekit\nsmoothie\nno-extrusion", "Marlin(legacy)\nKlipper\nRepRapFirmware\nRepetier\nMarlin 2\nRepRap/Sprinter\nTeacup\nMakerWare (MakerBot)\nSailfish (MakerBot)\nMach3/LinuxCNC\nMachinekit\nSmoothie\nNo extrusion", "", ""},
    {"gcode_label_objects", "coBool", "Label objects", "", "", "Enable this to add comments into the G-code labeling print moves with what object they belong to, which is useful for the Octoprint CancelObject plug-in. This setting is NOT compatible with Single Extruder Multi Material setup and Wipe into Object / Wipe into Infill.", "", "advanced", "", "", "", ""},
    {"grab_length", "coFloats", "Grab length", "", "mm", "", "", "develop", "", "", "0", ""},
    {"gyroid_optimized", "coBool", "Z-buckling bias optimization (experimental)", "", "", "Tightens the gyroid wave along the Z (vertical) axis at low infill density to shorten the effective vertical column length and improve Z-axis compression buckling resistance. Filament use is preserved. No effect at ~30% sparse infill density and above. Only applies when Sparse infill pattern is set to Gyroid.", "Strength", "simple", "", "", "", ""},
    {"has_filament_switcher", "coBool", "Has filament switcher", "", "", "Printer has a filament switcher hardware (e.g., AMS).", "", "develop", "", "", "", ""},
    {"has_scarf_joint_seam", "coBool", "", "", "", "", "", "advanced", "", "", "", ""},
    {"head_wrap_detect_zone", "coPoints", "Head wrap detect zone", "", "", "", "", "develop", "", "", "", ""},
    {"high_current_on_filament_swap", "coBool", "High extruder current on filament swap", "", "", "It may be beneficial to increase the extruder motor current during the filament exchange sequence to allow for rapid ramming feed rates and to overcome resistance when loading a filament with an ugly shaped tip.", "", "advanced", "", "", "", ""},
    {"hole_to_polyhole", "coBool", "Convert holes to polyholes", "", "", "Search for almost-circular holes that span more than one layer and convert the geometry to polyholes. Use the nozzle size and the (biggest) diameter to compute the polyhole.\nSee http://hydraraptor.blogspot.com/2011/02/polyholes.html", "Quality", "advanced", "", "", "", ""},
    {"hole_to_polyhole_threshold", "coFloatOrPercent", "Polyhole detection margin", "", "mm or %", "Maximum defection of a point to the estimated radius of the circle.\nAs cylinders are often exported as triangles of varying size, points may not be on the circle circumference. This setting allows you some leeway to broaden the detection.\nIn mm or in % of the radius.", "Quality", "advanced", "", "", "", ""},
    {"hole_to_polyhole_twisted", "coBool", "Polyhole twist", "", "", "Rotate the polyhole every layer.", "Quality", "advanced", "", "", "", ""},
    {"host_type", "coEnum", "Host Type", "", "", "Orca Slicer can upload G-code files to a printer host. This field must contain the kind of the host.", "", "advanced", "prusalink\nprusaconnect\noctoprint\nduet\nflashair\nastrobox\nrepetier\nmks\nesp3d\ncrealityprint\nobico\nflashforge\nsimplyprint\nelegoolink\n3dprinteros\nmoonraker", "PrusaLink\nPrusaConnect\nOcto/Klipper\nDuet\nFlashAir\nAstroBox\nRepetier\nMKS\nESP3D\nCrealityPrint\nObico\nFlashforge\nSimplyPrint\nElegoo Link\n3DPrinterOS\nMoonraker (Klipper)", "", ""},
    {"hot_plate_temp", "coInts", "Other layers", "Bed temperature", "°C", "Bed temperature for layers except the initial one. A value of 0 means the filament does not support printing on the High Temp Plate.", "", "simple", "", "", "0", "300"},
    {"hot_plate_temp_initial_layer", "coInts", "First layer", "First layer bed temperature", "°C", "Bed temperature of the first layer. A value of 0 means the filament does not support printing on the High Temp Plate.", "", "simple", "", "", "", "300"},
    {"idle_temperature", "coInts", "Idle temperature", "", "°C", "Nozzle temperature when the tool is currently not used in multi-tool setups. This is only used when 'Ooze prevention' is active in Print Settings. Set to 0 to disable.", "", "simple", "", "", "0", ""},
    {"independent_support_layer_height", "coBool", "Independent support layer height", "", "", "Support layer uses layer height independent with object layer. This is to support customizing Z-gap and save print time. This option will be invalid when the prime tower is enabled.", "Support", "advanced", "", "", "", ""},
    {"infill_anchor", "coFloatOrPercent", "Sparse infill anchor length", "", "mm or %", "Connect an infill line to an internal perimeter with a short segment of an additional perimeter. If expressed as percentage (example: 15%) it is calculated over infill extrusion width. Orca Slicer tries to connect two close infill lines to a short perimeter segment. If no such perimeter segment shorter than infill_anchor_max is found, the infill line is connected to a perimeter segment at just one side and the length of the perimeter segment taken is limited to this parameter, but no longer than anchor_length_max.\nSet this parameter to zero to disable anchoring perimeters connected to a single infill line.", "Strength", "advanced", "0\n1\n2\n5\n10\n1000", "0 (no open anchors)\n1 mm\n2 mm\n5 mm\n10 mm\n1000 (unlimited)", "", ""},
    {"infill_anchor_max", "coFloatOrPercent", "Maximum length of the infill anchor", "", "", "Connect an infill line to an internal perimeter with a short segment of an additional perimeter. If expressed as percentage (example: 15%) it is calculated over infill extrusion width. Orca Slicer tries to connect two close infill lines to a short perimeter segment. If no such perimeter segment shorter than this parameter is found, the infill line is connected to a perimeter segment at just one side and the length of the perimeter segment taken is limited to infill_anchor, but no longer than this parameter.\nIf set to 0, the old algorithm for infill connection will be used, it should create the same result as with 1000 & 0.", "Strength", "advanced", "", "0 (Simple connect)\n1 mm\n2 mm\n5 mm\n10 mm\n1000 (unlimited)", "", ""},
    {"infill_combination", "coBool", "Infill combination", "", "", "Automatically Combine sparse infill of several layers to print together to reduce time. Wall is still printed with original layer height.", "Strength", "advanced", "", "", "", ""},
    {"infill_combination_max_layer_height", "coFloatOrPercent", "Infill combination - Max layer height", "", "mm or %", "Maximum layer height for the combined sparse infill.\n\nSet it to 0 or 100% to use the nozzle diameter (for maximum reduction in print time) or a value of ~80% to maximize sparse infill strength.\n\nThe number of layers over which infill is combined is derived by dividing this value with the layer height and rounded down to the nearest decimal.\n\nUse either absolute mm values (eg. 0.32mm for a 0.4mm nozzle) or % values (eg 80%). This value must not be larger than the nozzle diameter.", "Strength", "advanced", "", "", "0", ""},
    {"infill_direction", "coFloat", "Sparse infill direction", "", "°", "Angle for sparse infill pattern, which controls the start or main direction of line.", "Strength", "advanced", "", "", "0", "360"},
    {"infill_jerk", "coFloat", "Infill", "", "mm/s", "Jerk for infill.", "Speed", "advanced", "", "", "0", ""},
    {"infill_lock_depth", "coFloat", "Infill lock depth", "", "mm", "The parameter sets the overlapping depth between the interior and skin.", "Strength", "advanced", "", "", "0", "100"},
    {"infill_overhang_angle", "coFloat", "Infill overhang angle", "", "°", "The angle of the infill angled lines. 60° will result in a pure honeycomb.", "Strength", "advanced", "", "", "15", "75"},
    {"infill_shift_step", "coFloat", "Infill shift step", "", "mm", "This parameter adds a slight displacement to each layer of infill to create a cross texture.", "Strength", "advanced", "", "", "0", "10"},
    {"infill_wall_overlap", "coPercent", "Infill/Wall overlap", "", "%", "Infill area is enlarged slightly to overlap with wall for better bonding. The percentage value is relative to line width of sparse infill. Set this value to ~10-15% to minimize potential over extrusion and accumulation of material resulting in rough top surfaces.", "Strength", "advanced", "", "", "", ""},
    {"inherits", "coString", "Inherits profile", "", "", "Name of parent profile.", "", "simple", "", "", "", ""},
    {"inherits_group", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"initial_layer_acceleration", "coFloat", "First layer", "", "mm/s²", "Acceleration of the first layer. Using a lower value can improve build plate adhesion.", "Speed", "advanced", "", "", "0", ""},
    {"initial_layer_infill_speed", "coFloat", "First layer infill", "", "mm/s", "Speed of solid infill part of the first layer.", "", "advanced", "", "", "1", ""},
    {"initial_layer_jerk", "coFloat", "First layer", "", "mm/s", "Jerk for the first layer.", "Speed", "advanced", "", "", "0", ""},
    {"initial_layer_line_width", "coFloatOrPercent", "First layer", "", "mm or %", "Line width of the first layer. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"initial_layer_min_bead_width", "coPercent", "First layer minimum wall width", "", "%", "The minimum wall width that should be used for the first layer is recommended to be set to the same size as the nozzle. This adjustment is expected to enhance adhesion.", "Quality", "advanced", "", "", "0", ""},
    {"initial_layer_print_height", "coFloat", "First layer height", "", "mm", "Height of the first layer. Making the first layer height thicker can improve build plate adhesion.", "Quality", "simple", "", "", "0", ""},
    {"initial_layer_speed", "coFloat", "First layer", "", "mm/s", "Speed of the first layer except the solid infill part.", "", "advanced", "", "", "1", ""},
    {"initial_layer_travel_acceleration", "coFloatOrPercent", "First layer travel", "", "mm/s² or %", "Travel acceleration of first layer.\nThe percentage value is relative to Travel Acceleration.", "", "advanced", "", "", "0", ""},
    {"initial_layer_travel_jerk", "coFloatOrPercent", "First layer travel", "", "mm/s or %", "Travel jerk of first layer.\nThe percentage value is relative to Travel Jerk.", "", "advanced", "", "", "0", ""},
    {"initial_layer_travel_speed", "coFloatOrPercent", "First layer travel speed", "", "mm/s or %", "Travel speed of the first layer.", "Speed", "advanced", "", "", "1", ""},
    {"inner_wall_acceleration", "coFloat", "Inner wall", "", "mm/s²", "Acceleration of inner walls.", "Speed", "advanced", "", "", "0", ""},
    {"inner_wall_filament_id", "coInt", "Inner walls", "", "", "Filament to print inner walls.\n\"Default\" uses the active object/part filament.", "Extruders", "advanced", "", "", "0", ""},
    {"inner_wall_flow_ratio", "coFloat", "Inner wall flow ratio", "", "", "This factor affects the amount of material for inner walls.\n\nThe actual inner wall flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"inner_wall_jerk", "coFloat", "Inner wall", "", "mm/s", "Jerk of inner walls.", "Speed", "advanced", "", "", "0", ""},
    {"inner_wall_line_width", "coFloatOrPercent", "Inner wall", "", "mm or %", "Line width of inner wall. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"inner_wall_speed", "coFloat", "Inner wall", "", "mm/s", "Speed of inner wall.", "Speed", "advanced", "", "", "1", ""},
    {"input_shaping_damp_x", "coFloat", "X", "", "", "Damping ratio for the X axis input shaper.\nZero will use the firmware damping ratio.\nTo disable input shaping, use the Disable type.\nRRF: X and Y values are equal.", "", "simple", "", "", "0", "1"},
    {"input_shaping_damp_y", "coFloat", "Y", "", "", "Damping ratio for the Y axis input shaper.\nZero will use the firmware damping ratio.\nTo disable input shaping, use the Disable type.", "", "simple", "", "", "0", "1"},
    {"input_shaping_emit", "coBool", "Emit input shaping", "", "", "Override firmware input shaping settings.\nIf disabled, firmware settings are used.", "", "simple", "", "", "", ""},
    {"input_shaping_freq_x", "coFloat", "X", "", "Hz", "Resonant frequency for the X axis input shaper.\nZero will use the firmware frequency.\nTo disable input shaping, use the Disable type.\nRRF: X and Y values are equal.", "", "simple", "", "", "0", "1000"},
    {"input_shaping_freq_y", "coFloat", "Y", "", "Hz", "Resonant frequency for the Y axis input shaper.\nZero will use the firmware frequency.\nTo disable input shaping, use the Disable type.", "", "simple", "", "", "0", "1000"},
    {"input_shaping_type", "coEnum", "Input shaper type", "", "", "Choose the input shaper algorithm.\nDefault uses the firmware default settings.\nDisable turns off input shaping in the firmware.", "", "simple", "", "", "", ""},
    {"interface_shells", "coBool", "Interface shells", "", "", "Force the generation of solid shells between adjacent materials/volumes. Useful for multi-extruder prints with translucent materials or manual soluble support material.", "Quality", "advanced", "", "", "", ""},
    {"interlocking_beam", "coBool", "Use beam interlocking", "", "", "Generate interlocking beam structure at the locations where different filaments touch. This improves the adhesion between filaments, especially models printed in different materials.", "Advanced", "advanced", "", "", "", ""},
    {"interlocking_beam_layer_count", "coInt", "Interlocking beam layers", "", "", "The height of the beams of the interlocking structure, measured in number of layers. Less layers is stronger, but more prone to defects.", "Advanced", "advanced", "", "", "1", ""},
    {"interlocking_beam_width", "coFloat", "Interlocking beam width", "", "mm", "The width of the interlocking structure beams.", "Advanced", "advanced", "", "", "0.01", ""},
    {"interlocking_boundary_avoidance", "coInt", "Interlocking boundary avoidance", "", "", "The distance from the outside of a model where interlocking structures will not be generated, measured in cells.", "Advanced", "advanced", "", "", "0", ""},
    {"interlocking_depth", "coInt", "Interlocking depth", "", "", "The distance from the boundary between filaments to generate interlocking structure, measured in cells. Too few cells will result in poor adhesion.", "Advanced", "advanced", "", "", "1", ""},
    {"interlocking_orientation", "coFloat", "Interlocking direction", "", "°", "Orientation of interlock beams.", "Advanced", "advanced", "", "", "0", "360"},
    {"internal_bridge_angle", "coFloat", "Internal bridge infill direction", "", "°", "Internal Bridging angle override.\nIf left to zero, the bridging angle will be calculated automatically for each specific bridge.\nOtherwise the provided angle will be used according to:\n - The absolute coordinates\n - The absolute coordinates + Model rotation: If Align infill direction to model is enabled\n - The optimal automatic angle + this value: If 'Relative Bridge Angle' is enabled\n\nUse 180° for zero absolute angle.", "Strength", "advanced", "", "", "0", "180"},
    {"internal_bridge_density", "coPercent", "Internal bridge density", "", "%", "Controls the density (spacing) of internal bridge lines.\nInternal bridges act as intermediate support between sparse infill and top solid infill and can strongly affect top surface quality.\n\n- Higher than 100% density (Recommended Max 125%):\n  - Pros: Improves internal bridge strength and support under top layers, reducing sagging and improving top-surface finish.\n  - Cons: Increases material use and print time; excessive density may cause overextrusion and internal stresses.\n\n- Lower than 100% density (Min 10%):\n  - Pros: Can reduce pillowing and improve cooling (more airflow through the bridge), and may speed up printing.\n  - Cons: May reduce internal support, increasing the risk of sagging and top surface defects.\n\nThis option works particularly well when combined with the second internal bridge over infill option to improve bridging further before solid infill is extruded.", "Strength", "advanced", "", "", "10", "125"},
    {"internal_bridge_fan_speed", "coInts", "Internal bridges fan speed", "", "%", "The part cooling fan speed used for all internal bridges. Set to -1 to use the overhang fan speed settings instead.\n\nReducing the internal bridges fan speed, compared to your regular fan speed, can help reduce part warping due to excessive cooling applied over a large surface for a prolonged period of time.", "", "advanced", "", "", "-1", "100"},
    {"internal_bridge_flow", "coFloat", "Internal bridge flow ratio", "", "", "This value governs the thickness of the internal bridge layer. This is the first layer over sparse infill so increasing it may increase strength and upper layer quality.\nValues above 1.0: Increase the amount of material while maintaining line spacing. This can improve line contact and strength.\nValues below 1.0: Reduce the amount of material while adjusting line spacing to maintain contact. This can improve sagging.\n\nThe actual bridge flow used is calculated by multiplying this value with the filament flow ratio, and if set, the object's flow ratio.", "Quality", "advanced", "", "", "0", "2.0"},
    {"internal_bridge_speed", "coFloatOrPercent", "Internal", "", "mm/s or %", "Speed of internal bridges. If the value is expressed as a percentage, it will be calculated based on the bridge_speed. Default value is 150%.", "Speed", "advanced", "", "", "1", ""},
    {"internal_solid_filament_id", "coInt", "Internal solid infill", "", "", "Filament to print internal solid infill.\n\"Default\" uses the active object/part filament.", "Extruders", "advanced", "", "", "0", ""},
    {"internal_solid_infill_acceleration", "coFloatOrPercent", "Internal solid infill", "", "mm/s² or %", "Acceleration of internal solid infill. If the value is expressed as a percentage (e.g. 100%), it will be calculated based on the default acceleration.", "Speed", "advanced", "", "", "0", ""},
    {"internal_solid_infill_flow_ratio", "coFloat", "Internal solid infill flow ratio", "", "", "This factor affects the amount of material for internal solid infill.\n\nThe actual internal solid infill flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"internal_solid_infill_line_width", "coFloatOrPercent", "Internal solid infill", "", "mm or %", "Line width of internal solid infill. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"internal_solid_infill_pattern", "coEnum", "Internal solid infill pattern", "", "", "Line pattern of internal solid infill. if the detect narrow internal solid infill be enabled, the concentric pattern will be used for the small area.", "Strength", "simple", "monotonic\nmonotonicline\nrectilinear\nalignedrectilinear\nconcentric\nhilbertcurve\narchimedeanchords\noctagramspiral", "Monotonic\nMonotonic line\nRectilinear\nAligned Rectilinear\nConcentric\nHilbert Curve\nArchimedean Chords\nOctagram Spiral", "", ""},
    {"internal_solid_infill_speed", "coFloat", "Internal solid infill", "", "mm/s", "Speed of internal solid infill, not the top and bottom surface.", "Speed", "advanced", "", "", "1", ""},
    {"ironing_angle", "coFloat", "Ironing angle offset", "", "°", "The angle of ironing lines offset from the top surface.", "Quality", "advanced", "", "", "0", "359"},
    {"ironing_angle_fixed", "coBool", "Fixed ironing angle", "", "", "Use a fixed absolute angle for ironing.", "Quality", "advanced", "", "", "", ""},
    {"ironing_expansion", "coFloat", "Ironing expansion", "", "mm", "Expand or contract the ironing area.", "Quality", "simple", "", "", "-100", "100"},
    {"ironing_fan_speed", "coInts", "Ironing fan speed", "", "%", "This part cooling fan speed is applied when ironing. Setting this parameter to a lower than regular speed reduces possible nozzle clogging due to the low volumetric flow rate, making the interface smoother.\nSet to -1 to disable it.", "", "advanced", "", "", "-1", "100"},
    {"ironing_flow", "coPercent", "Ironing flow", "", "%", "The amount of material to extrude during ironing. Relative to flow of normal layer height. Too high value results in overextrusion on the surface.", "Quality", "advanced", "", "", "0", "100"},
    {"ironing_inset", "coFloat", "Ironing inset", "", "mm", "The distance to keep from the edges. A value of 0 sets this to half of the nozzle diameter.", "Quality", "advanced", "", "", "0", "100"},
    {"ironing_pattern", "coEnum", "Ironing Pattern", "", "", "The pattern that will be used when ironing.", "Quality", "advanced", "rectilinear\nconcentric", "Rectilinear\nConcentric", "", ""},
    {"ironing_spacing", "coFloat", "Ironing line spacing", "", "mm", "The distance between the lines of ironing.", "Quality", "advanced", "", "", "0", "1"},
    {"ironing_speed", "coFloat", "Ironing speed", "", "mm/s", "Print speed of ironing lines.", "Quality", "advanced", "", "", "1", ""},
    {"ironing_type", "coEnum", "Ironing Type", "", "", "Ironing is using small flow to print on same height of surface again to make flat surface more smooth. This setting controls which layer being ironed.", "Quality", "advanced", "no ironing\ntop\ntopmost\nsolid", "No ironing\nTop surfaces\nTopmost surface\nAll solid layers", "", ""},
    {"is_infill_first", "coBool", "Print infill first", "", "", "Order of wall/infill. When the tickbox is unchecked the walls are printed first, which works best in most cases.\n\nPrinting infill first may help with extreme overhangs as the walls have the neighbouring infill to adhere to. However, the infill will slightly push out the printed walls where it is attached to them, resulting in a worse external surface finish. It can also cause the infill to shine through the external surfaces of the part.", "Quality", "advanced", "", "", "", ""},
    {"lateral_lattice_angle_1", "coFloat", "Lateral lattice angle 1", "", "°", "The angle of the first set of Lateral lattice elements in the Z direction. Zero is vertical.", "Strength", "advanced", "", "", "-75", "75"},
    {"lateral_lattice_angle_2", "coFloat", "Lateral lattice angle 2", "", "°", "The angle of the second set of Lateral lattice elements in the Z direction. Zero is vertical.", "Strength", "advanced", "", "", "-75", "75"},
    {"layer_change_gcode", "coString", "Layer change G-code", "", "", "This G-code is inserted at every layer change after the Z lift.", "", "advanced", "", "", "", ""},
    {"layer_height", "coFloat", "Layer height", "", "mm", "Slicing height for each layer. Smaller layer height means more accurate and more printing time.", "Quality", "simple", "", "", "0", ""},
    {"lightning_overhang_angle", "coFloat", "Lightning overhang angle", "", "°", "Maximum overhang angle for Lightning infill support propagation.", "Strength", "simple", "", "", "5", "85"},
    {"lightning_prune_angle", "coFloat", "Prune angle", "", "°", "Controls how aggressively short or unsupported Lightning branches are pruned.\nThis angle is converted internally to a per-layer distance.", "Strength", "simple", "", "", "5", "85"},
    {"lightning_straightening_angle", "coFloat", "Straightening angle", "", "°", "Maximum straightening angle used to simplify Lightning branches.", "Strength", "simple", "", "", "5", "85"},
    {"line_width", "coFloatOrPercent", "Default", "", "mm or %", "Default line width if other line widths are set to 0. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"long_retractions_when_cut", "coBools", "Long retraction when cut (beta)", "", "", "Experimental feature: Retracting and cutting off the filament at a longer distance during changes to minimize purge. While this reduces flush significantly, it may also raise the risk of nozzle clogs or other printing problems.", "", "develop", "", "", "", ""},
    {"long_retractions_when_ec", "coBools", "Long retraction when extruder change", "", "", "", "", "advanced", "", "", "", ""},
    {"machine_end_gcode", "coString", "End G-code", "", "", "End G-code when finishing the entire print.", "", "advanced", "", "", "", ""},
    {"machine_load_filament_time", "coFloat", "Filament load time", "", "s", "Time to load new filament when switch filament. It's usually applicable for single-extruder multi-material machines. For tool changers or multi-tool machines, it's typically 0. For statistics only.", "", "advanced", "", "", "0", ""},
    {"machine_max_acceleration_extruding", "coFloats", "", "Maximum acceleration for extruding", "mm/s²", "Maximum acceleration for extruding (M204 P)", "Machine limits", "simple", "", "", "0", ""},
    {"machine_max_acceleration_retracting", "coFloats", "", "Maximum acceleration for retracting", "mm/s²", "Maximum acceleration for retracting (M204 R)", "Machine limits", "simple", "", "", "0", ""},
    {"machine_max_acceleration_travel", "coFloats", "", "Maximum acceleration for travel", "mm/s²", "Maximum acceleration for travel (M204 T), it only applies to Marlin 2.", "Machine limits", "advanced", "", "", "0", ""},
    {"machine_max_junction_deviation", "coFloats", "", "Maximum Junction Deviation", "mm", "Maximum junction deviation (M205 J, only apply if JD > 0 for Marlin Firmware\nIf your Marlin 2 printer uses Classic Jerk set this value to 0.)", "Machine limits", "advanced", "", "", "", ""},
    {"machine_min_extruding_rate", "coFloats", "", "Minimum speed for extruding", "mm/s", "Minimum speed for extruding (M205 S)", "Machine limits", "develop", "", "", "0", ""},
    {"machine_min_travel_rate", "coFloats", "", "Minimum travel speed", "mm/s", "Minimum travel speed (M205 T)", "Machine limits", "develop", "", "", "0", ""},
    {"machine_pause_gcode", "coString", "Pause G-code", "", "", "This G-code will be used as a code for the pause print. Users can insert pause G-code in the G-code viewer.", "", "advanced", "", "", "", ""},
    {"machine_start_gcode", "coString", "Start G-code", "", "", "Start G-code when starting the entire print.", "", "advanced", "", "", "", ""},
    {"machine_tool_change_time", "coFloat", "Tool change time", "", "s", "Time taken to switch tools. It's usually applicable for tool changers or multi-tool machines. For single-extruder multi-material machines, it's typically 0. For statistics only.", "", "advanced", "", "", "0", ""},
    {"machine_unload_filament_time", "coFloat", "Filament unload time", "", "s", "Time to unload old filament when switch filament. It's usually applicable for single-extruder multi-material machines. For tool changers or multi-tool machines, it's typically 0. For statistics only.", "", "advanced", "", "", "0", ""},
    {"make_overhang_printable", "coBool", "Make overhangs printable", "", "", "Modify the geometry to print overhangs without support material.", "Quality", "advanced", "", "", "", ""},
    {"make_overhang_printable_angle", "coFloat", "Make overhangs printable - Maximum angle", "", "°", "Maximum angle of overhangs to allow after making more steep overhangs printable.90° will not change the model at all and allow any overhang, while 0 will replace all overhangs with conical material.", "Quality", "advanced", "", "", "0.", "90."},
    {"make_overhang_printable_hole_size", "coFloat", "Make overhangs printable - Hole area", "", "mm²", "Maximum area of a hole in the base of the model before it's filled by conical material. A value of 0 will fill all the holes in the model base.", "Quality", "advanced", "", "", "0.", ""},
    {"manual_filament_change", "coBool", "Manual Filament Change", "", "", "Enable this option to omit the custom Change filament G-code only at the beginning of the print. The tool change command (e.g., T0) will be skipped throughout the entire print. This is useful for manual multi-material printing, where we use M600/PAUSE to trigger the manual filament change action.", "", "advanced", "", "", "", ""},
    {"master_extruder_id", "coInt", "Master extruder id", "", "", "Default extruder id to place filament.", "", "simple", "", "", "", ""},
    {"max_bridge_length", "coFloat", "Max bridge length", "", "mm", "Max length of bridges that don't need support. Set it to 0 if you want all bridges to be supported, and set it to a very large value if you don't want any bridges to be supported.", "Support", "advanced", "", "", "0", ""},
    {"max_layer_height", "coFloats", "Max", "", "mm", "The highest printable layer height for the extruder. Used to limit the maximum layer height when enable adaptive layer height.", "", "advanced", "", "", "0", ""},
    {"max_resonance_avoidance_speed", "coFloat", "Max", "", "mm/s", "Maximum speed of resonance avoidance.", "", "advanced", "", "", "0", ""},
    {"max_travel_detour_distance", "coFloatOrPercent", "Avoid crossing walls - Max detour length", "", "mm or %", "Maximum detour distance for avoiding crossing wall. Don't detour if the detour distance is larger than this value. Detour length could be specified either as an absolute value or as percentage (for example 50%) of a direct travel path. Zero to disable.", "Quality", "advanced", "", "", "0", ""},
    {"max_volumetric_extrusion_rate_slope", "coFloat", "Extrusion rate smoothing", "", "mm³/s²", "This parameter smooths out sudden extrusion rate changes that happen when the printer transitions from printing a high flow (high speed/larger width) extrusion to a lower flow (lower speed/smaller width) extrusion and vice versa.\n\nIt defines the maximum rate by which the extruded volumetric flow in mm³/s can change over time. Higher values mean higher extrusion rate changes are allowed, resulting in faster speed transitions.\n\nA value of 0 disables the feature.\n\nFor a high speed, high flow direct drive printer (like the Bambu lab or Voron) this value is usually not needed. However it can provide some marginal benefit in certain cases where feature speeds vary greatly. For example, when there are aggressive slowdowns due to overhangs. In these cases a high value of around 300-350 mm³/s² is recommended as this allows for just enough smoothing to assist pressure advance achieve a smoother flow transition.\n\nFor slower printers without pressure advance, the value should be set much lower. A value of 10-15 mm³/s² is a good starting point for direct drive extruders and 5-10 mm³/s² for Bowden style.\n\nThis feature is known as Pressure Equalizer in Prusa slicer.\n\nNote: this parameter disables arc fitting.", "", "advanced", "", "", "0", ""},
    {"max_volumetric_extrusion_rate_slope_segment_length", "coFloat", "Smoothing segment length", "", "mm", "A lower value results in smoother extrusion rate transitions. However, this results in a significantly larger G-code file and more instructions for the printer to process.\n\nDefault value of 3 works well for most cases. If your printer is stuttering, increase this value to reduce the number of adjustments made.\n\nAllowed values: 0.5-5", "", "advanced", "", "", "0.5", "5"},
    {"min_bead_width", "coPercent", "Minimum wall width", "", "%", "Width of the wall that will replace thin features (according to the Minimum feature size) of the model. If the Minimum wall width is thinner than the thickness of the feature, the wall will become as thick as the feature itself. It's expressed as a percentage over nozzle diameter.", "Quality", "advanced", "", "", "0", ""},
    {"min_feature_size", "coPercent", "Minimum feature size", "", "%", "Minimum thickness of thin features. Model features that are thinner than this value will not be printed, while features thicker than than this value will be widened to the minimum wall width. It's expressed as a percentage over nozzle diameter.", "Quality", "advanced", "", "", "0", ""},
    {"min_layer_height", "coFloats", "Min", "", "mm", "The lowest printable layer height for the extruder. Used to limit the minimum layer height when enable adaptive layer height.", "", "advanced", "", "", "0", ""},
    {"min_length_factor", "coFloat", "Minimum wall length", "", "mm", "Adjust this value to prevent short, unclosed walls from being printed, which could increase print time. Higher values remove more and longer walls.\n\nNOTE: Bottom and top surfaces will not be affected by this value to prevent visual gaps on the outside of the model. Adjust 'One wall threshold' in the Advanced settings below to adjust the sensitivity of what is considered a top-surface. 'One wall threshold' is only visible if this setting is set above the default value of 0.5, or if single-wall top surfaces is enabled.", "Quality", "advanced", "", "", "0.0", "25.0"},
    {"min_resonance_avoidance_speed", "coFloat", "Min", "", "mm/s", "Minimum speed of resonance avoidance.", "", "advanced", "", "", "0", ""},
    {"min_skirt_length", "coFloat", "Skirt minimum extrusion length", "Skirt minimum extrusion length", "mm", "Minimum filament extrusion length in mm when printing the skirt. Zero means this feature is disabled.\n\nUsing a non-zero value is useful if the printer is set up to print without a prime line.\nFinal number of loops is not taking into account while arranging or validating objects distance. Increase loop number in such case.", "", "advanced", "", "", "0", ""},
    {"min_width_top_surface", "coFloatOrPercent", "One wall threshold", "", "mm or %", "If a top surface has to be printed and it's partially covered by another layer, it won't be considered at a top layer where its width is below this value. This can be useful to not let the 'one perimeter on top' trigger on surface that should be covered only by perimeters. This value can be a mm or a % of the perimeter extrusion width.\nWarning: If enabled, artifacts can be created if you have some thin features on the next layer, like letters. Set this setting to 0 to remove these artifacts.", "Quality", "advanced", "", "", "0", ""},
    {"minimum_sparse_infill_area", "coFloat", "Minimum sparse infill threshold", "", "mm²", "Sparse infill areas smaller than this threshold value are replaced by internal solid infill.", "Strength", "advanced", "", "", "0", ""},
    {"mmu_segmented_region_interlocking_depth", "coFloat", "Interlocking depth of a segmented region", "", "mm", "Interlocking depth of a segmented region. It will be ignored if \"mmu_segmented_region_max_width\" is zero or if \"mmu_segmented_region_interlocking_depth\" is bigger than \"mmu_segmented_region_max_width\". Zero disables this feature.", "Advanced", "advanced", "", "", "0", ""},
    {"mmu_segmented_region_max_width", "coFloat", "Maximum width of a segmented region", "", "mm", "Maximum width of a segmented region. Zero disables this feature.", "Advanced", "advanced", "", "", "0", ""},
    {"notes", "coString", "Configuration notes", "", "", "You can put here your personal notes. This text will be added to the G-code header comments.", "", "advanced", "", "", "", ""},
    {"nozzle_diameter", "coFloats", "Nozzle diameter", "", "mm", "The diameter of nozzle.", "", "advanced", "", "", "", "100"},
    {"nozzle_flush_dataset", "coInts", "", "", "", "", "", "simple", "", "", "", ""},
    {"nozzle_height", "coFloat", "Nozzle height", "", "mm", "The height of nozzle tip.", "", "develop", "", "", "0", ""},
    {"nozzle_hrc", "coInt", "Nozzle HRC", "", "HRC", "The nozzle's hardness. Zero means no checking for nozzle's hardness during slicing.", "", "develop", "", "", "0", "500"},
    {"nozzle_temperature", "coInts", "Other layers", "Nozzle temperature", "°C", "Nozzle temperature for layers after the initial one.", "", "simple", "", "", "0", ""},
    {"nozzle_temperature_initial_layer", "coInts", "First layer", "First layer nozzle temperature", "°C", "Nozzle temperature for printing the first layer when using this filament.", "", "simple", "", "", "0", ""},
    {"nozzle_temperature_range_high", "coInts", "Max", "", "°C", "", "", "simple", "", "", "0", ""},
    {"nozzle_temperature_range_low", "coInts", "Min", "", "°C", "", "", "simple", "", "", "0", ""},
    {"nozzle_type", "coEnums", "Nozzle type", "", "", "The metallic material of nozzle. This determines the abrasive resistance of nozzle, and what kind of filament can be printed.", "", "advanced", "undefine\nhardened_steel\nstainless_steel\ntungsten_carbide\nbrass", "Undefine\nHardened steel\nStainless steel\nTungsten carbide\nBrass", "", ""},
    {"nozzle_volume", "coFloats", "Nozzle volume", "", "mm³", "Volume of nozzle between the cutter and the end of nozzle.", "", "advanced", "", "", "", ""},
    {"nozzle_volume_type", "coEnums", "Nozzle Volume Type", "", "", "Nozzle volume type for extruders.", "", "simple", "", "Standard\nHigh Flow", "", ""},
    {"only_one_wall_first_layer", "coBool", "Only one wall on first layer", "", "", "Use only one wall on first layer, to give more space to the bottom infill pattern.", "Quality", "simple", "", "", "", ""},
    {"only_one_wall_top", "coBool", "Only one wall on top surfaces", "", "", "Use only one wall on flat top surfaces, to give more space to the top infill pattern.", "Quality", "simple", "", "", "", ""},
    {"ooze_prevention", "coBool", "Enable", "", "", "This option will drop the temperature of the inactive extruders to prevent oozing.", "", "advanced", "", "", "", ""},
