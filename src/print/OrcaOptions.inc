    {"support_base_pattern", "coEnum", "Base pattern", "", "", "Pattern of the support. Default is hollow (no base pattern) for tree supports and rectilinear for the others. Organic supports print their two walls with the base pattern only when it is not hollow.", "Support", "advanced", "default\nrectilinear\nrectilinear-grid\nhoneycomb\nlightning\nhollow", "Default\nRectilinear\nRectilinear grid\nHoneycomb\nLightning\nHollow", "", ""},
