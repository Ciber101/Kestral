    {"support_bottom_z_distance", "coFloat", "Bottom Z distance", "", "mm", "Gap between the part and support standing on it. Ignored when the top Z distance is 0 and the bottom has interface layers; the support then touches the part.", "Support", "advanced", "", "", "0", ""},
    {"support_chamber_temp_control", "coBool", "Support control chamber temperature", "", "", "The printer can control its chamber temperature (with M141 S).", "", "advanced", "", "", "", ""},
