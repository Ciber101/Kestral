    {"thick_bridges", "coBool", "Thick external bridges", "", "", "Print visible bridges as tall as the nozzle is wide. Stronger and more reliable over longer spans, but they look rougher. Off gives better looking bridges that only manage shorter spans.", "Quality", "advanced", "", "", "", ""},
    {"thick_internal_bridges", "coBool", "Thick internal bridges", "", "", "Print internal bridges as tall as the nozzle is wide. Stronger and more reliable over sparse infill, but the top surface can look worse. Off can look better but is less reliable.", "Quality", "advanced", "", "", "", ""},
    {"thumbnails", "coString", "G-code thumbnails", "", "", "Preview picture sizes stored in the G-code file, written \"XxY, XxY, ...\".", "", "advanced", "", "", "", ""},
    {"thumbnails_format", "coEnum", "Format of G-code thumbnails", "", "", "Format of the preview pictures: PNG looks best, JPG is smallest, QOI suits firmware with little memory, and the others are for specific screens.", "", "advanced", "PNG\nJPG\nQOI\nBTT_TFT\nCOLPIC", "PNG\nJPG\nQOI\nBTT TT\nColPic", "", ""},
    {"time_cost", "coFloat", "Time cost", "", "money/h", "Cost of running the printer per hour, for the cost estimate.", "", "advanced", "", "", "0", ""},
