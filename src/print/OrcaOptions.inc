    {"initial_layer_travel_jerk", "coFloatOrPercent", "First layer travel", "", "mm/s or %", "Travel jerk on the first layer. A percentage is taken from the travel jerk.", "", "advanced", "", "", "0", ""},
    {"initial_layer_travel_speed", "coFloatOrPercent", "First layer travel speed", "", "mm/s or %", "Travel speed on the first layer.", "Speed", "advanced", "", "", "1", ""},
    {"inner_wall_acceleration", "coFloat", "Inner wall", "", "mm/s²", "Acceleration of inner walls.", "Speed", "advanced", "", "", "0", ""},
    {"inner_wall_filament_id", "coInt", "Inner walls", "", "", "Which filament prints the inner walls. Default uses the filament of the object or part.", "Extruders", "advanced", "", "", "0", ""},
    {"inner_wall_flow_ratio", "coFloat", "Inner wall flow ratio", "", "", "Flow multiplier for inner walls, applied on top of the filament's flow ratio and the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"inner_wall_jerk", "coFloat", "Inner wall", "", "mm/s", "Jerk of inner walls.", "Speed", "advanced", "", "", "0", ""},
    {"inner_wall_line_width", "coFloatOrPercent", "Inner wall", "", "mm or %", "Line width of inner walls. A percentage is taken from the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"inner_wall_speed", "coFloat", "Inner wall", "", "mm/s", "Speed of inner walls.", "Speed", "advanced", "", "", "1", ""},
    {"input_shaping_damp_x", "coFloat", "X", "", "", "Damping ratio of the X input shaper. 0 keeps the firmware's value. To turn input shaping off, set the type to Disable. On RepRapFirmware X and Y share one value.", "", "simple", "", "", "0", "1"},
    {"input_shaping_damp_y", "coFloat", "Y", "", "", "Damping ratio of the Y input shaper. 0 keeps the firmware's value. To turn input shaping off, set the type to Disable.", "", "simple", "", "", "0", "1"},
    {"input_shaping_emit", "coBool", "Emit input shaping", "", "", "Write the input shaping settings below into the G-code, replacing the firmware's. Off keeps the firmware's settings.", "", "simple", "", "", "", ""},
    {"input_shaping_freq_x", "coFloat", "X", "", "Hz", "Resonance frequency for the X input shaper. 0 keeps the firmware's value. To turn input shaping off, set the type to Disable. On RepRapFirmware X and Y share one value.", "", "simple", "", "", "0", "1000"},
    {"input_shaping_freq_y", "coFloat", "Y", "", "Hz", "Resonance frequency for the Y input shaper. 0 keeps the firmware's value. To turn input shaping off, set the type to Disable.", "", "simple", "", "", "0", "1000"},
    {"input_shaping_type", "coEnum", "Input shaper type", "", "", "Input shaper algorithm. Default keeps the firmware's choice, Disable turns input shaping off.", "", "simple", "", "", "", ""},
    {"interface_shells", "coBool", "Interface shells", "", "", "Always print solid shells where two materials or volumes touch. Useful with clear materials on multi extruder printers, or with soluble support you add yourself.", "Quality", "advanced", "", "", "", ""},
    {"interlocking_beam", "coBool", "Use beam interlocking", "", "", "Where two filaments touch, weave them together with small interlocking beams so the materials hold together, which helps most with materials that do not bond well.", "Advanced", "advanced", "", "", "", ""},
    {"interlocking_beam_layer_count", "coInt", "Interlocking beam layers", "", "", "Height of each interlocking beam, in layers. Fewer layers is stronger but more likely to show flaws.", "Advanced", "advanced", "", "", "1", ""},
    {"interlocking_beam_width", "coFloat", "Interlocking beam width", "", "mm", "Width of the interlocking beams.", "Advanced", "advanced", "", "", "0.01", ""},
    {"interlocking_boundary_avoidance", "coInt", "Interlocking boundary avoidance", "", "", "How far from the outside of the part (in beam cells) no interlocking is made, so it does not show.", "Advanced", "advanced", "", "", "0", ""},
    {"interlocking_depth", "coInt", "Interlocking depth", "", "", "How far into each material (in beam cells) the interlocking reaches from where they meet. Too little holds poorly.", "Advanced", "advanced", "", "", "1", ""},
    {"interlocking_orientation", "coFloat", "Interlocking direction", "", "°", "Direction of the interlocking beams.", "Advanced", "advanced", "", "", "0", "360"},
    {"internal_bridge_angle", "coFloat", "Internal bridge infill direction", "", "°", "Direction of internal bridge lines. 0 lets the slicer pick for each bridge. Any other angle is used as given (in plate coordinates, or turning with the model when \"Align infill direction to model\" is on).", "Strength", "advanced", "", "", "0", "180"},
    {"internal_bridge_density", "coPercent", "Internal bridge density", "", "%", "Spacing of internal bridge lines, the layer between sparse infill and the solid top layers, which matters a lot for the top surface. Above 100% (up to about 125%) gives a denser, flatter base. Below 100% saves material but can make the top worse.", "Strength", "advanced", "", "", "10", "125"},
    {"internal_bridge_fan_speed", "coInts", "Internal bridges fan speed", "", "%", "Part cooling fan speed for internal bridges. -1 uses the overhang fan settings. Less fan here than usual reduces warping from the extra cooling.", "", "advanced", "", "", "-1", "100"},
    {"internal_bridge_flow", "coFloat", "Internal bridge flow ratio", "", "", "How much material internal bridges get. This is the first layer over the sparse infill, so a little more can make the part stronger and the top better. Above 1 adds material at the same spacing, below 1 uses less and thinner lines.", "Quality", "advanced", "", "", "0", "2.0"},
    {"internal_bridge_speed", "coFloatOrPercent", "Internal", "", "mm/s or %", "Speed of internal bridges. A percentage is taken from the bridge speed.", "Speed", "advanced", "", "", "1", ""},
    {"internal_solid_filament_id", "coInt", "Internal solid infill", "", "", "Which filament prints internal solid infill. Default uses the filament of the object or part.", "Extruders", "advanced", "", "", "0", ""},
    {"internal_solid_infill_acceleration", "coFloatOrPercent", "Internal solid infill", "", "mm/s² or %", "Acceleration of internal solid infill. A percentage is taken from the default acceleration.", "Speed", "advanced", "", "", "0", ""},
    {"internal_solid_infill_flow_ratio", "coFloat", "Internal solid infill flow ratio", "", "", "Flow multiplier for internal solid infill, applied on top of the filament's flow ratio and the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"internal_solid_infill_line_width", "coFloatOrPercent", "Internal solid infill", "", "mm or %", "Line width of internal solid infill. A percentage is taken from the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"internal_solid_infill_pattern", "coEnum", "Internal solid infill pattern", "", "", "Line pattern of internal solid infill. Narrow areas use concentric instead when that detection is on.", "Strength", "simple", "monotonic\nmonotonicline\nrectilinear\nalignedrectilinear\nconcentric\nhilbertcurve\narchimedeanchords\noctagramspiral", "Monotonic\nMonotonic line\nRectilinear\nAligned Rectilinear\nConcentric\nHilbert Curve\nArchimedean Chords\nOctagram Spiral", "", ""},
    {"internal_solid_infill_speed", "coFloat", "Internal solid infill", "", "mm/s", "Speed of internal solid infill (top and bottom surfaces have their own).", "Speed", "advanced", "", "", "1", ""},
    {"ironing_angle", "coFloat", "Ironing angle offset", "", "°", "Angle of the ironing lines, relative to the top surface lines.", "Quality", "advanced", "", "", "0", "359"},
    {"ironing_angle_fixed", "coBool", "Fixed ironing angle", "", "", "Use the ironing angle as a fixed direction on the plate instead of relative to the top surface.", "Quality", "advanced", "", "", "", ""},
    {"ironing_expansion", "coFloat", "Ironing expansion", "", "mm", "Grow (positive) or shrink (negative) the ironed area.", "Quality", "simple", "", "", "-100", "100"},
    {"ironing_fan_speed", "coInts", "Ironing fan speed", "", "%", "Part cooling fan speed while ironing. Less than usual reduces clogging at the very low flow and gives a smoother finish. -1 keeps the normal fan speed.", "", "advanced", "", "", "-1", "100"},
    {"ironing_flow", "coPercent", "Ironing flow", "", "%", "Amount of material while ironing, as a share of a normal layer's flow. Too much leaves an over extruded surface.", "Quality", "advanced", "", "", "0", "100"},
    {"ironing_inset", "coFloat", "Ironing inset", "", "mm", "How far ironing stays from the edges. 0 uses half the nozzle diameter.", "Quality", "advanced", "", "", "0", "100"},
    {"ironing_pattern", "coEnum", "Ironing Pattern", "", "", "Line pattern of ironing.", "Quality", "advanced", "rectilinear\nconcentric", "Rectilinear\nConcentric", "", ""},
    {"ironing_spacing", "coFloat", "Ironing line spacing", "", "mm", "Distance between ironing lines.", "Quality", "advanced", "", "", "0", "1"},
    {"ironing_speed", "coFloat", "Ironing speed", "", "mm/s", "Speed of the ironing lines.", "Quality", "advanced", "", "", "1", ""},
    {"ironing_type", "coEnum", "Ironing Type", "", "", "Ironing goes over a flat surface a second time with very little flow to make it smooth. Choose where: no ironing, all top surfaces, only the topmost surface, or every solid layer.", "Quality", "advanced", "no ironing\ntop\ntopmost\nsolid", "No ironing\nTop surfaces\nTopmost surface\nAll solid layers", "", ""},
    {"is_infill_first", "coBool", "Print infill first", "", "", "Print infill before walls. Walls first works best almost always. Infill first can help extreme overhangs, since the walls then have infill to lean on, but the infill may show through the outer surface.", "Quality", "advanced", "", "", "", ""},
    {"lateral_lattice_angle_1", "coFloat", "Lateral lattice angle 1", "", "°", "Tilt of the first set of lateral lattice members from vertical. 0 is vertical.", "Strength", "advanced", "", "", "-75", "75"},
    {"lateral_lattice_angle_2", "coFloat", "Lateral lattice angle 2", "", "°", "Tilt of the second set of lateral lattice members from vertical. 0 is vertical.", "Strength", "advanced", "", "", "-75", "75"},
    {"layer_change_gcode", "coString", "Layer change G-code", "", "", "G-code added at every layer change, after the nozzle lifts to the next layer.", "", "advanced", "", "", "", ""},
    {"layer_height", "coFloat", "Layer height", "", "mm", "Height of each layer. Thinner layers give finer detail and take longer.", "Quality", "simple", "", "", "0", ""},
    {"lightning_overhang_angle", "coFloat", "Lightning overhang angle", "", "°", "Steepest overhang that lightning infill branches may support.", "Strength", "simple", "", "", "5", "85"},
    {"lightning_prune_angle", "coFloat", "Prune angle", "", "°", "How strongly short or unsupported lightning branches are cut back. Converted to a distance per layer.", "Strength", "simple", "", "", "5", "85"},
    {"lightning_straightening_angle", "coFloat", "Straightening angle", "", "°", "How much lightning branches may be straightened to keep them simple.", "Strength", "simple", "", "", "5", "85"},
    {"line_width", "coFloatOrPercent", "Default", "", "mm or %", "Line width used where a feature's own width is 0. A percentage is taken from the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"long_retractions_when_cut", "coBools", "Long retraction when cut (beta)", "", "", "Pull the filament back further before cutting it at a filament change, which needs much less purging. Experimental: it raises the risk of clogs and other problems.", "", "develop", "", "", "", ""},
    {"long_retractions_when_ec", "coBools", "Long retraction when extruder change", "", "", "", "", "advanced", "", "", "", ""},
    {"machine_end_gcode", "coString", "End G-code", "", "", "G-code added when the whole print ends.", "", "advanced", "", "", "", ""},
    {"machine_load_filament_time", "coFloat", "Filament load time", "", "s", "Time to load a new filament at a change, for the time estimate only. Mostly for single extruder multi material printers; usually 0 for tool changers.", "", "advanced", "", "", "0", ""},
    {"machine_max_acceleration_extruding", "coFloats", "", "Maximum acceleration for extruding", "mm/s²", "Highest acceleration while extruding (M204 P).", "Machine limits", "simple", "", "", "0", ""},
    {"machine_max_acceleration_retracting", "coFloats", "", "Maximum acceleration for retracting", "mm/s²", "Highest acceleration while retracting (M204 R).", "Machine limits", "simple", "", "", "0", ""},
    {"machine_max_acceleration_travel", "coFloats", "", "Maximum acceleration for travel", "mm/s²", "Highest acceleration while traveling (M204 T, Marlin 2 only).", "Machine limits", "advanced", "", "", "0", ""},
    {"machine_max_junction_deviation", "coFloats", "", "Maximum Junction Deviation", "mm", "Highest junction deviation (M205 J). Used by Marlin when above 0. Set 0 if your Marlin 2 printer uses classic jerk.", "Machine limits", "advanced", "", "", "", ""},
    {"machine_min_extruding_rate", "coFloats", "", "Minimum speed for extruding", "mm/s", "Lowest speed while extruding (M205 S).", "Machine limits", "develop", "", "", "0", ""},
    {"machine_min_travel_rate", "coFloats", "", "Minimum travel speed", "mm/s", "Lowest travel speed (M205 T).", "Machine limits", "develop", "", "", "0", ""},
    {"machine_pause_gcode", "coString", "Pause G-code", "", "", "G-code that pauses the print. You can insert it at a layer from the preview.", "", "advanced", "", "", "", ""},
    {"machine_start_gcode", "coString", "Start G-code", "", "", "G-code added at the start of the whole print.", "", "advanced", "", "", "", ""},
    {"machine_tool_change_time", "coFloat", "Tool change time", "", "s", "Time to change tools, for the time estimate only. Mostly for tool changers; usually 0 for single extruder multi material printers.", "", "advanced", "", "", "0", ""},
    {"machine_unload_filament_time", "coFloat", "Filament unload time", "", "s", "Time to unload the old filament at a change, for the time estimate only. Mostly for single extruder multi material printers; usually 0 for tool changers.", "", "advanced", "", "", "0", ""},
    {"make_overhang_printable", "coBool", "Make overhangs printable", "", "", "Change the shape of steep overhangs so they print without support.", "Quality", "advanced", "", "", "", ""},
    {"make_overhang_printable_angle", "coFloat", "Make overhangs printable - Maximum angle", "", "°", "Steepest overhang left after the change. 90° changes nothing, 0 turns every overhang into a cone.", "Quality", "advanced", "", "", "0.", "90."},
    {"make_overhang_printable_hole_size", "coFloat", "Make overhangs printable - Hole area", "", "mm²", "Holes in the base bigger than this area are left open; smaller ones are filled with a cone. 0 fills every hole.", "Quality", "advanced", "", "", "0.", ""},
    {"manual_filament_change", "coBool", "Manual Filament Change", "", "", "For changing filament by hand: the change filament G-code is used only once at the start, and tool change commands (like T0) are left out of the whole print. Use it with pauses you add for each swap.", "", "advanced", "", "", "", ""},
    {"master_extruder_id", "coInt", "Master extruder id", "", "", "Extruder that filaments go to by default.", "", "simple", "", "", "", ""},
    {"max_bridge_length", "coFloat", "Max bridge length", "", "mm", "Bridges up to this long print without support. 0 supports every bridge, a very large value supports none.", "Support", "advanced", "", "", "0", ""},
    {"max_layer_height", "coFloats", "Max", "", "mm", "Thickest layer this extruder can print. Limits adaptive layer height.", "", "advanced", "", "", "0", ""},
    {"max_resonance_avoidance_speed", "coFloat", "Max", "", "mm/s", "Top of the speed range skipped to avoid the printer's resonance.", "", "advanced", "", "", "0", ""},
    {"max_travel_detour_distance", "coFloatOrPercent", "Avoid crossing walls - Max detour length", "", "mm or %", "When avoiding crossing walls, don't take a detour longer than this. In mm, or a percentage of the direct path. 0 means no limit.", "Quality", "advanced", "", "", "0", ""},
    {"max_volumetric_extrusion_rate_slope", "coFloat", "Extrusion rate smoothing", "", "mm³/s²", "Smooths sudden changes in flow, for example from fast wide lines to slow thin ones. The nozzle cannot change its pressure instantly, so a sudden change gives a blob or a thin spot. The value is the largest flow change allowed per second (mm³/s²). 0 turns it off.", "", "advanced", "", "", "0", ""},
    {"max_volumetric_extrusion_rate_slope_segment_length", "coFloat", "Smoothing segment length", "", "mm", "Length of the pieces the smoothing splits lines into. Shorter gives smoother changes but a much bigger G-code file. 3 mm suits most printers.", "", "advanced", "", "", "0.5", "5"},
    {"min_bead_width", "coPercent", "Minimum wall width", "", "%", "Width of the wall that replaces thin features (see minimum feature size). If the feature is thinner than this, the wall is widened to this. Percentage of the nozzle diameter.", "Quality", "advanced", "", "", "0", ""},
    {"min_feature_size", "coPercent", "Minimum feature size", "", "%", "Thinnest feature that is still printed. Thinner ones are left out, and anything thicker gets at least the minimum wall width. Percentage of the nozzle diameter.", "Quality", "advanced", "", "", "0", ""},
    {"min_layer_height", "coFloats", "Min", "", "mm", "Thinnest layer this extruder can print. Limits adaptive layer height.", "", "advanced", "", "", "0", ""},
    {"min_length_factor", "coFloat", "Minimum wall length", "", "mm", "Leave out short open wall pieces shorter than this, which mostly waste time. Higher values remove more. Top and bottom surfaces keep theirs, so nothing visible goes missing.", "Quality", "advanced", "", "", "0.0", "25.0"},
    {"min_resonance_avoidance_speed", "coFloat", "Min", "", "mm/s", "Bottom of the speed range skipped to avoid the printer's resonance.", "", "advanced", "", "", "0", ""},
    {"min_skirt_length", "coFloat", "Skirt minimum extrusion length", "Skirt minimum extrusion length", "mm", "Print at least this much filament in the skirt, adding loops if needed. 0 turns it off. Useful when the start G-code has no purge line.", "", "advanced", "", "", "0", ""},
    {"min_width_top_surface", "coFloatOrPercent", "One wall threshold", "", "mm or %", "Top surfaces narrower than this (where another layer partly covers them) are not treated as top surfaces, so \"Only one wall on top surfaces\" does not apply to them. In mm, or a percentage of the line width.", "Quality", "advanced", "", "", "0", ""},
    {"minimum_sparse_infill_area", "coFloat", "Minimum sparse infill threshold", "", "mm²", "Sparse infill areas smaller than this become solid infill.", "Strength", "advanced", "", "", "0", ""},
    {"mmu_segmented_region_interlocking_depth", "coFloat", "Interlocking depth of a segmented region", "", "mm", "How deep the painted color regions interlock with each other. Ignored when the max width is 0 or smaller than this. 0 turns it off.", "Advanced", "advanced", "", "", "0", ""},
    {"mmu_segmented_region_max_width", "coFloat", "Maximum width of a segmented region", "", "mm", "Deepest a painted color region reaches into the part. 0 turns the limit off.", "Advanced", "advanced", "", "", "0", ""},
    {"notes", "coString", "Configuration notes", "", "", "Your own notes. They are also written into the G-code header.", "", "advanced", "", "", "", ""},
    {"nozzle_diameter", "coFloats", "Nozzle diameter", "", "mm", "Diameter of the nozzle.", "", "advanced", "", "", "", "100"},
    {"nozzle_flush_dataset", "coInts", "", "", "", "", "", "simple", "", "", "", ""},
    {"nozzle_height", "coFloat", "Nozzle height", "", "mm", "Height of the nozzle tip.", "", "develop", "", "", "0", ""},
    {"nozzle_hrc", "coInt", "Nozzle HRC", "", "HRC", "Hardness of the nozzle. Abrasive filaments need a hard nozzle. 0 skips the hardness check.", "", "develop", "", "", "0", "500"},
    {"nozzle_temperature", "coInts", "Other layers", "Nozzle temperature", "°C", "Nozzle temperature after the first layer.", "", "simple", "", "", "0", ""},
    {"nozzle_temperature_initial_layer", "coInts", "First layer", "First layer nozzle temperature", "°C", "Nozzle temperature for the first layer with this filament.", "", "simple", "", "", "0", ""},
    {"nozzle_temperature_range_high", "coInts", "Max", "", "°C", "", "", "simple", "", "", "0", ""},
    {"nozzle_temperature_range_low", "coInts", "Min", "", "°C", "", "", "simple", "", "", "0", ""},
    {"nozzle_type", "coEnums", "Nozzle type", "", "", "Material of the nozzle. It decides how well it resists abrasive filaments and which filaments it can print.", "", "advanced", "undefine\nhardened_steel\nstainless_steel\ntungsten_carbide\nbrass", "Undefine\nHardened steel\nStainless steel\nTungsten carbide\nBrass", "", ""},
    {"nozzle_volume", "coFloats", "Nozzle volume", "", "mm³", "Volume inside the nozzle between the cutter and the tip.", "", "advanced", "", "", "", ""},
    {"nozzle_volume_type", "coEnums", "Nozzle Volume Type", "", "", "Type of each extruder's nozzle: standard or high flow.", "", "simple", "", "Standard\nHigh Flow", "", ""},
    {"only_one_wall_first_layer", "coBool", "Only one wall on first layer", "", "", "Print only one wall on the first layer, leaving more room for the bottom pattern.", "Quality", "simple", "", "", "", ""},
    {"only_one_wall_top", "coBool", "Only one wall on top surfaces", "", "", "Print only one wall on flat top surfaces, leaving more room for the top pattern.", "Quality", "simple", "", "", "", ""},
    {"ooze_prevention", "coBool", "Enable", "", "", "Lower the temperature of extruders that are not in use, so they don't ooze.", "", "advanced", "", "", "", ""},
    {"other_layers_print_sequence", "coInts", "Other layers print sequence", "", "", "", "", "simple", "", "", "0", "16"},
    {"other_layers_print_sequence_nums", "coInt", "The number of other layers print sequence", "", "", "", "", "simple", "", "", "", ""},
    {"other_layers_sequence_choice", "coEnum", "Other layers filament sequence", "", "", "", "Quality", "simple", "Auto\nCustomize", "Auto\nCustomize", "", ""},
    {"outer_wall_acceleration", "coFloat", "Outer wall", "", "mm/s²", "Acceleration of the outer wall. Lower values give a cleaner surface.", "Speed", "advanced", "", "", "0", ""},
    {"outer_wall_filament_id", "coInt", "Outer walls", "", "", "Which filament prints the outer walls. Default uses the filament of the object or part.", "Extruders", "advanced", "", "", "0", ""},
    {"outer_wall_flow_ratio", "coFloat", "Outer wall flow ratio", "", "", "Flow multiplier for outer walls, applied on top of the filament's flow ratio and the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"outer_wall_jerk", "coFloat", "Outer wall", "", "mm/s", "Jerk of outer walls.", "Speed", "advanced", "", "", "0", ""},
    {"outer_wall_line_width", "coFloatOrPercent", "Outer wall", "", "mm or %", "Line width of the outer wall. A percentage is taken from the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"outer_wall_speed", "coFloat", "Outer wall", "", "mm/s", "Speed of the outer, visible wall. Usually slower than the inner walls for a better surface.", "Speed", "advanced", "", "", "1", ""},
    {"overhang_1_4_speed", "coFloatOrPercent", "10%", "10%", "mm/s or %", "Speed of wall lines that overhang 10 to 25% of their width. 0 keeps the normal wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_2_4_speed", "coFloatOrPercent", "25%", "25%", "mm/s or %", "Speed of wall lines that overhang 25 to 50% of their width. 0 keeps the normal wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_3_4_speed", "coFloatOrPercent", "50%", "50%", "mm/s or %", "Speed of wall lines that overhang 50 to 75% of their width. 0 keeps the normal wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_4_4_speed", "coFloatOrPercent", "75%", "75%", "mm/s or %", "Speed of wall lines that overhang 75 to 100% of their width. 0 keeps the normal wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_fan_speed", "coInts", "Overhangs and external bridges fan speed", "", "%", "Part cooling fan speed for bridges and for walls that overhang more than the threshold above. More cooling there makes them sag and curl less.", "", "advanced", "", "", "0", "100"},
    {"overhang_fan_threshold", "coEnums", "Overhang cooling activation threshold", "", "", "Walls that overhang more than this (the share of the line width with nothing below it) use the overhang fan speed. 0% applies it to every outer wall, whether it overhangs or not.", "", "advanced", "0%\n10%\n25%\n50%\n75%\n95%", "0%\n10%\n25%\n50%\n75%\n95%", "", ""},
    {"overhang_flow_ratio", "coFloat", "Overhang flow ratio", "", "", "Flow multiplier for overhangs, applied on top of the filament's flow ratio and the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"overhang_reverse", "coBool", "Reverse on even", "Overhang reversal", "", "On even layers, print walls that hang over something in the opposite direction. Alternating the direction can greatly improve steep overhangs, and it also spreads the stresses that cause warping.", "Quality", "advanced", "", "", "", ""},
    {"overhang_reverse_internal_only", "coBool", "Reverse only internal perimeters", "Reverse only internal perimeters", "", "Reverse only the inner walls, not the outer one. Still spreads the stresses (less warping) while the outer surface stays even.", "Quality", "advanced", "", "", "", ""},
    {"overhang_reverse_threshold", "coFloatOrPercent", "Reverse threshold", "Overhang reversal threshold", "mm or %", "How far a wall must overhang before it is reversed, in mm or a percentage of the wall width. 0 reverses every even layer. Without overhang wall detection this is ignored and every even layer is reversed.", "Quality", "advanced", "", "", "0", ""},
    {"parallel_printheads_bed_exclude_areas", "coStrings", "Parallel printheads bed exclude areas", "", "", "Bed areas to keep empty for each number of parallel printheads: the first item for one head, the second for two, and so on. Leave an item empty for none.", "", "advanced", "", "", "", ""},
    {"parallel_printheads_count", "coInt", "Parallel printheads count", "", "", "Number of printheads that print side by side at the same time, on printers built for it.", "", "advanced", "", "", "1", "4"},
    {"parking_pos_retraction", "coFloat", "Filament parking position", "", "mm", "Distance from the nozzle tip to where the filament is parked when unloaded. Must match the printer's firmware.", "", "advanced", "", "", "0", ""},
