    {"timelapse_type", "coEnum", "Timelapse", "", "", "Make a timelapse video of each print from the printer's camera, one picture per layer. Smooth moves the head out of the way for each picture (needs a prime tower to keep the parts clean); traditional takes the picture wherever the head is.", "", "simple", "0\n1", "Traditional\nSmooth", "", ""},
    {"tool_change_on_wipe_tower", "coBool", "Tool change on wipe tower", "", "", "Move to the wipe tower before each tool change command (Tx). Only for printers with several toolheads using the type 2 tower, which otherwise skip this travel.", "", "advanced", "", "", "", ""},
    {"top_bottom_infill_wall_overlap", "coPercent", "Top/Bottom solid infill/wall overlap", "", "%", "Grows the top solid infill slightly into the walls so they bond and no pinholes show along the edges. 25 to 30% is a good start. Percentage of the top surface line width.", "Strength", "advanced", "", "", "", ""},
    {"top_shell_layers", "coInt", "Top shell layers", "Top solid layers", "layers", "Number of solid layers at the top, counting the top surface. If these layers end up thinner than the top shell thickness, more are added.", "Strength", "simple", "", "", "0", ""},
    {"top_shell_thickness", "coFloat", "Top shell thickness", "Top shell thickness", "mm", "Smallest total thickness of the top solid layers. When the layer count gives less than this (for example with very thin layers), more layers are added. 0 turns this off, so only the layer count decides.", "Strength", "simple", "", "", "0", ""},
    {"top_solid_infill_flow_ratio", "coFloat", "Top surface flow ratio", "", "", "Flow multiplier for the top surface. A little less can give a smoother top. Applied on top of the filament's flow ratio and the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"top_surface_acceleration", "coFloat", "Top surface", "", "mm/s²", "Acceleration of the top surface. Lower values can give a nicer top.", "Speed", "advanced", "", "", "0", ""},
    {"top_surface_density", "coPercent", "Top surface density", "", "%", "How densely the top surface is filled. 100% gives a solid, smooth top. Less gives a textured top in the chosen pattern, and 0% prints only the walls on the top layer.", "Strength", "simple", "", "", "0", "100"},
    {"top_surface_filament_id", "coInt", "Top surface", "", "", "Which filament prints the top surface. Default uses the filament of the object or part.", "Extruders", "advanced", "", "", "0", ""},
    {"top_surface_jerk", "coFloat", "Top surface", "", "mm/s", "Jerk of the top surface.", "Speed", "advanced", "", "", "0", ""},
    {"top_surface_line_width", "coFloatOrPercent", "Top surface", "", "mm or %", "Line width of top surfaces. A percentage is taken from the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"top_surface_pattern", "coEnum", "Top surface pattern", "", "", "Line pattern of the top surface.", "Strength", "simple", "monotonic\nmonotonicline\nrectilinear\nalignedrectilinear\nconcentric\nhilbertcurve\narchimedeanchords\noctagramspiral", "Monotonic\nMonotonic line\nRectilinear\nAligned Rectilinear\nConcentric\nHilbert Curve\nArchimedean Chords\nOctagram Spiral", "", ""},
    {"top_surface_speed", "coFloat", "Top surface", "", "mm/s", "Speed of the solid top surface.", "Speed", "advanced", "", "", "1", ""},
    {"travel_acceleration", "coFloat", "Travel", "", "mm/s²", "Acceleration of travel moves.", "Speed", "advanced", "", "", "0", ""},
    {"travel_jerk", "coFloat", "Travel", "", "mm/s", "Jerk of travel moves.", "Speed", "advanced", "", "", "0", ""},
    {"travel_slope", "coFloats", "Traveling angle", "", "°", "Angle of the climb for slope and spiral Z hops. 90° lifts straight up.", "", "advanced", "", "", "1", "90"},
    {"travel_speed", "coFloat", "Travel", "", "mm/s", "Speed of travel moves (moving without printing).", "", "advanced", "", "", "1", ""},
    {"travel_speed_z", "coFloat", "Z travel", "", "mm/s", "Speed of moves up and down. Usually lower, since the bed or gantry is heavy to move. 0 uses the travel speed, limited by what the printer can do.", "", "develop", "", "", "0", ""},
    {"tree_support_angle_slow", "coFloat", "Preferred Branch Angle", "", "°", "Angle the branches prefer when they don't need to steer around the part. Lower is more upright and stable, higher merges branches sooner.", "Support", "advanced", "", "", "10", "85"},
    {"tree_support_auto_brim", "coBool", "Auto brim width", "", "", "Work out the tree support's brim width automatically.", "Quality", "simple", "", "", "", ""},
    {"tree_support_branch_angle", "coFloat", "Tree support branch angle", "", "°", "Steepest overhang angle the tree branches may lean at. A larger angle lets branches lean more and reach further.", "Support", "advanced", "", "", "0", "60"},
    {"tree_support_branch_angle_organic", "coFloat", "Tree support branch angle", "", "°", "Steepest overhang angle the organic branches may lean at. A larger angle lets branches lean more and reach further.", "Support", "advanced", "", "", "0", "60"},
    {"tree_support_branch_diameter", "coFloat", "Tree support branch diameter", "", "mm", "Diameter of the branches where they start.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_branch_diameter_angle", "coFloat", "Branch Diameter Angle", "", "°", "How quickly branches get thicker toward the bottom. 0 keeps them the same thickness all the way; a little angle makes organic support more stable.", "Support", "advanced", "", "", "0", "15"},
    {"tree_support_branch_diameter_organic", "coFloat", "Tree support branch diameter", "", "mm", "Diameter of the organic branches where they start.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_branch_distance", "coFloat", "Tree support branch distance", "", "mm", "Distance between neighboring branch points.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_branch_distance_organic", "coFloat", "Tree support branch distance", "", "mm", "Distance between neighboring organic branch points.", "Support", "advanced", "", "", "1.0", "10"},
    {"tree_support_brim_width", "coFloat", "Tree support brim width", "", "", "Distance from a tree trunk to the outermost line of its brim.", "Quality", "simple", "", "", "0.0", ""},
    {"tree_support_tip_diameter", "coFloat", "Tip Diameter", "", "mm", "Diameter of the branch tips (organic support).", "Support", "advanced", "", "", "", ""},
    {"tree_support_top_rate", "coPercent", "Branch Density", "", "%", "How dense the support is right under the part where branches end. Higher supports overhangs better but is harder to remove, so top interface layers are usually the better choice.", "Support", "advanced", "", "", "5", ""},
    {"tree_support_wall_count", "coInt", "Support wall loops", "", "", "Number of walls on tree support, 0 to 2. 0 picks automatically.", "Support", "advanced", "", "", "0", "2"},
