    {"other_layers_print_sequence_nums", "coInt", "The number of other layers print sequence", "", "", "", "", "simple", "", "", "", ""},
    {"other_layers_sequence_choice", "coEnum", "Other layers filament sequence", "", "", "", "Quality", "simple", "Auto\nCustomize", "Auto\nCustomize", "", ""},
    {"outer_wall_acceleration", "coFloat", "Outer wall", "", "mm/s²", "Acceleration of outer wall. Using a lower value can improve quality.", "Speed", "advanced", "", "", "0", ""},
    {"outer_wall_filament_id", "coInt", "Outer walls", "", "", "Filament to print outer walls.\n\"Default\" uses the active object/part filament.", "Extruders", "advanced", "", "", "0", ""},
    {"outer_wall_flow_ratio", "coFloat", "Outer wall flow ratio", "", "", "This factor affects the amount of material for outer walls.\n\nThe actual outer wall flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"outer_wall_jerk", "coFloat", "Outer wall", "", "mm/s", "Jerk of outer walls.", "Speed", "advanced", "", "", "0", ""},
    {"outer_wall_line_width", "coFloatOrPercent", "Outer wall", "", "mm or %", "Line width of outer wall. If expressed as a %, it will be computed over the nozzle diameter.", "Quality", "advanced", "", "", "0", "1000"},
    {"outer_wall_speed", "coFloat", "Outer wall", "", "mm/s", "Speed of outer wall which is outermost and visible. It's used to be slower than inner wall speed to get better quality.", "Speed", "advanced", "", "", "1", ""},
    {"overhang_1_4_speed", "coFloatOrPercent", "10%", "10%", "mm/s or %", "Speed for line of wall which has degree of overhang between 10% and 25% line width. 0 means using original wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_2_4_speed", "coFloatOrPercent", "25%", "25%", "mm/s or %", "Speed for line of wall which has degree of overhang between 25% and 50% line width. 0 means using original wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_3_4_speed", "coFloatOrPercent", "50%", "50%", "mm/s or %", "Speed for line of wall which has degree of overhang between 50% and 75% line width. 0 means using original wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_4_4_speed", "coFloatOrPercent", "75%", "75%", "mm/s or %", "Speed for line of wall which has degree of overhang between 75% and 100% line width. 0 means using original wall speed.", "Speed", "advanced", "", "", "0", ""},
    {"overhang_fan_speed", "coInts", "Overhangs and external bridges fan speed", "", "%", "Use this part cooling fan speed when printing bridges or overhang walls with an overhang threshold that exceeds the value set in the 'Overhangs cooling threshold' parameter above. Increasing the cooling specifically for overhangs and bridges can improve the overall print quality of these features.\n\nPlease note, this fan speed is clamped on the lower end by the minimum fan speed threshold set above. It is also adjusted upwards up to the maximum fan speed threshold when the minimum layer time threshold is not met.", "", "advanced", "", "", "0", "100"},
    {"overhang_fan_threshold", "coEnums", "Overhang cooling activation threshold", "", "", "When the overhang exceeds this specified threshold, force the cooling fan to run at the 'Overhang Fan Speed' set below. This threshold is expressed as a percentage, indicating the portion of each line's width that is unsupported by the layer beneath it. Setting this value to 0% forces the cooling fan to run for all outer walls, regardless of the overhang degree.", "", "advanced", "0%\n10%\n25%\n50%\n75%\n95%", "0%\n10%\n25%\n50%\n75%\n95%", "", ""},
    {"overhang_flow_ratio", "coFloat", "Overhang flow ratio", "", "", "This factor affects the amount of material for overhangs.\n\nThe actual overhang flow used is calculated by multiplying this value by the filament flow ratio, and if set, the object's flow ratio.", "Advanced", "advanced", "", "", "0", "2"},
    {"overhang_reverse", "coBool", "Reverse on even", "Overhang reversal", "", "Extrude perimeters that have a part over an overhang in the reverse direction on even layers. This alternating pattern can drastically improve steep overhangs.\n\nThis setting can also help reduce part warping due to the reduction of stresses in the part walls.", "Quality", "advanced", "", "", "", ""},
    {"overhang_reverse_internal_only", "coBool", "Reverse only internal perimeters", "Reverse only internal perimeters", "", "Apply the reverse perimeters logic only on internal perimeters.\n\nThis setting greatly reduces part stresses as they are now distributed in alternating directions. This should reduce part warping while also maintaining external wall quality. This feature can be very useful for warp prone material, like ABS/ASA, and also for elastic filaments, like TPU and Silk PLA. It can also help reduce warping on floating regions over supports.\n\nFor this setting to be the most effective, it is recommended to set the Reverse Threshold to 0 so that all internal walls print in alternating directions on even layers irrespective of their overhang degree.", "Quality", "advanced", "", "", "", ""},
    {"overhang_reverse_threshold", "coFloatOrPercent", "Reverse threshold", "Overhang reversal threshold", "mm or %", "Number of mm the overhang need to be for the reversal to be considered useful. Can be a % of the perimeter width.\nValue 0 enables reversal on every even layers regardless.\nWhen Detect overhang wall is not enabled, this option is ignored and reversal happens on every even layers regardless.", "Quality", "advanced", "", "", "0", ""},
    {"parallel_printheads_bed_exclude_areas", "coStrings", "Parallel printheads bed exclude areas", "", "", "Ordered list of bed exclude areas by parallel printhead count. Item 1 applies to one printhead, item 2 to two printheads, and so on. Leave an item empty for no excluded area.", "", "advanced", "", "", "", ""},
    {"parallel_printheads_count", "coInt", "Parallel printheads count", "", "", "Set the number of parallel printheads for machines like OrangeStorm Giga printer.", "", "advanced", "", "", "1", "4"},
    {"parking_pos_retraction", "coFloat", "Filament parking position", "", "mm", "Distance of the extruder tip from the position where the filament is parked when unloaded. This should match the value in printer firmware.", "", "advanced", "", "", "0", ""},
    {"part_cooling_fan_min_pwm", "coInt", "Minimum non-zero part cooling fan speed", "", "%", "Some part-cooling fans cannot start spinning when commanded below a certain PWM duty cycle. When set above 0, any non-zero part-cooling fan command will be raised to at least this percentage so the fan reliably starts. A fan command of 0 (fan off) is always honoured exactly. This clamp is applied after every other fan calculation (first-layer ramp, layer-time interpolation, overhang/bridge/support-interface/ironing overrides), so scaling still operates within the range [this value, 100%].\nIf your firmware already disables the fan below a threshold (for example Klipper's [fan] off_below: 0.10 shuts the fan off whenever the commanded duty cycle is below 10%), this option and the firmware threshold should ideally be set to the same value. Matching them (e.g. off_below: 0.10 in Klipper and 10% here) guarantees the slicer never emits a non-zero value that the firmware would silently drop, and the fan never receives a value below the one you know it can actually spool at.\nSet to 0 to deactivate.", "", "advanced", "", "", "0", "100"},
    {"pellet_flow_coefficient", "coFloats", "Pellet flow coefficient", "", "", "Pellet flow coefficient is empirically derived and allows for volume calculation for pellet printers.\n\nInternally it is converted to filament_diameter. All other volume calculations remain the same.\n\nfilament_diameter = sqrt( (4 * pellet_flow_coefficient) / PI )", "", "simple", "", "", "0", ""},
    {"pellet_modded_printer", "coBool", "Pellet Modded Printer", "", "", "Enable this option if your printer uses pellets instead of filaments.", "", "simple", "", "", "", ""},
    {"physical_extruder_map", "coInts", "Map the logical extruder to physical extruder", "", "", "Map the logical extruder to physical extruder.", "", "develop", "", "", "", ""},
    {"post_process", "coStrings", "Post-processing Scripts", "", "", "If you want to process the output G-code through custom scripts, just list their absolute paths here. Separate multiple scripts with a semicolon. Scripts will be passed the absolute path to the G-code file as the first argument, and they can access the Orca Slicer config settings by reading environment variables.", "", "advanced", "", "", "", ""},
    {"precise_outer_wall", "coBool", "Precise wall", "", "", "Improve shell precision by adjusting outer wall spacing. This also improves layer consistency. NOTE: This option will be ignored for outer-inner or inner-outer-inner wall sequences.", "Quality", "simple", "", "", "", ""},
    {"precise_z_height", "coBool", "Precise Z height", "", "", "Enable this to get precise Z height of object after slicing. It will get the precise object height by fine-tuning the layer heights of the last few layers. Note that this is an experimental parameter.", "Quality", "advanced", "", "", "", ""},
    {"preferred_orientation", "coFloat", "Preferred orientation", "", "°", "Automatically orient STL files on the Z axis upon initial import.", "", "advanced", "", "", "-360", "360"},
    {"preheat_steps", "coInt", "Preheat steps", "", "", "Insert multiple preheat commands (e.g. M104.1). Only useful for Prusa XL. For other printers, please set it to 1.", "", "develop", "", "", "1", "10"},
    {"preheat_time", "coFloat", "Preheat time", "", "s", "To reduce the waiting time after tool change, Orca can preheat the next tool while the current tool is still in use. This setting specifies the time in seconds to preheat the next tool. Orca will insert a M104 command to preheat the tool in advance.", "", "advanced", "", "", "0", "120"},
    {"preset_name", "coString", "", "", "", "", "", "simple", "", "", "", ""},
    {"preset_names", "coStrings", "Printer preset names", "", "", "Names of presets related to the physical printer.", "", "advanced", "", "", "", ""},
    {"pressure_advance", "coFloats", "Pressure advance", "", "", "Pressure advance (Klipper) AKA Linear advance factor (Marlin).", "", "advanced", "", "", "", "2"},
    {"prime_tower_brim_width", "coFloat", "Brim width", "", "mm", "Brim width of prime tower, negative number means auto calculated width based on the height of prime tower.", "", "advanced", "-1", "Auto", "-1", ""},
    {"prime_tower_enable_framework", "coBool", "Internal ribs", "", "", "Enable internal ribs to increase the stability of the prime tower.", "", "advanced", "", "", "", ""},
    {"prime_tower_flat_ironing", "coBool", "", "", "", "", "", "advanced", "", "", "", ""},
    {"prime_tower_infill_gap", "coPercent", "Infill gap", "", "%", "Infill gap.", "", "advanced", "", "", "100", ""},
    {"prime_tower_skip_points", "coBool", "Skip points", "", "", "The wall of prime tower will skip the start points of wipe path.", "", "advanced", "", "", "", ""},
    {"prime_tower_width", "coFloat", "Width", "", "mm", "Width of the prime tower.", "", "simple", "", "", "2.0", ""},
    {"prime_volume", "coFloat", "Prime volume", "", "mm³", "The volume of material to prime extruder on tower.", "", "simple", "", "", "1.0", ""},
    {"print_compatible_printers", "coStrings", "", "", "", "", "", "simple", "", "", "", ""},
    {"print_extruder_id", "coInts", "Print extruder id", "", "", "Print extruder id.", "", "simple", "", "", "", ""},
    {"print_extruder_variant", "coStrings", "Print's extruder variant", "", "", "Print's extruder variant.", "", "simple", "", "", "", ""},
    {"print_flow_ratio", "coFloat", "Flow ratio", "", "", "The material may have volumetric change after switching between molten and crystalline states. This setting changes all extrusion flow of this filament in G-code proportionally. The recommended value range is between 0.95 and 1.05. You may be able to tune this value to get a nice flat surface if there is slight overflow or underflow.\n\nThe final object flow ratio is this value multiplied by the filament flow ratio.", "Quality", "advanced", "", "", "", ""},
    {"print_host", "coString", "Hostname, IP or URL", "", "", "Orca Slicer can upload G-code files to a printer host. This field should contain the hostname, IP address or URL of the printer host instance. Print host behind HAProxy with basic auth enabled can be accessed by putting the user name and password into the URL in the following format: https://username:password@your-octopi-address/", "", "advanced", "", "", "", ""},
    {"print_host_webui", "coString", "Device UI", "", "", "Specify the URL of your device user interface if it's not same as print_host.", "", "advanced", "", "", "", ""},
    {"print_order", "coEnum", "Intra-layer order", "", "", "Print order within a single layer.", "", "advanced", "default\nas_obj_list", "Default\nAs object list", "", ""},
    {"print_sequence", "coEnum", "Print sequence", "", "", "Print sequence, layer by layer or object by object.", "", "simple", "by layer\nby object", "By layer\nBy object", "", ""},
